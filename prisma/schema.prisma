generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id                Int         @id @default(autoincrement())
  nombre            String      @db.VarChar(50)
  slug              String      @unique @db.VarChar(50)
  tipo              TipoEmpresa
  activa            Boolean     @default(true)
  bloques           Bloque[]
  tickets           Ticket[]
  traslados_destino Traslado[]  @relation("Destino")
  traslados_origen  Traslado[]  @relation("Origen")
  usuarios          Usuario[]

  @@map("empresa")
}

model Rol {
  id                 Int                 @id @default(autoincrement())
  rol                String              @db.VarChar(50)
  descripcion        String?
  nivel_soporte      NivelSoporte
  activo             Boolean             @default(true)
  atiendeTicketsCsh  Boolean             @default(false)
  atiendeTicketsMkt  Boolean             @default(false)
  permisos_categoria PermisoCategoria[]
  permisos_seccion   PermisoRolSeccion[]
  usuarios           Usuario[]
  permisos           Permiso[]           @relation("PermisoToRol")

  @@map("rol")
}

model Oferta {
  id          Int       @id @default(autoincrement())
  descripcion String    @db.VarChar(50)
  carreras    Carrera[]

  @@map("oferta")
}

model Carrera {
  id          Int        @id @default(autoincrement())
  clave       String     @db.VarChar(10)
  descripcion String     @db.VarChar(150)
  ofertaId    Int
  activo      Boolean    @default(true)
  bloques     Bloque[]
  oferta      Oferta     @relation(fields: [ofertaId], references: [id])
  traslados   Traslado[]

  @@map("carrera")
}

model Usuario {
  id                      Int                      @id @default(autoincrement())
  mail                    String                   @unique @db.VarChar(60)
  nombres                 String                   @db.VarChar(50)
  apellidos               String                   @db.VarChar(50)
  empresaId               Int
  rolId                   Int
  activo                  Boolean                  @default(true)
  vacaciones              Boolean                  @default(false)
  ultimo_login            DateTime                 @default(now()) @db.Timestamp(6)
  horario_disponibilidad  Json?
  carga_actual            Int                      @default(0)
  image                   String?
  auditor_docs            Boolean                  @default(false)
  auditor_req             Boolean                  @default(false)
  trl_coord               Boolean                  @default(false)
  trl_mail                Boolean                  @default(false)
  alias                   String?                  @db.VarChar(50)
  clave                   String?                  @unique @db.VarChar(8)
  asignaciones_categorias AsignacionesCategorias[]
  historial_solicitudes   HistorialSolicitud[]
  logs                    Logs[]
  notificaciones_correo   NotificacionesCorreo[]
  permisos_seccion        PermisoUsuarioSeccion[]
  tickets_atendidos       Ticket[]                 @relation("Atiende")
  tickets_solicitados     Ticket[]                 @relation("Solicitante")
  traslados_auditor_docs  Traslado[]               @relation("AuditorDocs")
  traslados_auditor_req   Traslado[]               @relation("AuditorReq")
  empresa                 Empresa                  @relation(fields: [empresaId], references: [id])
  rol                     Rol                      @relation(fields: [rolId], references: [id])

  @@index([rolId, activo])
  @@index([empresaId])
  @@index([activo, vacaciones])
  @@map("usuario")
}

model Logs {
  id        Int      @id @default(autoincrement())
  accion    String   @db.VarChar(50)
  fecha     DateTime @default(now()) @db.Timestamp(6)
  detalles  Json?
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, fecha(sort: Desc)])
  @@map("logs")
}

model Ciclo {
  id           Int      @id @default(autoincrement())
  ciclo        String   @db.VarChar(10)
  fecha_inicio DateTime @db.Timestamp(6)
  fecha_fin    DateTime @db.Timestamp(6)
  activo       Boolean  @default(false)
  bloques      Bloque[]
  tickets      Ticket[]

  @@map("ciclo")
}

model Bloque {
  id          Int        @id @default(autoincrement())
  clave       String     @unique @db.VarChar(60)
  grado       Grado
  carreraId   Int
  descripcion String     @db.VarChar(120)
  dias        String     @db.VarChar(50)
  hora        String     @db.VarChar(50)
  cicloId     Int
  campusId    Int
  campus      Empresa    @relation(fields: [campusId], references: [id])
  carrera     Carrera    @relation(fields: [carreraId], references: [id])
  ciclo       Ciclo      @relation(fields: [cicloId], references: [id])
  traslados   Traslado[]

  @@map("bloque")
}

model Descuento {
  id          Int        @id @default(autoincrement())
  descripcion String     @db.VarChar(50)
  monto       Int
  activo      Boolean    @default(true)
  traslados   Traslado[]

  @@map("descuento")
}

model Estatus {
  id                    Int                  @id @default(autoincrement())
  nombre                String               @db.VarChar(50)
  descripcion           String?
  historial_solicitudes HistorialSolicitud[]
  tickets               Ticket[]

  @@map("estatus")
}

model Categoria {
  id                      Int                      @id @default(autoincrement())
  nombre                  String                   @db.VarChar(100)
  nivel_soporte_requerido NivelSoporte?
  activo                  Boolean                  @default(true)
  asignaciones_categorias AsignacionesCategorias[]
  roles_permitidos        PermisoCategoria[]
  subcategoria_categorias SubcategoriaCategorias[]
  tickets                 Ticket[]

  @@map("categoria")
}

model Subcategoria {
  id                      Int                      @id @default(autoincrement())
  nombre                  String                   @db.VarChar(100)
  parent_subcategoriaId   Int?
  nivel_soporte_requerido NivelSoporte?
  activo                  Boolean                  @default(true)
  asignaciones_categorias AsignacionesCategorias[]
  roles_permitidos        PermisoCategoria[]
  parent_subcategoria     Subcategoria?            @relation("SubcategoriaHierarchy", fields: [parent_subcategoriaId], references: [id])
  subcategorias           Subcategoria[]           @relation("SubcategoriaHierarchy")
  subcategoria_categorias SubcategoriaCategorias[]
  tickets                 Ticket[]

  @@map("subcategoria")
}

model SubcategoriaCategorias {
  categoriaId    Int
  subcategoriaId Int
  activo         Boolean      @default(true)
  categoria      Categoria    @relation(fields: [categoriaId], references: [id])
  subcategoria   Subcategoria @relation(fields: [subcategoriaId], references: [id])

  @@id([categoriaId, subcategoriaId])
  @@map("subcategoria_categorias")
}

model AsignacionesCategorias {
  id             Int           @id @default(autoincrement())
  atiendeId      Int
  categoriaId    Int?
  subcategoriaId Int?
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  prioridad      Int           @default(5)
  updatedAt      DateTime      @updatedAt
  atiende        Usuario       @relation(fields: [atiendeId], references: [id], onDelete: Cascade)
  categoria      Categoria?    @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  subcategoria   Subcategoria? @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)

  @@unique([atiendeId, categoriaId, subcategoriaId])
  @@index([categoriaId, subcategoriaId, activo])
  @@index([atiendeId, activo])
  @@map("asignaciones_categorias")
}

model Ticket {
  id                    Int                    @id @default(autoincrement())
  fechaalta             DateTime               @default(now()) @db.Timestamp(6)
  fechaact              DateTime               @default(now()) @db.Timestamp(6)
  estatusId             Int
  categoriaId           Int
  subcategoriaId        Int?
  solicitanteId         Int
  atiendeId             Int?
  prioridad             Prioridad
  descripcion           String?
  empresaId             Int
  archivado             Boolean                @default(false)
  archivos              Json?
  afectado_clave        String?                @db.VarChar(20)
  afectado_nombre       String?                @db.VarChar(150)
  cicloId               Int?
  historial_solicitudes HistorialSolicitud[]
  notificaciones_correo NotificacionesCorreo[]
  atiende               Usuario?               @relation("Atiende", fields: [atiendeId], references: [id])
  categoria             Categoria              @relation(fields: [categoriaId], references: [id])
  ciclo                 Ciclo?                 @relation(fields: [cicloId], references: [id])
  empresa               Empresa                @relation(fields: [empresaId], references: [id])
  estatus               Estatus                @relation(fields: [estatusId], references: [id])
  solicitante           Usuario                @relation("Solicitante", fields: [solicitanteId], references: [id])
  subcategoria          Subcategoria?          @relation(fields: [subcategoriaId], references: [id])
  traslados             Traslado?

  @@index([solicitanteId])
  @@index([estatusId])
  @@index([atiendeId])
  @@index([categoriaId])
  @@index([empresaId])
  @@index([fechaalta(sort: Desc)])
  @@index([estatusId, atiendeId, archivado])
  @@index([subcategoriaId, fechaalta])
  @@map("ticket")
}

model PlanPago {
  id          Int        @id @default(autoincrement())
  nombre      String     @db.VarChar(50)
  descripcion String?
  activo      Boolean    @default(true)
  traslados   Traslado[]

  @@map("plan_pago")
}

model Traslado {
  id                 Int       @id @default(autoincrement())
  ticketId           Int       @unique
  folio              String    @unique @db.VarChar(10)
  matricula          String    @db.VarChar(10)
  alumno             String    @db.VarChar(100)
  origenId           Int
  destinoId          Int
  carreraId          Int
  descuentoId        Int
  bloqueId           Int?
  actualizacion      Boolean   @default(false)
  planpagoId         Int?
  auditor_docsId     Int?
  auditor_reqId      Int?
  especial           Boolean   @default(false)
  descripcion_calif  String?
  descripcion_docs   String?
  descripcion_edocta String?
  validacion_calif   Boolean   @default(false)
  validacion_docs    Boolean   @default(false)
  validacion_edocta  Boolean   @default(false)
  bloque_nombre      String?   @db.VarChar(20)
  nuevo_ingreso      Boolean   @default(false)
  mail               String?   @db.VarChar(100)
  mail_escuela       String?   @db.VarChar(100)
  tel_movil          String?   @db.VarChar(20)
  telefono           String?   @db.VarChar(20)
  auditor_docs       Usuario?  @relation("AuditorDocs", fields: [auditor_docsId], references: [id])
  auditor_req        Usuario?  @relation("AuditorReq", fields: [auditor_reqId], references: [id])
  bloque             Bloque?   @relation(fields: [bloqueId], references: [id])
  carrera            Carrera   @relation(fields: [carreraId], references: [id])
  descuento          Descuento @relation(fields: [descuentoId], references: [id])
  destino            Empresa   @relation("Destino", fields: [destinoId], references: [id])
  origen             Empresa   @relation("Origen", fields: [origenId], references: [id])
  planpago           PlanPago? @relation(fields: [planpagoId], references: [id])
  ticket             Ticket    @relation(fields: [ticketId], references: [id])

  @@map("traslado")
}

model HistorialSolicitud {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  estatusId    Int
  usuarioId    Int
  fecha_cambio DateTime @default(now()) @db.Timestamp(6)
  comentario   String?
  archivos     Json?
  cambios      Json?
  estatus      Estatus  @relation(fields: [estatusId], references: [id])
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([ticketId, fecha_cambio(sort: Desc)])
  @@index([usuarioId])
  @@map("historial_solicitud")
}

model PlantillaCorreo {
  id                    Int                    @id @default(autoincrement())
  nombre                String                 @db.VarChar(100)
  contenido             String?
  tipo                  TipoPlantillaCorreo
  activo                Boolean                @default(false)
  notificaciones_correo NotificacionesCorreo[]

  @@map("plantilla_correo")
}

model NotificacionesCorreo {
  id             Int             @id @default(autoincrement())
  ticketId       Int
  destinatarioId Int
  fecha_envio    DateTime        @default(now()) @db.Timestamp(6)
  plantillaId    Int
  estatus        EstatusCorreo
  mensaje_error  String?
  destinatario   Usuario         @relation(fields: [destinatarioId], references: [id])
  plantilla      PlantillaCorreo @relation(fields: [plantillaId], references: [id])
  ticket         Ticket          @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([destinatarioId])
  @@map("notificaciones_correo")
}

model Permiso {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String?
  roles       Rol[]   @relation("PermisoToRol")

  @@map("permiso")
}

model PermisoCategoria {
  id             Int           @id @default(autoincrement())
  rolId          Int
  categoriaId    Int?
  subcategoriaId Int?
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  prioridad      Int           @default(0)
  updatedAt      DateTime      @updatedAt
  categoria      Categoria?    @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  rol            Rol           @relation(fields: [rolId], references: [id], onDelete: Cascade)
  subcategoria   Subcategoria? @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)

  @@unique([rolId, categoriaId, subcategoriaId])
  @@index([categoriaId, subcategoriaId, activo])
  @@index([rolId, activo])
  @@map("permiso_categoria")
}

model Seccion {
  id               Int                     @id @default(autoincrement())
  nombre           String                  @db.VarChar(100)
  identificador    String                  @unique @db.VarChar(100)
  grupo            String?                 @db.VarChar(50)
  descripcion      String?
  activo           Boolean                 @default(true)
  subgrupo         String?                 @db.VarChar(50)
  permisos_rol     PermisoRolSeccion[]
  permisos_usuario PermisoUsuarioSeccion[]

  @@map("seccion")
}

model PermisoRolSeccion {
  id        Int      @id @default(autoincrement())
  rolId     Int
  seccionId Int
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rol       Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)
  seccion   Seccion  @relation(fields: [seccionId], references: [id], onDelete: Cascade)

  @@unique([rolId, seccionId])
  @@index([rolId, activo])
  @@map("permiso_rol_seccion")
}

model PermisoUsuarioSeccion {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  seccionId Int
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seccion   Seccion  @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, seccionId])
  @@index([usuarioId, activo])
  @@map("permiso_usuario_seccion")
}

enum TipoEmpresa {
  Ejecutivo
  Magno
  Oficina
  Social
}

enum NivelSoporte {
  S_1           @map("S-1")
  S_2           @map("S-2")
  S_3           @map("S-3")
  Desarrollador
  Marketing
  Contador
  Usuario
  Coordinador
  Director
}

enum Grado {
  G_1       @map("1")
  G_2       @map("2")
  G_3       @map("3")
  G_4       @map("4")
  G_5       @map("5")
  G_6       @map("6")
  G_7       @map("7")
  G_8       @map("8")
  G_9       @map("9")
  G_10      @map("10")
  G_11      @map("11")
  G_12      @map("12")
  G_13      @map("13")
  G_14      @map("14")
  G_15      @map("15")
  G_16      @map("16")
  Seminario
}

enum Prioridad {
  Baja
  Media
  Alta
  Urgente
}

enum TipoPlantillaCorreo {
  Alumno
  Colaborador
  Notificacion_sistema @map("Notificación sistema")
  Automatico
  Vacaciones
}

enum EstatusCorreo {
  Enviado
  Pendiente
  Fallido
}
