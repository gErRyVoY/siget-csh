---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface Props {
    href: string;
    label: string;
    icon: AstroComponentFactory;
    active?: boolean;
    reload?: boolean;
    target?: string;
}

const { href, label, icon: Icon, active = false, reload = false, target } = Astro.props;

// Prefetch al pasar el cursor. Cada prefetch es un render SSR completo con sus
// consultas, así que se limita a los enlaces internos: los que abren en otra
// pestaña (Plataforma Humanitas) quedan fuera. Se escribe "hover" en lugar de un
// booleano porque Astro serializaría `true` como data-astro-prefetch="true", y el
// runtime sólo reconoce "", "false" o el nombre de una estrategia.
const prefetch = target ? undefined : "hover";
---

<a
    href={href}
    data-astro-reload={reload}
    data-astro-prefetch={prefetch}
    target={target}
    class:list={[
        "flex items-center gap-3 rounded-md px-4 py-2 text-sm font-medium transition-colors",
        active
            ? "bg-secondary/90 text-secondary-foreground"
            : "hover:bg-secondary/90 hover:text-secondary-foreground",
    ]}
>
    <Icon class="h-5 w-5" />
    <span class="group-data-[sidebar-collapsed=true]:hidden">{label}</span>
</a>
