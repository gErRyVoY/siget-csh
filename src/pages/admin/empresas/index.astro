---
import MainLayout from "@/layouts/MainLayout.astro";
import { prisma } from "@/lib/db";

const empresas = await prisma.empresa.findMany({
  orderBy: { nombre: "asc" },
  include: {
    _count: {
      select: { usuarios: true },
    },
  },
});
---

<MainLayout title="Gestión de Empresas">
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold">Gestión de Empresas</h1>
        <p class="text-sm text-muted-foreground">Configura opciones globales y accesos por campus/empresa.</p>
      </div>
      <div class="flex items-center gap-3">
        <button
          type="button"
          id="open-add-modal-btn"
          class="bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 rounded-md text-sm font-semibold transition-colors flex items-center gap-2 shadow-sm cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
          Añadir empresa
        </button>
        <a
          href="/admin/usuarios"
          class="bg-muted-foreground text-white hover:bg-muted-foreground/80 px-6 py-2 rounded-md text-sm font-semibold transition-colors"
        >
          Volver a Usuarios
        </a>
      </div>
    </div>

    <!-- Filtros rápidos -->
    <div class="flex justify-between items-center mb-4 gap-4 flex-wrap bg-card border rounded-lg p-4">
      <div class="flex items-center gap-4 flex-wrap">
        <div>
          <label for="tipo-select" class="mr-2 text-sm font-medium">Filtrar por Tipo:</label>
          <select id="tipo-select" class="bg-input border rounded-md p-2 text-sm">
            <option value="all">Todos</option>
            <option value="Magno">Magno</option>
            <option value="Ejecutivo">Ejecutivo</option>
            <option value="Oficina">Oficina</option>
            <option value="Social">Social</option>
          </select>
        </div>
        <div>
          <label for="virtual-select" class="mr-2 text-sm font-medium">Campus Virtual Origen:</label>
          <select id="virtual-select" class="bg-input border rounded-md p-2 text-sm">
            <option value="all">Todos</option>
            <option value="true">Habilitado</option>
            <option value="false">Deshabilitado</option>
          </select>
        </div>
      </div>
      <div class="text-sm text-muted-foreground">
        Total: <span id="company-count" class="font-semibold text-foreground">{empresas.length}</span> empresas
      </div>
    </div>

    <!-- Tabla de Empresas -->
    <div class="bg-card border rounded-lg overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-muted/50 border-b border-border">
            <tr>
              <th class="p-4 font-semibold text-foreground">Nombre</th>
              <th class="p-4 font-semibold text-foreground">Tipo</th>
              <th class="p-4 font-semibold text-foreground">Usuarios</th>
              <th class="p-4 font-semibold text-foreground text-center">Campus Virtual Origen</th>
              <th class="p-4 font-semibold text-foreground text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="companies-table-body">
            {
              empresas.map((empresa) => (
                <tr 
                  class="company-row border-b hover:bg-muted/30 transition-colors"
                  data-tipo={empresa.tipo}
                  data-tckt-virtual={empresa.tckt_virtual ? "true" : "false"}
                >
                  <td class="p-4 font-medium text-foreground">
                    {empresa.nombre}
                  </td>
                  <td class="p-4">
                    <span class={`px-2 py-1 rounded-full text-xs font-semibold ${
                      empresa.tipo === 'Magno' ? 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/30 dark:text-indigo-300' :
                      empresa.tipo === 'Ejecutivo' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300' :
                      empresa.tipo === 'Oficina' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300' :
                      'bg-slate-100 text-slate-800 dark:bg-slate-900/30 dark:text-slate-300'
                    }`}>
                      {empresa.tipo}
                    </span>
                  </td>
                  <td class="p-4 text-muted-foreground">
                    {empresa._count.usuarios} {empresa._count.usuarios === 1 ? 'usuario' : 'usuarios'}
                  </td>
                  <td class="p-4 text-center">
                    <div class="flex items-center justify-center">
                      <label class="relative inline-flex items-center cursor-pointer">
                        <input 
                          type="checkbox" 
                          class="sr-only peer toggle-tckt-virtual" 
                          data-company-slug={empresa.slug}
                          checked={empresa.tckt_virtual}
                        />
                        <div class="w-9 h-5 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                      </label>
                    </div>
                  </td>
                  <td class="p-4 text-right">
                    <a
                      href={`/admin/usuarios/${empresa.slug}`}
                      class="text-xs font-semibold bg-secondary text-secondary-foreground hover:bg-secondary/80 px-3 py-1.5 rounded-md transition-colors inline-flex items-center gap-1"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                      Ver Usuarios
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div
        id="no-companies-message"
        class="hidden p-8 text-center text-muted-foreground"
      >
        No se encontraron empresas con los filtros seleccionados.
      </div>
    </div>
  </div>

  <!-- Modal para Añadir Empresa -->
  <div
    id="add-company-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 overflow-y-auto"
  >
    <div
      class="bg-card text-card-foreground border border-border rounded-xl shadow-2xl w-full max-w-lg p-6 space-y-5 relative my-8 animate-in fade-in zoom-in duration-150"
    >
      <div class="flex justify-between items-center border-b border-border pb-3">
        <div>
          <h3 class="text-lg font-bold text-foreground">Añadir Nueva Empresa</h3>
          <p class="text-xs text-muted-foreground">Ingresa los datos para registrar un nuevo campus o empresa.</p>
        </div>
        <button
          type="button"
          id="close-modal-x"
          class="text-muted-foreground hover:text-foreground p-1 rounded-md hover:bg-muted transition-colors text-xl leading-none"
          aria-label="Cerrar modal"
        >
          &times;
        </button>
      </div>

      <form id="add-company-form" class="space-y-4">


        <!-- Nombre -->
        <div>
          <label for="company-nombre" class="block text-sm font-medium text-foreground mb-1">
            Nombre de la Empresa / Campus <span class="text-destructive">*</span>
          </label>
          <input
            type="text"
            id="company-nombre"
            required
            maxlength="50"
            class="w-full bg-input border border-border rounded-md px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            placeholder="Ej: Campus Cancún, Corporativo, etc."
          />
        </div>

        <!-- Slug -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="company-slug" class="block text-sm font-medium text-foreground">
              Slug <span class="text-destructive">*</span>
            </label>
            <button
              type="button"
              id="toggle-edit-slug-btn"
              class="text-xs text-primary hover:underline font-medium focus:outline-none"
            >
              Editar slug
            </button>
          </div>
          <input
            type="text"
            id="company-slug"
            required
            disabled
            maxlength="50"
            class="w-full bg-muted border border-border rounded-md px-3 py-2 text-sm text-muted-foreground font-mono disabled:cursor-not-allowed transition-colors"
            placeholder="se-generara-automaticamente"
          />
          <p class="text-[11px] text-muted-foreground mt-1">
            Sin espacios, acentos ni caracteres especiales. Espacios se sustituyen por guión medio (-).
          </p>
        </div>

        <!-- Tipo de Empresa -->
        <div>
          <label for="company-tipo" class="block text-sm font-medium text-foreground mb-1">
            Tipo de Empresa <span class="text-destructive">*</span>
          </label>
          <select
            id="company-tipo"
            required
            class="w-full bg-input border border-border rounded-md px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
          >
            <option value="" selected disabled>Selecciona el tipo</option>
            <option value="Magno">Magno</option>
            <option value="Ejecutivo">Ejecutivo</option>
            <option value="Oficina">Oficina</option>
            <option value="Social">Social</option>
          </select>
        </div>

        <!-- Toggles / Opciones por defecto -->
        <div class="border-t border-border pt-3 space-y-3">
          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
            Configuración por defecto
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="flex items-center justify-between p-2.5 bg-muted/40 border border-border/60 rounded-md cursor-pointer hover:bg-muted/70 transition-colors">
              <span class="text-xs font-medium text-foreground">Empresa Activa</span>
              <input type="checkbox" id="company-activa" checked class="rounded border-gray-300 text-primary focus:ring-primary h-4 w-4" />
            </label>

            <label class="flex items-center justify-between p-2.5 bg-muted/40 border border-border/60 rounded-md cursor-pointer hover:bg-muted/70 transition-colors">
              <span class="text-xs font-medium text-foreground">Puede levantar tickets a CSH</span>
              <input type="checkbox" id="company-tckt-csh" checked class="rounded border-gray-300 text-primary focus:ring-primary h-4 w-4" />
            </label>

            <label class="flex items-center justify-between p-2.5 bg-muted/40 border border-border/60 rounded-md cursor-pointer hover:bg-muted/70 transition-colors">
              <span class="text-xs font-medium text-foreground">Puede levantar tickets a Marketing</span>
              <input type="checkbox" id="company-tckt-mkt" class="rounded border-gray-300 text-primary focus:ring-primary h-4 w-4" />
            </label>

            <label class="flex items-center justify-between p-2.5 bg-muted/40 border border-border/60 rounded-md cursor-pointer hover:bg-muted/70 transition-colors">
              <span class="text-xs font-medium text-foreground">Acceso a campus Virtual</span>
              <input type="checkbox" id="company-tckt-virtual" class="rounded border-gray-300 text-primary focus:ring-primary h-4 w-4" />
            </label>
          </div>
        </div>

        <!-- Botones de Acción -->
        <div class="flex justify-end gap-3 border-t border-border pt-4">
          <button
            type="button"
            id="cancel-modal-btn"
            class="px-4 py-2 text-sm border border-border rounded-md hover:bg-muted transition-colors font-medium cursor-pointer"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="submit-company-btn"
            class="px-4 py-2 text-sm bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors font-semibold shadow-sm flex items-center gap-2 cursor-pointer"
          >
            Guardar Empresa
          </button>
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script>
  import { toast } from '@/lib/toast';

  function initCompaniesList() {
    const tableBody = document.getElementById("companies-table-body");
    const noCompaniesMessage = document.getElementById("no-companies-message");
    const tipoSelect = document.getElementById("tipo-select") as HTMLSelectElement;
    const virtualSelect = document.getElementById("virtual-select") as HTMLSelectElement;
    const countSpan = document.getElementById("company-count");

    if (!tableBody || !tipoSelect || !virtualSelect || !countSpan) return;

    // Lógica de Filtros en el Cliente
    function applyFilters() {
      const tipoVal = tipoSelect.value;
      const virtualVal = virtualSelect.value;
      const rows = tableBody!.querySelectorAll(".company-row");
      let visibleCount = 0;

      rows.forEach((row: any) => {
        const rowTipo = row.dataset.tipo;
        const rowVirtual = row.dataset.tcktVirtual;

        const matchesTipo = tipoVal === "all" || rowTipo === tipoVal;
        const matchesVirtual = virtualVal === "all" || rowVirtual === virtualVal;

        if (matchesTipo && matchesVirtual) {
          row.classList.remove("hidden");
          visibleCount++;
        } else {
          row.classList.add("hidden");
        }
      });

      countSpan!.textContent = visibleCount.toString();
      if (visibleCount === 0) {
        noCompaniesMessage?.classList.remove("hidden");
      } else {
        noCompaniesMessage?.classList.add("hidden");
      }
    }

    tipoSelect.addEventListener("change", applyFilters);
    virtualSelect.addEventListener("change", applyFilters);

    // Event Listeners para los toggles de tckt_virtual
    const toggles = tableBody!.querySelectorAll(".toggle-tckt-virtual");
    toggles.forEach((toggle: any) => {
      toggle.addEventListener("change", async (e: any) => {
        const checkbox = e.target as HTMLInputElement;
        const companySlug = checkbox.dataset.companySlug;
        if (!companySlug) return;

        const newValue = checkbox.checked;
        const row = checkbox.closest(".company-row") as HTMLElement;

        if (row) {
          row.dataset.tcktVirtual = newValue ? "true" : "false";
        }

        try {
          const response = await fetch('/api/admin/empresa', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: companySlug, tckt_virtual: newValue })
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || 'Error al actualizar');
          }

          toast.success(`Configuración actualizada correctamente.`);
        } catch (error: any) {
          console.error('Error al actualizar empresa:', error);
          checkbox.checked = !newValue;
          if (row) {
            row.dataset.tcktVirtual = (!newValue) ? "true" : "false";
          }
          toast.error(error.message || 'Error al actualizar la configuración.');
        }
      });
    });

    // --- Lógica del Modal Añadir Empresa ---
    const openAddModalBtn = document.getElementById("open-add-modal-btn");
    const addCompanyModal = document.getElementById("add-company-modal");
    const closeModalX = document.getElementById("close-modal-x");
    const cancelModalBtn = document.getElementById("cancel-modal-btn");
    const addCompanyForm = document.getElementById("add-company-form") as HTMLFormElement;
    const nombreInput = document.getElementById("company-nombre") as HTMLInputElement;
    const slugInput = document.getElementById("company-slug") as HTMLInputElement;
    const toggleEditSlugBtn = document.getElementById("toggle-edit-slug-btn") as HTMLButtonElement;
    const submitBtn = document.getElementById("submit-company-btn") as HTMLButtonElement;

    let isSlugManuallyEdited = false;

    // Generador y Sanitizador estricto de Slug
    function generateSlug(text: string): string {
      return text
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, "")
        .replace(/[\s-]+/g, "-");
    }

    function openModal() {
      if (!addCompanyModal || !addCompanyForm) return;
      addCompanyForm.reset();
      isSlugManuallyEdited = false;

      if (slugInput) {
        slugInput.disabled = true;
        slugInput.classList.add("disabled:cursor-not-allowed", "bg-muted", "text-muted-foreground");
        slugInput.classList.remove("bg-input", "text-foreground");
      }
      if (toggleEditSlugBtn) {
        toggleEditSlugBtn.textContent = "Editar slug";
      }
      addCompanyModal.classList.remove("hidden");
      nombreInput?.focus();
    }

    function closeModal() {
      if (!addCompanyModal) return;
      addCompanyModal.classList.add("hidden");
    }

    openAddModalBtn?.addEventListener("click", openModal);
    closeModalX?.addEventListener("click", closeModal);
    cancelModalBtn?.addEventListener("click", closeModal);

    addCompanyModal?.addEventListener("click", (e) => {
      if (e.target === addCompanyModal) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && addCompanyModal && !addCompanyModal.classList.contains("hidden")) {
        closeModal();
      }
    });

    // Auto-sugerir slug al escribir el nombre
    nombreInput?.addEventListener("input", () => {
      if (!isSlugManuallyEdited && slugInput) {
        slugInput.value = generateSlug(nombreInput.value);
      }
    });

    // Habilitar / Inhabilitar edición del slug
    toggleEditSlugBtn?.addEventListener("click", () => {
      if (!slugInput) return;
      if (slugInput.disabled) {
        slugInput.disabled = false;
        slugInput.classList.remove("disabled:cursor-not-allowed", "bg-muted", "text-muted-foreground");
        slugInput.classList.add("bg-input", "text-foreground");
        slugInput.focus();
        isSlugManuallyEdited = true;
        toggleEditSlugBtn.textContent = "Bloquear slug";
      } else {
        slugInput.disabled = true;
        slugInput.classList.add("disabled:cursor-not-allowed", "bg-muted", "text-muted-foreground");
        slugInput.classList.remove("bg-input", "text-foreground");
        toggleEditSlugBtn.textContent = "Editar slug";
      }
    });

    // Sanitización en tiempo real al escribir en el slug
    slugInput?.addEventListener("input", () => {
      isSlugManuallyEdited = true;
      const cursorStart = slugInput.selectionStart;
      const originalLen = slugInput.value.length;

      slugInput.value = generateSlug(slugInput.value);

      const newLen = slugInput.value.length;
      if (cursorStart !== null) {
        const diff = newLen - originalLen;
        slugInput.setSelectionRange(Math.max(0, cursorStart + diff), Math.max(0, cursorStart + diff));
      }
    });

    // Envío del Formulario
    addCompanyForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!nombreInput || !slugInput) return;

      const nombre = nombreInput.value.trim();
      const slug = slugInput.value.trim().replace(/^-+|-+$/g, "");
      const tipo = (document.getElementById("company-tipo") as HTMLSelectElement).value;
      const activa = (document.getElementById("company-activa") as HTMLInputElement).checked;
      const tckt_csh = (document.getElementById("company-tckt-csh") as HTMLInputElement).checked;
      const tckt_mkt = (document.getElementById("company-tckt-mkt") as HTMLInputElement).checked;
      const tckt_virtual = (document.getElementById("company-tckt-virtual") as HTMLInputElement).checked;

      if (!nombre) {
        toast.error("Por favor ingresa un nombre para la empresa.");
        return;
      }
      if (!slug) {
        toast.error("El slug es requerido.");
        return;
      }
      if (!tipo) {
        toast.error("Por favor selecciona el tipo de empresa.");
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Guardando...";
      }

      try {
        const res = await fetch("/api/admin/empresa", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            nombre,
            slug,
            tipo,
            activa,
            tckt_csh,
            tckt_mkt,
            tckt_virtual,
          }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.message || "Error al crear la empresa");
        }

        toast.success(`Empresa "${data.nombre}" creada correctamente.`);
        closeModal();

        // Recarga suave con View Transitions
        const { navigate } = await import("astro:transitions/client");
        navigate(window.location.href);
      } catch (err: any) {
        console.error(err);
        toast.error(err.message || "Error al crear la empresa.");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Guardar Empresa";
        }
      }
    });
  }

  document.addEventListener("astro:page-load", initCompaniesList);
</script>
