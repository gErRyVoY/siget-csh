---
import MainLayout from "@/layouts/MainLayout.astro";
import { prisma } from "@/lib/db";
import { getSession } from "auth-astro/server";
import SubcategoriaItem from "./SubcategoriaItem.astro";

const session = await getSession(Astro.request);
const user = session?.user;

if (!user) {
    return Astro.redirect("/login");
}

// Fetch all categories, subcategories, relations and ticket counts in parallel
const [
    categories, 
    subcategories, 
    subcatRelations, 
    ticketsCountByCategory, 
    ticketsCountBySubcategory
] = await Promise.all([
    prisma.categoria.findMany({ orderBy: { nombre: "asc" } }),
    prisma.subcategoria.findMany({ orderBy: { nombre: "asc" } }),
    prisma.subcategoriaCategorias.findMany(),
    prisma.ticket.groupBy({
        by: ['categoriaId'],
        _count: { id: true }
    }),
    prisma.ticket.groupBy({
        by: ['subcategoriaId'],
        _count: { id: true }
    })
]);

// Build ticket count maps for O(1) lookup
const catTicketsMap = new Map<number, number>();
ticketsCountByCategory.forEach(group => {
    catTicketsMap.set(group.categoriaId, group._count.id);
});

const subTicketsMap = new Map<number, number>();
ticketsCountBySubcategory.forEach(group => {
    if (group.subcategoriaId !== null) {
        subTicketsMap.set(group.subcategoriaId, group._count.id);
    }
});

// Recursive tree node definition
interface TreeNode {
    id: number;
    nombre: string;
    activo: boolean;
    parent_subcategoriaId: number | null;
    ticketsCount: number;
    children: TreeNode[];
}

// Build subcategory tree nodes recursively
function buildSubcategoryTree(
    parentSubId: number | null, 
    catId: number, 
    allSubs: typeof subcategories, 
    relations: typeof subcatRelations, 
    subTickets: Map<number, number>
): TreeNode[] {
    const levelSubs = allSubs.filter(sub => {
        if (parentSubId === null) {
            const isLinked = relations.some(r => r.categoriaId === catId && r.subcategoriaId === sub.id);
            return isLinked && sub.parent_subcategoriaId === null;
        } else {
            return sub.parent_subcategoriaId === parentSubId;
        }
    });

    return levelSubs.map(sub => {
        const children = buildSubcategoryTree(sub.id, catId, allSubs, relations, subTickets);
        const ownTickets = subTickets.get(sub.id) || 0;
        const childrenTickets = children.reduce((sum, child) => sum + child.ticketsCount, 0);

        return {
            id: sub.id,
            nombre: sub.nombre,
            activo: sub.activo,
            parent_subcategoriaId: sub.parent_subcategoriaId,
            ticketsCount: ownTickets + childrenTickets,
            children: children.sort((a, b) => a.nombre.localeCompare(b.nombre))
        };
    }).sort((a, b) => a.nombre.localeCompare(b.nombre));
}

// Construct categories tree
const categoriesTree = categories.map(cat => {
    const subTree = buildSubcategoryTree(null, cat.id, subcategories, subcatRelations, subTicketsMap);
    const ownTickets = catTicketsMap.get(cat.id) || 0;
    const subTickets = subTree.reduce((sum, node) => sum + node.ticketsCount, 0);

    return {
        id: cat.id,
        nombre: cat.nombre,
        activo: cat.activo,
        ticketsCount: ownTickets + subTickets,
        subcategorias: subTree
    };
}).sort((a, b) => a.nombre.localeCompare(b.nombre));
---

<MainLayout title="Gestión de categorías">
    <div class="max-w-4xl mx-auto space-y-6">
        <!-- HEADER BUTTONS -->
        <div class="flex justify-between items-center bg-card p-4 rounded-lg border border-border">
            <h1 class="text-lg font-bold text-foreground">Administración de Categorías</h1>
            <div class="flex items-center gap-4">
                <button
                    type="button"
                    id="new-category-btn"
                    class="bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 rounded-md text-sm font-semibold h-10 transition-colors flex items-center gap-2"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Nueva categoría
                </button>
                <button
                    type="button"
                    id="reset-accordions-button"
                    class="bg-muted text-muted-foreground hover:bg-muted/80 px-4 py-2 rounded-md text-sm font-semibold h-10 transition-colors"
                >
                    Restablecer
                </button>
            </div>
        </div>

        <!-- NEW CATEGORY INLINE FORM -->
        <div id="new-cat-form-container" class="hidden bg-card border border-dashed border-primary/50 rounded-lg p-4 flex items-center justify-between gap-4">
            <input 
                type="text" 
                id="new-cat-input" 
                class="border border-border rounded-md px-3 py-2 text-sm flex-1 bg-background focus:outline-primary" 
                placeholder="Escribe el nombre de la nueva categoría..." 
            />
            <div class="flex items-center gap-2">
                <button id="save-new-cat-btn" class="bg-primary text-primary-foreground hover:bg-primary/95 px-4 py-2 rounded-md text-sm font-semibold">
                    Guardar
                </button>
                <button id="cancel-new-cat-btn" class="bg-muted text-muted-foreground hover:bg-muted/80 px-3 py-2 rounded-md text-sm font-semibold">
                    Cancelar
                </button>
            </div>
        </div>

        <!-- CATEGORIES TREE CONTAINER -->
        <div class="space-y-4" id="categories-tree-root">
            {categoriesTree.map(cat => (
                <details 
                    class="group/cat bg-card border border-border rounded-lg shadow-sm main-accordion" 
                    data-id={cat.id} 
                    data-type="categoria"
                    data-name={cat.nombre}
                >
                    <summary class="cat-summary flex items-center justify-between gap-4 p-3 cursor-pointer list-none select-none outline-none transition-colors rounded-lg group-open/cat:rounded-b-none border-b border-transparent group-open/cat:border-border">
                        <div class="flex items-center gap-2 flex-1 overflow-hidden">
                            <div class="transform transition-transform duration-200 group-open/cat:rotate-90 shrink-0 mr-1 chevron-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-current"><path d="m9 6 6 6-6 6"/></svg>
                            </div>
                            <span class="text-sm font-bold uppercase truncate text-primary name-text" data-id={cat.id} data-type="categoria">{cat.nombre}</span>
                            
                                <div class="edit-container hidden flex items-center gap-2 flex-1 max-w-md" onclick="event.stopPropagation();">
                                    <input 
                                        type="text" 
                                        class="edit-input border border-border rounded px-2 py-1 text-sm font-bold uppercase flex-1 bg-background focus:outline-primary" 
                                        value={cat.nombre} 
                                        data-original={cat.nombre}
                                    />
                                    <button class="save-edit-btn p-1 hover:bg-muted rounded" title="Guardar">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600"><path d="M20 6 9 17l-5-5"/></svg>
                                    </button>
                                    {cat.subcategorias.length === 0 ? (
                                        <button class="delete-btn p-1 hover:bg-muted rounded" title="Eliminar">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                        </button>
                                    ) : null}
                                </div>
                        </div>
                        
                        <div class="flex items-center gap-3 shrink-0" onclick="event.stopPropagation();">
                            <!-- Toggle Active Button (Eye Open/Closed) -->
                            <button 
                                class="toggle-active-btn p-1 hover:bg-muted rounded transition-colors" 
                                data-id={cat.id} 
                                data-type="categoria"
                                data-active={cat.activo ? "true" : "false"}
                                title={cat.activo ? "Desactivar categoría" : "Activar categoría"}
                            >
                                {cat.activo ? (
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0z"/><circle cx="12" cy="12" r="3"/></svg>
                                ) : (
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground opacity-50"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.52 13.52 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                                )}
                            </button>

                            <!-- Edit Pencil Button (only if ticketsCount === 0) -->
                            {cat.ticketsCount === 0 ? (
                                <button 
                                    class="edit-btn p-1 hover:bg-muted rounded transition-colors" 
                                    data-id={cat.id} 
                                    data-type="categoria"
                                    title="Editar/Eliminar"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                </button>
                            ) : (
                                <span class="w-7 h-7 inline-block"></span>
                            )}

                            <!-- Plus Add Subcategory Button -->
                            <button 
                                class="add-sub-btn p-1 hover:bg-muted rounded transition-colors" 
                                data-id={cat.id} 
                                data-type="categoria"
                                title="Añadir subcategoría"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                        </div>
                    </summary>
                    
                    <div class="p-3 pl-8 bg-card rounded-b-lg border-t border-border">
                        <!-- Inline add subcategory form -->
                        <div class="new-sub-form-container hidden p-2 border border-dashed rounded mb-2 flex items-center justify-between gap-4">
                            <input 
                                type="text" 
                                class="new-sub-input border border-border rounded px-2 py-1 text-sm flex-1 bg-background focus:outline-primary" 
                                placeholder="Escribe el nombre de la subcategoría..." 
                            />
                            <button class="save-new-sub-btn bg-primary text-primary-foreground px-3 py-1 rounded text-xs hover:bg-primary/95" data-cat-id={cat.id}>
                                Guardar
                            </button>
                        </div>

                        {cat.subcategorias.length > 0 ? (
                            cat.subcategorias.map(sub => (
                                <SubcategoriaItem node={sub} catId={cat.id} level={1} />
                            ))
                        ) : (
                            <div class="no-subs-msg p-2 text-sm text-muted-foreground italic">
                                Sin subcategorías
                            </div>
                        )}
                    </div>
                </details>
            ))}
        </div>
    </div>

    <!-- Modal de Confirmación de Eliminación -->
    <div
        id="delete-confirm-modal"
        class="fixed inset-0 z-50 hidden items-center justify-center"
        role="dialog"
        aria-modal="true"
    >
        <!-- Overlay -->
        <div id="delete-confirm-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
        <!-- Panel -->
        <div class="relative bg-card border border-border rounded-xl shadow-xl p-6 w-full max-w-sm mx-4 flex flex-col gap-4">
            <!-- Icon + Title -->
            <div class="flex items-start gap-3">
                <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-destructive/10">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-destructive"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                </div>
                <div>
                    <h3 class="text-base font-semibold text-foreground">Confirmar eliminación</h3>
                    <p id="delete-confirm-message" class="text-sm text-muted-foreground mt-1"></p>
                </div>
            </div>
            <!-- Actions -->
            <div class="flex gap-3 justify-end">
                <button
                    id="delete-confirm-cancel"
                    type="button"
                    class="bg-muted text-muted-foreground hover:bg-muted/80 px-4 py-2 rounded-md text-sm font-semibold transition-colors cursor-pointer"
                >
                    Cancelar
                </button>
                <button
                    id="delete-confirm-ok"
                    type="button"
                    class="bg-destructive text-destructive-foreground hover:bg-destructive/90 px-4 py-2 rounded-md text-sm font-semibold transition-colors cursor-pointer"
                >
                    Eliminar
                </button>
            </div>
        </div>
    </div>
</MainLayout>

<style is:global>
@keyframes highlight-fade {
  0% {
    background-color: #800020;
    color: #ffffff !important;
  }
  50% {
    background-color: #800020;
    color: #ffffff !important;
  }
  100% {
    background-color: transparent;
    color: inherit !important;
  }
}

.highlight-new > summary {
  animation: highlight-fade 3s ease-in-out forwards;
}

/* Hover: guinda + texto blanco */
.cat-summary:hover,
.sub-summary:hover {
  background-color: #800020 !important;
  color: #ffffff !important;
}
.cat-summary:hover .name-text,
.sub-summary:hover .name-text {
  color: #ffffff !important;
}
.cat-summary:hover .chevron-icon,
.sub-summary:hover .chevron-icon {
  color: #ffffff !important;
}
.cat-summary:hover .text-muted-foreground,
.sub-summary:hover .text-muted-foreground {
  color: #ffffff !important;
  opacity: 1 !important;
}

/* Active/selected: guinda + texto blanco */
.cat-summary.is-active,
.sub-summary.is-active {
  background-color: #800020 !important;
  color: #ffffff !important;
}
.cat-summary.is-active .name-text,
.sub-summary.is-active .name-text {
  color: #ffffff !important;
}
.cat-summary.is-active .chevron-icon,
.sub-summary.is-active .chevron-icon {
  color: #ffffff !important;
}
.cat-summary.is-active .text-muted-foreground,
.sub-summary.is-active .text-muted-foreground {
  color: #ffffff !important;
  opacity: 1 !important;
}

summary::-webkit-details-marker {
  display: none;
}
</style>

<script>
    import { toast } from "@/lib/toast";

    function setupCategoriasManager() {
        // ── Sanitize input characters ────────────────────────────────────
        function sanitizeInput(input: HTMLInputElement) {
            input.value = input.value.replace(/[^A-Za-z0-9áéíóúÁÉÍÓÚüÜñÑ\s]/g, '');
        }
        document.addEventListener('input', (e) => {
            const target = e.target as HTMLInputElement;
            if (target && (target.classList.contains('edit-input') || target.classList.contains('new-sub-input') || target.id === 'new-cat-input')) {
                sanitizeInput(target);
            }
        });

        // ── Custom confirm modal (shared for delete AND unsaved changes) ──
        const confirmModal    = document.getElementById('delete-confirm-modal') as HTMLElement;
        const confirmOverlay  = document.getElementById('delete-confirm-overlay') as HTMLElement;
        const confirmMessage  = document.getElementById('delete-confirm-message') as HTMLElement;
        const confirmOkBtn    = document.getElementById('delete-confirm-ok') as HTMLButtonElement;
        const confirmCancelBtn= document.getElementById('delete-confirm-cancel') as HTMLButtonElement;
        let _resolveConfirm: ((v: boolean) => void) | null = null;

        const openConfirmModal = (message: string, okLabel = 'Confirmar', cancelLabel = 'Cancelar'): Promise<boolean> => {
            confirmMessage.textContent = message;
            confirmOkBtn.textContent   = okLabel;
            confirmCancelBtn.textContent = cancelLabel;
            confirmModal.classList.remove('hidden');
            confirmModal.classList.add('flex');
            return new Promise(resolve => { _resolveConfirm = resolve; });
        };
        const closeConfirmModal = (result: boolean) => {
            confirmModal.classList.add('hidden');
            confirmModal.classList.remove('flex');
            if (_resolveConfirm) { _resolveConfirm(result); _resolveConfirm = null; }
        };
        confirmCancelBtn.addEventListener('click', () => closeConfirmModal(false));
        confirmOkBtn.addEventListener('click',     () => closeConfirmModal(true));
        confirmOverlay.addEventListener('click',   () => closeConfirmModal(false));

        // ── Selected (active) state tracking ─────────────────────────────
        function setActiveSummary(summary: HTMLElement | null) {
            document.querySelectorAll('.cat-summary.is-active, .sub-summary.is-active').forEach(s => s.classList.remove('is-active'));
            if (summary) summary.classList.add('is-active');
        }
        document.querySelectorAll('.cat-summary, .sub-summary').forEach(s => {
            s.addEventListener('click', () => setActiveSummary(s as HTMLElement));
        });

        // ── Single-open accordion behavior ────────────────────────────────
        const mainAccordions = document.querySelectorAll('.main-accordion');
        mainAccordions.forEach(acc => {
            acc.addEventListener('toggle', () => {
                const target = acc as HTMLDetailsElement;
                if (target.open) {
                    mainAccordions.forEach(other => {
                        if (other !== target && (other as HTMLDetailsElement).open) {
                            (other as HTMLDetailsElement).open = false;
                        }
                    });
                }
            });
        });
        document.querySelectorAll('.sub-accordion').forEach(subAcc => {
            subAcc.addEventListener('toggle', (e) => {
                const target = subAcc as HTMLDetailsElement;
                e.stopPropagation();
                if (target.open) {
                    const siblings = target.parentElement?.querySelectorAll(':scope > .sub-accordion') || [];
                    siblings.forEach(sib => {
                        if (sib !== target && (sib as HTMLDetailsElement).open) {
                            (sib as HTMLDetailsElement).open = false;
                        }
                    });
                }
            });
        });

        // ── Helper: check for active editing / creation states ───────────
        function getActiveEditContainer(): HTMLElement | null {
            return document.querySelector('.edit-container:not(.hidden)') as HTMLElement | null;
        }
        function getActiveNewSubContainer(): HTMLElement | null {
            return document.querySelector('.new-sub-form-container:not(.hidden)') as HTMLElement | null;
        }
        function isNewCatFormOpen(): boolean {
            return !(document.getElementById('new-cat-form-container')?.classList.contains('hidden') ?? true);
        }

        // ── Guard: ask user about unsaved edit ───────────────────────────
        async function guardPendingEdit(allowSave = true): Promise<'save' | 'discard' | 'cancel'> {
            const editContainer = getActiveEditContainer();
            if (!editContainer) return 'discard';
            const input = editContainer.querySelector('.edit-input') as HTMLInputElement;
            const original = input.dataset.original || '';
            const current  = input.value.trim();
            if (current === original || current === '') return 'discard'; // no real change
            if (!allowSave) {
                closeEditInline(editContainer);
                return 'discard';
            }
            const save = await openConfirmModal(
                `Hay cambios sin guardar en "${original}". ¿Deseas guardarlos antes de continuar?`,
                'Guardar', 'Descartar'
            );
            if (save) {
                // Trigger save
                const saveBtn = editContainer.querySelector('.save-edit-btn') as HTMLButtonElement;
                saveBtn?.click();
                return 'save';
            }
            closeEditInline(editContainer);
            return 'discard';
        }

        async function guardPendingNewSub(): Promise<'save' | 'discard' | 'cancel'> {
            const container = getActiveNewSubContainer();
            if (!container) return 'discard';
            const input = container.querySelector('.new-sub-input') as HTMLInputElement;
            if (!input.value.trim()) {
                closeNewSubForm(container);
                return 'discard';
            }
            const save = await openConfirmModal(
                `Hay texto escrito en el campo de nueva subcategoría. ¿Deseas guardarlo antes de continuar?`,
                'Guardar', 'Descartar'
            );
            if (save) {
                const saveBtn = container.querySelector('.save-new-sub-btn') as HTMLButtonElement;
                saveBtn?.click();
                return 'save';
            }
            closeNewSubForm(container);
            return 'discard';
        }

        async function guardPendingNewCat(): Promise<'save' | 'discard' | 'cancel'> {
            if (!isNewCatFormOpen()) return 'discard';
            const input = document.getElementById('new-cat-input') as HTMLInputElement;
            if (!input?.value.trim()) {
                closeNewCatForm();
                return 'discard';
            }
            const save = await openConfirmModal(
                `Hay texto escrito en el campo de nueva categoría. ¿Deseas guardarlo antes de continuar?`,
                'Guardar', 'Descartar'
            );
            if (save) {
                document.getElementById('save-new-cat-btn')?.dispatchEvent(new Event('click'));
                return 'save';
            }
            closeNewCatForm();
            return 'discard';
        }

        // ── Close helpers ─────────────────────────────────────────────────
        function closeEditInline(container: HTMLElement) {
            const summary = container.closest('summary');
            if (!summary) return;
            const nameText  = summary.querySelector('.name-text') as HTMLElement;
            const input     = container.querySelector('.edit-input') as HTMLInputElement;
            input.value = input.dataset.original || '';
            container.classList.add('hidden');
            nameText.classList.remove('hidden');
        }
        function closeNewSubForm(container: HTMLElement) {
            container.classList.add('hidden');
            const input = container.querySelector('.new-sub-input') as HTMLInputElement;
            if (input) input.value = '';
        }
        function closeNewCatForm() {
            const formContainer = document.getElementById('new-cat-form-container');
            formContainer?.classList.add('hidden');
            const input = document.getElementById('new-cat-input') as HTMLInputElement;
            if (input) input.value = '';
        }

        // ── ESC key: closes accordion, edit, or new forms ────────────────
        document.addEventListener('keydown', async (e) => {
            // If confirm modal is open, close it
            if (e.key === 'Escape' && !confirmModal.classList.contains('hidden')) {
                closeConfirmModal(false);
                return;
            }

            if (e.key === 'Escape') {
                // 1. Active inline edit?
                const editContainer = getActiveEditContainer();
                if (editContainer) {
                    const input    = editContainer.querySelector('.edit-input') as HTMLInputElement;
                    const original = input.dataset.original || '';
                    if (input.value.trim() !== original && input.value.trim() !== '') {
                        const save = await openConfirmModal(
                            `Hay cambios sin guardar en "${original}". ¿Deseas guardarlos?`,
                            'Guardar', 'Descartar'
                        );
                        if (save) { editContainer.querySelector<HTMLButtonElement>('.save-edit-btn')?.click(); return; }
                    }
                    closeEditInline(editContainer);
                    return;
                }

                // 2. Active new-sub form?
                const newSubContainer = getActiveNewSubContainer();
                if (newSubContainer) {
                    const input = newSubContainer.querySelector('.new-sub-input') as HTMLInputElement;
                    if (input.value.trim()) {
                        const save = await openConfirmModal(
                            'Hay texto escrito. ¿Deseas guardar la nueva subcategoría antes de cerrar?',
                            'Guardar', 'Descartar'
                        );
                        if (save) { newSubContainer.querySelector<HTMLButtonElement>('.save-new-sub-btn')?.click(); return; }
                    }
                    closeNewSubForm(newSubContainer);
                    return;
                }

                // 3. New category form open?
                if (isNewCatFormOpen()) {
                    const input = document.getElementById('new-cat-input') as HTMLInputElement;
                    if (input?.value.trim()) {
                        const save = await openConfirmModal(
                            'Hay texto escrito. ¿Deseas guardar la nueva categoría antes de cerrar?',
                            'Guardar', 'Descartar'
                        );
                        if (save) { document.getElementById('save-new-cat-btn')?.dispatchEvent(new Event('click')); return; }
                    }
                    closeNewCatForm();
                    return;
                }

                // 4. Close the currently open accordion
                const openMain = document.querySelector('details.main-accordion[open]') as HTMLDetailsElement | null;
                if (openMain) { openMain.open = false; return; }
            }
        });

        // ── Eye Toggle Active/Inactive ────────────────────────────────────
        document.querySelectorAll('.toggle-active-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                // Guard pending edits first
                await guardPendingEdit(false);
                await guardPendingNewSub();
                await guardPendingNewCat();

                const button = btn as HTMLButtonElement;
                const id     = button.dataset.id;
                const type   = button.dataset.type;
                const active = button.dataset.active === "true";
                const label  = type === 'categoria' ? 'categoría' : 'subcategoría';
                const url    = type === "categoria" ? "/api/admin/categorias" : "/api/admin/subcategories";

                try {
                    button.disabled = true;
                    const res = await fetch(url, {
                        method: "PATCH",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ id, activo: !active })
                    });
                    if (!res.ok) throw new Error((await res.json()).error || "Error al actualizar");
                    const action = !active ? 'habilitada' : 'ocultada';
                    toast.success(`La ${label} ha sido ${action} para los usuarios al levantar un ticket.`);
                    saveOpenState();
                    window.location.reload();
                } catch (error: any) {
                    toast.error(error.message);
                    button.disabled = false;
                }
            });
        });

        // ── Edit (Pencil) Click ───────────────────────────────────────────
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                // Guard pending edits before opening a new one
                await guardPendingEdit(true);
                await guardPendingNewSub();
                await guardPendingNewCat();

                const button = btn as HTMLButtonElement;
                const summary = button.closest('summary');
                if (!summary) return;

                const nameText     = summary.querySelector('.name-text') as HTMLElement;
                const editContainer= summary.querySelector('.edit-container') as HTMLElement;
                const editInput    = editContainer.querySelector('.edit-input') as HTMLInputElement;

                nameText.classList.add('hidden');
                editContainer.classList.remove('hidden');
                editInput.focus();
                editInput.select();
            });
        });

        // ── Save Edit ────────────────────────────────────────────────────
        document.querySelectorAll('.save-edit-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const button   = btn as HTMLButtonElement;
                const summary  = button.closest('summary');
                if (!summary) return;

                const editInput = summary.querySelector('.edit-input') as HTMLInputElement;
                const nameText  = summary.querySelector('.name-text') as HTMLElement;
                const id   = nameText.dataset.id;
                const type = nameText.dataset.type;
                const val  = editInput.value.trim();

                if (!val) { toast.error("El nombre no puede estar vacío"); return; }

                const url = type === "categoria" ? "/api/admin/categorias" : "/api/admin/subcategories";
                try {
                    button.disabled = true;
                    const res = await fetch(url, {
                        method: "PATCH",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ id, nombre: val })
                    });
                    if (!res.ok) throw new Error((await res.json()).error || "Error al guardar");
                    saveOpenState();
                    sessionStorage.setItem('highlight_item', `${type}-${id}`);
                    window.location.reload();
                } catch (error: any) {
                    toast.error(error.message);
                    button.disabled = false;
                }
            });
        });

        // ── Delete (Trash) Click ──────────────────────────────────────────
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const button  = btn as HTMLButtonElement;
                const summary = button.closest('summary');
                if (!summary) return;

                const nameText = summary.querySelector('.name-text') as HTMLElement;
                const id     = nameText.dataset.id;
                const type   = nameText.dataset.type;
                const nombre = nameText.textContent;

                const label     = type === 'categoria' ? 'categoría' : 'subcategoría';
                const confirmed = await openConfirmModal(
                    `¿Estás seguro de que deseas eliminar la ${label} "${nombre}" permanentemente? Esta acción no se puede deshacer.`,
                    'Eliminar', 'Cancelar'
                );
                if (!confirmed) return;

                const url = type === "categoria"
                    ? `/api/admin/categorias?id=${id}`
                    : `/api/admin/subcategories?id=${id}`;
                try {
                    button.disabled = true;
                    const res = await fetch(url, { method: "DELETE" });
                    if (!res.ok) throw new Error((await res.json()).error || "Error al eliminar");
                    toast.success("Eliminado correctamente");
                    saveOpenState();
                    window.location.reload();
                } catch (error: any) {
                    toast.error(error.message);
                    button.disabled = false;
                }
            });
        });

        // ── Plus (+) Click to Add Subcategory ────────────────────────────
        document.querySelectorAll('.add-sub-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                // Guard any pending operation
                await guardPendingEdit(true);
                await guardPendingNewSub();
                await guardPendingNewCat();

                const button  = btn as HTMLButtonElement;
                const details = button.closest('details');
                if (details) {
                    details.open = true;
                    const newSubContainer = details.querySelector(':scope > div > .new-sub-form-container') as HTMLElement;
                    if (newSubContainer) {
                        newSubContainer.classList.remove('hidden');
                        const input = newSubContainer.querySelector('.new-sub-input') as HTMLInputElement;
                        input.focus();
                        newSubContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                }
            });
        });

        // ── Save New Subcategory ──────────────────────────────────────────
        document.querySelectorAll('.save-new-sub-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const button          = btn as HTMLButtonElement;
                const parentContainer = button.closest('.new-sub-form-container') as HTMLElement;
                const input           = parentContainer.querySelector('.new-sub-input') as HTMLInputElement;
                const val             = input.value.trim();
                const catId           = button.dataset.catId;
                const parentSubId     = button.dataset.parentId;

                if (!val) { toast.error("El nombre no puede estar vacío"); return; }
                try {
                    button.disabled = true;
                    const res = await fetch("/api/admin/subcategories", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ nombre: val, categoriaId: catId || null, parentSubcategoriaId: parentSubId || null })
                    });
                    if (!res.ok) throw new Error((await res.json()).error || "Error al crear");
                    const newSub = await res.json();
                    saveOpenState();
                    sessionStorage.setItem('highlight_item', `subcategoria-${newSub.id}`);
                    window.location.reload();
                } catch (error: any) {
                    toast.error(error.message);
                    button.disabled = false;
                }
            });
        });

        // ── Reset button ──────────────────────────────────────────────────
        const resetButton = document.getElementById("reset-accordions-button");
        if (resetButton) {
            resetButton.addEventListener("click", () => {
                document.querySelectorAll('details').forEach(d => { d.open = false; });
                document.querySelectorAll('.new-sub-form-container').forEach(form => {
                    form.classList.add('hidden');
                    const input = form.querySelector('input');
                    if (input) input.value = "";
                });
                closeNewCatForm();
                setActiveSummary(null);
                toast.success("Acordeones restablecidos");
            });
        }

        // ── Nueva categoría button ────────────────────────────────────────
        const newCatBtn           = document.getElementById("new-category-btn");
        const newCatFormContainer = document.getElementById("new-cat-form-container");
        const newCatInput         = document.getElementById("new-cat-input") as HTMLInputElement;
        const saveNewCatBtn       = document.getElementById("save-new-cat-btn");
        const cancelNewCatBtn     = document.getElementById("cancel-new-cat-btn");

        if (newCatBtn && newCatFormContainer && newCatInput) {
            newCatBtn.addEventListener("click", async () => {
                await guardPendingEdit(true);
                await guardPendingNewSub();
                newCatFormContainer.classList.remove("hidden");
                newCatInput.focus();
                newCatFormContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
        }
        if (cancelNewCatBtn && newCatFormContainer && newCatInput) {
            cancelNewCatBtn.addEventListener("click", () => {
                closeNewCatForm();
            });
        }
        if (saveNewCatBtn && newCatInput) {
            saveNewCatBtn.addEventListener("click", async () => {
                const val = newCatInput.value.trim();
                if (!val) { toast.error("El nombre no puede estar vacío"); return; }
                try {
                    const res = await fetch("/api/admin/categorias", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ nombre: val })
                    });
                    if (!res.ok) throw new Error((await res.json()).error || "Error al crear la categoría");
                    const newCat = await res.json();
                    saveOpenState();
                    sessionStorage.setItem('highlight_item', `categoria-${newCat.id}`);
                    window.location.reload();
                } catch (error: any) {
                    toast.error(error.message);
                }
            });
        }

        // ── State Helpers ─────────────────────────────────────────────────
        function saveOpenState() {
            const openIds: string[] = [];
            document.querySelectorAll('details.main-accordion[open]').forEach(el => {
                const id = el.getAttribute('data-id');
                if (id) openIds.push(`categoria-${id}`);
            });
            document.querySelectorAll('details.sub-accordion[open]').forEach(el => {
                const id = el.getAttribute('data-id');
                if (id) openIds.push(`subcategoria-${id}`);
            });
            sessionStorage.setItem('open_items', JSON.stringify(openIds));
        }

        function restoreOpenState() {
            const openItemsStr = sessionStorage.getItem('open_items');
            if (openItemsStr) {
                const openItems = JSON.parse(openItemsStr) as string[];
                openItems.forEach(itemKey => {
                    const [type, id] = itemKey.split('-');
                    if (type === "categoria") {
                        const el = document.querySelector(`details.main-accordion[data-id="${id}"]`) as HTMLDetailsElement;
                        if (el) el.open = true;
                    } else if (type === "subcategoria") {
                        const el = document.querySelector(`details.sub-accordion[data-id="${id}"]`) as HTMLDetailsElement;
                        if (el) el.open = true;
                    }
                });
                sessionStorage.removeItem('open_items');
            }

            const highlightKey = sessionStorage.getItem('highlight_item');
            if (highlightKey) {
                const [type, id] = highlightKey.split('-');
                let element: HTMLElement | null = null;
                if (type === "categoria") {
                    element = document.querySelector(`details.main-accordion[data-id="${id}"]`) as HTMLElement;
                } else if (type === "subcategoria") {
                    element = document.querySelector(`details.sub-accordion[data-id="${id}"]`) as HTMLElement;
                }
                if (element) {
                    let parent = element.parentElement?.closest('details') as HTMLDetailsElement;
                    while (parent) { parent.open = true; parent = parent.parentElement?.closest('details') as HTMLDetailsElement; }
                    if (element instanceof HTMLDetailsElement) element.open = true;
                    element.classList.add('highlight-new');
                    setTimeout(() => { element?.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 300);
                }
                sessionStorage.removeItem('highlight_item');
            }
        }

        restoreOpenState();
    }

    document.addEventListener("astro:page-load", setupCategoriasManager);
</script>
