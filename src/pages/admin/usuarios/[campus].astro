---
import MainLayout from "@/layouts/MainLayout.astro";
import { prisma } from "@/lib/db";

const { campus } = Astro.params;

const empresa = await prisma.empresa.findUnique({
  where: { slug: campus },
});

if (!empresa) {
  return Astro.redirect("/404");
}

let title = empresa.nombre;
if (["Magno", "Ejecutivo"].includes(empresa.tipo)) {
  title = `Campus ${empresa.nombre}`;
}

const hasAdminOrSuperadmin = (await prisma.usuario.count({
  where: {
    empresaId: empresa.id,
    rolId: { in: [2, 3] },
  },
})) > 0;
---

<MainLayout title={title}>
  <div class="max-w-7xl mx-auto" id="campus-container" data-campus-slug={campus} data-tckt-virtual={empresa.tckt_virtual ? "true" : "false"} data-has-admin-superadmin={hasAdminOrSuperadmin ? "true" : "false"}>
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">{title}</h1>
    </div>

    <!-- Tarjeta de Configuración de Empresa -->
    <div class="bg-card border rounded-lg p-6 mb-6">
      <h2 class="text-lg font-semibold mb-2 flex items-center gap-2">
        <svg class="h-5 w-5 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Configuración de Campus
      </h2>
      <div class="flex items-center justify-between gap-4 flex-wrap">
        <div>
          <p class="text-sm font-medium text-foreground">Permitir Campus Virtual como origen</p>
          <p class="text-xs text-muted-foreground">Los usuarios de esta empresa podrán seleccionar "Virtual" como campus origen en solicitudes de traslado.</p>
        </div>
        <div class="flex items-center">
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="toggle-tckt-virtual" class="sr-only peer" checked={empresa.tckt_virtual}>
            <div class="w-11 h-6 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
            <span id="tckt-virtual-label" class="ml-2 text-sm font-semibold text-foreground">{empresa.tckt_virtual ? 'Activado' : 'Desactivado'}</span>
          </label>
        </div>
      </div>

    </div>

    <div class="flex justify-between items-center mb-4 gap-4 flex-wrap">
      <a
        href="/admin/usuarios"
        class="bg-muted-foreground text-white hover:bg-muted-foreground/80 px-6 py-2 rounded-md text-sm font-semibold transition-colors"
      >
        Volver a la lista
      </a>
      <div class="flex items-center gap-4 flex-wrap">
        <div>
          <label for="status-select" class="mr-2 text-sm font-medium"
            >Estado:</label
          >
          <select
            id="status-select"
            class="bg-card border rounded-md p-2 text-sm"
          >
            <option value="active">Activos</option>
            <option value="inactive">Inactivos</option>
            <option value="all">Todos</option>
          </select>
        </div>
        <div id="vacation-select-container" class={hasAdminOrSuperadmin ? "" : "hidden"}>
          <label for="vacation-select" class="mr-2 text-sm font-medium"
            >Asig. Tickets:</label
          >
          <select
            id="vacation-select"
            class="bg-card border rounded-md p-2 text-sm"
          >
            <option value="all">Todos</option>
            <option value="on">Sí</option>
            <option value="off">No</option>
          </select>
        </div>
        <div>
          <label for="limit-select" class="mr-2 text-sm font-medium"
            >Por página:</label
          >
          <select
            id="limit-select"
            class="bg-card border rounded-md p-2 text-sm"
          >
            <option value="10">10</option>
            <option value="5">5</option>
            <option value="15">15</option>
            <option value="20">20</option>
            <option value="all">Todos</option>
          </select>
        </div>
      </div>
    </div>

    <div class="bg-card border rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-muted/50">
            <tr>
              <th class="p-4">Nombre</th>
              <th class="p-4">Estado</th>
              <th class="p-4">Levanta CSH</th>
              <th class="p-4">Levanta Mkt</th>
              <th id="th-asig-tickets" class={`p-4 ${hasAdminOrSuperadmin ? "" : "hidden"}`}>Asig. Tickets</th>
            </tr>
          </thead>
          <tbody id="users-table-body"></tbody>
        </table>
      </div>
      <div
        id="no-users-message"
        class="hidden p-8 text-center text-muted-foreground"
      >
        No se encontraron usuarios con los filtros seleccionados.
      </div>
    </div>

    <div class="flex justify-between items-center mt-4">
      <span id="pagination-info" class="text-sm text-muted-foreground"></span>
      <div id="pagination-controls" class="flex gap-2"></div>
    </div>
  </div>
</MainLayout>

<script>
  import { navigate } from 'astro:transitions/client';
  import { toast } from '@/lib/toast';

  function initUserList() {
    const container = document.getElementById("campus-container");
    if (!container) return;
    const campusSlug = container.dataset.campusSlug;

    // Toggles de la Empresa
    const setupCompanyToggle = (elementId: string, labelId: string, payloadKey: string) => {
      const toggle = document.getElementById(elementId) as HTMLInputElement | null;
      const label = document.getElementById(labelId);
      if (toggle && label) {
        toggle.addEventListener("change", async () => {
          const newValue = toggle.checked;
          label.textContent = newValue ? 'Activado' : 'Desactivado';
          
          try {
            const response = await fetch('/api/admin/empresa', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug: campusSlug, [payloadKey]: newValue })
            });
            
            if (!response.ok) {
              const errorData = await response.json();
              throw new Error(errorData.message || 'Error al actualizar');
            }
            
            // Actualizar el data-attribute del contenedor para que sobreviva recargas
            if (payloadKey === 'tckt_virtual' && container) {
              container.dataset.tcktVirtual = newValue ? 'true' : 'false';
            }
            
            toast.success(`Configuración de campus actualizada.`);
          } catch (error: any) {
            console.error(`Error al actualizar campus (${payloadKey}):`, error);
            toggle.checked = !newValue;
            label.textContent = !newValue ? 'Activado' : 'Desactivado';
            toast.error(error.message || 'Error al actualizar configuración.');
          }
        });
      }
    };

    // Sincronizar el estado del checkbox de tckt_virtual desde el data-attribute
    // (necesario para que sobreviva a las View Transitions de Astro)
    const tcktVirtualToggle = document.getElementById("toggle-tckt-virtual") as HTMLInputElement | null;
    const tcktVirtualInitialValue = container.dataset.tcktVirtual === "true";
    if (tcktVirtualToggle) {
      tcktVirtualToggle.checked = tcktVirtualInitialValue;
      const tcktVirtualLabel = document.getElementById("tckt-virtual-label");
      if (tcktVirtualLabel) tcktVirtualLabel.textContent = tcktVirtualInitialValue ? 'Activado' : 'Desactivado';
    }

    setupCompanyToggle("toggle-tckt-virtual", "tckt-virtual-label", "tckt_virtual");

    const tableBody = document.getElementById("users-table-body") as HTMLTableSectionElement | null;
    const noUsersMessage = document.getElementById("no-users-message");
    const paginationInfo = document.getElementById("pagination-info");
    const paginationControls = document.getElementById("pagination-controls");
    const limitSelect = document.getElementById("limit-select") as HTMLSelectElement;
    const statusSelect = document.getElementById("status-select") as HTMLSelectElement;
    const vacationSelect = document.getElementById("vacation-select") as HTMLSelectElement;

    if (!tableBody || !paginationControls || !limitSelect || !statusSelect || !vacationSelect) return;

    let currentPage = 1;
    let currentLimit = "10";
    let currentStatus = "active";
    let currentVacation = "all";

    async function fetchAndRenderUsers() {
      if (noUsersMessage) noUsersMessage.classList.add("hidden");
      tableBody!.classList.remove("hidden");
      tableBody!.innerHTML = `
        <tr>
          <td colspan="5" class="p-8 text-center text-muted-foreground">
            <div class="flex items-center justify-center gap-2">
              <svg class="animate-spin h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span>Cargando usuarios...</span>
            </div>
          </td>
        </tr>
      `;

      const url = `/api/admin/usuarios?campus=${campusSlug}&page=${currentPage}&limit=${currentLimit}&status=${currentStatus}&vacation=${currentVacation}`;
      try {
        const response = await fetch(url, { cache: "no-store" });
        if (!response.ok)
          throw new Error(`HTTP error! status: ${response.status}`);
        const { users, pagination, hasAdminOrSuperadmin: apiHasAdmin } = await response.json();

        // Determinar visibilidad de Asig. Tickets
        const showAsigTickets = apiHasAdmin !== undefined ? apiHasAdmin : (container?.dataset.hasAdminSuperadmin === "true");
        const thAsig = document.getElementById("th-asig-tickets");
        const vacationSelectContainer = document.getElementById("vacation-select-container");
        if (thAsig) {
          if (showAsigTickets) thAsig.classList.remove("hidden");
          else thAsig.classList.add("hidden");
        }
        if (vacationSelectContainer) {
          if (showAsigTickets) vacationSelectContainer.classList.remove("hidden");
          else vacationSelectContainer.classList.add("hidden");
        }

        tableBody!.innerHTML = "";
        if (users.length === 0) {
          if (noUsersMessage) noUsersMessage.classList.remove("hidden");
          tableBody!.classList.add("hidden");
        } else {
          if (noUsersMessage) noUsersMessage.classList.add("hidden");
          tableBody!.classList.remove("hidden");
          users.forEach((user: any) => {
            const row = document.createElement("tr");
            row.className =
              "border-b hover:bg-[#797979]/40 transition-colors cursor-pointer";
            
            // Render active toggle
            const isActivo = user.activo;
            const activoToggleHtml = `
              <div class="flex items-center" onclick="event.stopPropagation()">
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" class="sr-only peer toggle-activo" data-user-id="${user.id}" ${isActivo ? 'checked' : ''}>
                  <div class="w-9 h-5 bg-muted-foreground peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                  <span class="ml-2 text-xs font-semibold activo-label ${isActivo ? 'text-foreground' : 'text-secondary'}">${isActivo ? 'Activo' : 'Inactivo'}</span>
                </label>
              </div>
            `;

            // Render Levanta CSH toggle
            const isTcktCsh = user.tckt_csh;
            const tcktCshToggleHtml = `
              <div class="flex items-center" onclick="event.stopPropagation()">
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" class="sr-only peer toggle-tckt-csh" data-user-id="${user.id}" ${isTcktCsh ? 'checked' : ''}>
                  <div class="w-9 h-5 bg-muted-foreground peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                  <span class="ml-2 text-xs font-semibold tckt-csh-label ${isTcktCsh ? 'text-foreground' : 'text-secondary'}">${isTcktCsh ? 'Sí' : 'No'}</span>
                </label>
              </div>
            `;

            // Render Levanta Mkt toggle
            const isTcktMkt = user.tckt_mkt;
            const tcktMktToggleHtml = `
              <div class="flex items-center" onclick="event.stopPropagation()">
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" class="sr-only peer toggle-tckt-mkt" data-user-id="${user.id}" ${isTcktMkt ? 'checked' : ''}>
                  <div class="w-9 h-5 bg-muted-foreground peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                  <span class="ml-2 text-xs font-semibold tckt-mkt-label ${isTcktMkt ? 'text-foreground' : 'text-secondary'}">${isTcktMkt ? 'Sí' : 'No'}</span>
                </label>
              </div>
            `;

            // Render assign-tickets toggle
            const aceptaTickets = user.acepta_tickets;
            const vacacionesToggleHtml = `
              <div class="flex items-center" onclick="event.stopPropagation()">
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" class="sr-only peer toggle-vacaciones" data-user-id="${user.id}" ${aceptaTickets ? 'checked' : ''}>
                  <div class="w-9 h-5 bg-muted-foreground peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-secondary"></div>
                  <span class="ml-2 text-xs font-semibold vacaciones-label ${aceptaTickets ? 'text-secondary' : 'text-foreground'}">${aceptaTickets ? 'Sí' : 'No'}</span>
                </label>
              </div>
            `;

            row.onclick = (e) => {
              const target = e.target as HTMLElement;
              if (target.closest('input, label, button, a')) return;
              navigate(`/admin/usuarios/editar/${user.id}`);
            };

            row.innerHTML = `
              <td class="p-4 font-medium text-foreground">${user.nombres} ${user.apellidos}</td>
              <td class="p-4">${activoToggleHtml}</td>
              <td class="p-4">${tcktCshToggleHtml}</td>
              <td class="p-4">${tcktMktToggleHtml}</td>
              ${showAsigTickets ? `<td class="p-4">${vacacionesToggleHtml}</td>` : ''}
            `;
            tableBody!.appendChild(row);
          });

          // Attach event listeners to the new toggles
          attachToggleListeners();
        }
        renderPagination(pagination);
      } catch (error) {
        console.error("Fetch Error:", error);
        if (tableBody) {
          tableBody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-destructive">Error al cargar los usuarios.</td></tr>`;
        }
      }
    }

    function attachToggleListeners() {
      // Activo Toggles
      document.querySelectorAll('.toggle-activo').forEach(toggle => {
        toggle.addEventListener('change', async (e) => {
          const checkbox = e.target as HTMLInputElement;
          const userId = checkbox.dataset.userId;
          if (!userId) return;
          const newValue = checkbox.checked;
          const label = (checkbox.nextElementSibling?.nextElementSibling ?? null) as HTMLElement | null;

          // Optimistic UI update
          if (label) {
            label.textContent = newValue ? 'Activo' : 'Inactivo';
            label.className = newValue 
              ? 'ml-2 text-xs font-semibold activo-label text-foreground'
              : 'ml-2 text-xs font-semibold activo-label text-secondary';
          }

          try {
            const response = await fetch('/api/admin/usuarios', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: parseInt(userId, 10), activo: newValue })
            });

            if (!response.ok) {
              const errorData = await response.json();
              throw new Error(errorData.message || 'Error al actualizar');
            }
            
            toast.success(`Estado actualizado correctamente.`);
            if (!newValue) {
              fetchAndRenderUsers();
            }
          } catch (error: any) {
            console.error('Error updating user status:', error);
            // Revert UI
            checkbox.checked = !newValue;
            if (label) {
              label.textContent = !newValue ? 'Activo' : 'Inactivo';
              label.className = !newValue 
                ? 'ml-2 text-xs font-semibold activo-label text-foreground'
                : 'ml-2 text-xs font-semibold activo-label text-secondary';
            }
            toast.error(error.message || 'Error al actualizar el estado.');
          }
        });
      });

      // Levanta CSH Toggles
      document.querySelectorAll('.toggle-tckt-csh').forEach(toggle => {
        toggle.addEventListener('change', async (e) => {
          const checkbox = e.target as HTMLInputElement;
          const userId = checkbox.dataset.userId;
          if (!userId) return;
          const newValue = checkbox.checked;
          const label = (checkbox.nextElementSibling?.nextElementSibling ?? null) as HTMLElement | null;

          if (label) {
            label.textContent = newValue ? 'Sí' : 'No';
            label.className = newValue 
              ? 'ml-2 text-xs font-semibold tckt-csh-label text-foreground'
              : 'ml-2 text-xs font-semibold tckt-csh-label text-secondary';
          }

          try {
            const response = await fetch('/api/admin/usuarios', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: parseInt(userId, 10), tckt_csh: newValue })
            });

            if (!response.ok) {
              const errorData = await response.json();
              throw new Error(errorData.message || 'Error al actualizar');
            }
            
            toast.success(`Permiso Levanta CSH actualizado.`);
          } catch (error: any) {
            console.error('Error updating Levanta CSH status:', error);
            checkbox.checked = !newValue;
            if (label) {
              label.textContent = !newValue ? 'Sí' : 'No';
              label.className = !newValue 
                ? 'ml-2 text-xs font-semibold tckt-csh-label text-foreground'
                : 'ml-2 text-xs font-semibold tckt-csh-label text-secondary';
            }
            toast.error(error.message || 'Error al actualizar permiso.');
          }
        });
      });

      // Levanta Mkt Toggles
      document.querySelectorAll('.toggle-tckt-mkt').forEach(toggle => {
        toggle.addEventListener('change', async (e) => {
          const checkbox = e.target as HTMLInputElement;
          const userId = checkbox.dataset.userId;
          if (!userId) return;
          const newValue = checkbox.checked;
          const label = (checkbox.nextElementSibling?.nextElementSibling ?? null) as HTMLElement | null;

          if (label) {
            label.textContent = newValue ? 'Sí' : 'No';
            label.className = newValue 
              ? 'ml-2 text-xs font-semibold tckt-mkt-label text-foreground'
              : 'ml-2 text-xs font-semibold tckt-mkt-label text-secondary';
          }

          try {
            const response = await fetch('/api/admin/usuarios', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: parseInt(userId, 10), tckt_mkt: newValue })
            });

            if (!response.ok) {
              const errorData = await response.json();
              throw new Error(errorData.message || 'Error al actualizar');
            }
            
            toast.success(`Permiso Levanta Mkt actualizado.`);
          } catch (error: any) {
            console.error('Error updating Levanta Mkt status:', error);
            checkbox.checked = !newValue;
            if (label) {
              label.textContent = !newValue ? 'Sí' : 'No';
              label.className = !newValue 
                ? 'ml-2 text-xs font-semibold tckt-mkt-label text-foreground'
                : 'ml-2 text-xs font-semibold tckt-mkt-label text-secondary';
            }
            toast.error(error.message || 'Error al actualizar permiso.');
          }
        });
      });

      // Vacaciones Toggles
      document.querySelectorAll('.toggle-vacaciones').forEach(toggle => {
        toggle.addEventListener('change', async (e) => {
          const checkbox = e.target as HTMLInputElement;
          const userId = checkbox.dataset.userId;
          if (!userId) return;
          const newValue = checkbox.checked;
          const label = (checkbox.nextElementSibling?.nextElementSibling ?? null) as HTMLElement | null;

          // Optimistic UI update
          if (label) {
            label.textContent = newValue ? 'Sí' : 'No';
            label.className = newValue 
              ? 'ml-2 text-xs font-semibold vacaciones-label text-secondary'
              : 'ml-2 text-xs font-semibold vacaciones-label text-foreground';
          }

          try {
            const response = await fetch('/api/admin/usuarios', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: parseInt(userId, 10), acepta_tickets: newValue })
            });

            if (!response.ok) {
              const errorData = await response.json();
              throw new Error(errorData.message || 'Error al actualizar');
            }

            toast.success(`Estado de asignación actualizado.`);
          } catch (error: any) {
            console.error('Error updating user vacation status:', error);
            // Revert UI
            checkbox.checked = !newValue;
            if (label) {
              label.textContent = !newValue ? 'Sí' : 'No';
              label.className = !newValue 
                ? 'ml-2 text-xs font-semibold vacaciones-label text-secondary'
                : 'ml-2 text-xs font-semibold vacaciones-label text-foreground';
            }
            toast.error(error.message || 'Error al actualizar asignación.');
          }
        });
      });
    }

    function renderPagination(pagination: any) {
      if (!paginationInfo || !paginationControls) return;
      const { page, totalUsers, totalPages } = pagination;
      paginationInfo.textContent = `Mostrando ${tableBody!.rows.length} de ${totalUsers} usuarios`;
      paginationControls.innerHTML = "";
      if (totalPages <= 1) return;

      const prevButton = document.createElement("button");
      prevButton.textContent = "Anterior";
      prevButton.disabled = page === 1;
      prevButton.className =
        "px-4 py-2 text-sm border rounded-md disabled:opacity-50";
      prevButton.addEventListener("click", () => {
        currentPage--;
        fetchAndRenderUsers();
      });
      paginationControls.appendChild(prevButton);

      const nextButton = document.createElement("button");
      nextButton.textContent = "Siguiente";
      nextButton.disabled = page === totalPages;
      nextButton.className =
        "px-4 py-2 text-sm border rounded-md disabled:opacity-50";
      nextButton.addEventListener("click", () => {
        currentPage++;
        fetchAndRenderUsers();
      });
      paginationControls.appendChild(nextButton);
    }

    limitSelect.addEventListener("change", () => {
      currentLimit = limitSelect.value;
      currentPage = 1;
      fetchAndRenderUsers();
    });
    statusSelect.addEventListener("change", () => {
      currentStatus = statusSelect.value;
      currentPage = 1;
      fetchAndRenderUsers();
    });
    vacationSelect.addEventListener("change", () => {
      currentVacation = vacationSelect.value;
      currentPage = 1;
      fetchAndRenderUsers();
    });

    fetchAndRenderUsers();
  }

  document.addEventListener("astro:page-load", initUserList);
</script>

