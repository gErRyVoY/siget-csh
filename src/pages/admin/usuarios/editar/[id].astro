import MainLayout from "@/layouts/MainLayout.astro";
import { prisma } from "@/lib/db";
import { consultarHorarioRH, horarioParaPrisma, tieneHorarioUtil } from "@/lib/rh-horario";
import { isTestUserEmail } from "@/config/test-users";
import type { Usuario, Empresa, Rol } from "@prisma/client";
import UserSubcategoryItem from "./UserSubcategoryItem.astro";

const { id } = Astro.params;
const session = Astro.locals.session;

const user = await prisma.usuario.findUnique({
  where: { id: parseInt(id as string, 10) },
  include: {
    empresa: true,
    rol: { include: { permisos_seccion: true, permisos_categoria: true } },
    permisos_seccion: true,
    asignaciones_categorias: true,
  },
});

const [empresas, roles, secciones, categories, subcategories, subcatRelations] = await Promise.all([
  prisma.empresa.findMany({ orderBy: { nombre: "asc" } }),
  prisma.rol.findMany({ orderBy: { rol: "asc" } }),
  prisma.seccion.findMany({ orderBy: [{ grupo: "asc" }, { nombre: "asc" }] }),
  prisma.categoria.findMany({ where: { activo: true }, orderBy: { nombre: "asc" } }),
  prisma.subcategoria.findMany({ where: { activo: true }, orderBy: { nombre: "asc" } }),
  prisma.subcategoriaCategorias.findMany({ where: { activo: true } }),
]);

if (!user) {
  return Astro.redirect("/404");
}

// El horario lo sincroniza el login contra la API de RH, pero quien no haya
// vuelto a entrar puede tenerlo vacío, así que la ficha también lo refresca al
// abrirse. La guarda usa `tieneHorarioUtil` y no `!user.horario_disponibilidad`
// porque un objeto con los seis días a `null` es *truthy*: con la comprobación
// anterior esas filas nunca se volvían a consultar (ver src/lib/rh-horario.ts).
// Las cuentas de prueba y de servicio se omiten igual que en el login: RH no las
// conoce, así que su horario se queda en NULL («No disponible») y consultarla
// solo gastaría una petición en cada carga de la ficha.
if (user.clave && !isTestUserEmail(user.mail) && !tieneHorarioUtil(user.horario_disponibilidad)) {
  const resultado = await consultarHorarioRH(user.clave);

  if (resultado.estado === 'ok' || resultado.estado === 'sin-horario') {
    const nuevoHorario = resultado.estado === 'ok' ? resultado.horario : null;

    // Si RH no tiene horario y la columna ya está en NULL, no hay nada que escribir.
    if (nuevoHorario !== null || user.horario_disponibilidad !== null) {
      await prisma.usuario.update({
        where: { id: user.id },
        data: { horario_disponibilidad: horarioParaPrisma(nuevoHorario) },
      });
      user.horario_disponibilidad = nuevoHorario as any;
    }
  } else {
    console.warn(`No se pudo consultar el horario de ${user.clave}: ${resultado.motivo}`);
  }
}

/* --- PERMISSIONS LOGIC --- */
const FULL_EDIT_ROLES = [
  "Director CSH",
  "Ingeniero soporte 3",
  "Desarrollador",
  "Superadmin",
];
const RESTRICTED_EDIT_ROLES = [
  "Ingeniero soporte 1",
  "Ingeniero soporte 2",
  "Auditor CSH",
  "Ingeniero Hubspot",
];
const MARKETING_TEAM_ROLES = [
  "Director Marketing",
  "Diseñador",
  "Community manager",
  "Editor",
];

const currentUserRole = session?.user?.rol?.rol || "";
const currentUserRoleId = session?.user?.rol?.id ?? 0;
const isSuperAdmin = currentUserRoleId === 3 || (session?.user?.rol as any)?.administrador === true || currentUserRole === "Superadmin";

// Check capabilities
const isFullEditor = FULL_EDIT_ROLES.includes(currentUserRole) || isSuperAdmin;
const isRestrictedEditor = RESTRICTED_EDIT_ROLES.includes(currentUserRole);

// Special Marketing Logic
const isMarketingDirector = currentUserRole === "Director Marketing";
const isMarketingTeamMember = MARKETING_TEAM_ROLES.includes(currentUserRole) && !isSuperAdmin;

// Target User Properties
const targetUserNivelSoporte = user.rol?.nivel_soporte;
const targetIsMarketing = targetUserNivelSoporte === "Marketing";

// Can Edit?
const canFullEdit = isFullEditor;
const canRestrictedEdit = isRestrictedEditor;
const canMarketingEdit = isMarketingDirector && targetIsMarketing;

const canEdit = canFullEdit || canRestrictedEdit || canMarketingEdit;

// Field Restrictions
const isEmpresaReadOnly = !canFullEdit; // Superadmins and Full Editors can change Empresa
const isRoleSelectFiltered = isMarketingTeamMember;
const areAuditorChecksHidden = isMarketingTeamMember;

/* -------------------------- */

const concatenatedName = `${user.nombres} ${user.apellidos}`;

const formattedLastLogin = new Date(user.ultimo_login).toLocaleString("es-MX", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "numeric",
  minute: "numeric",
  second: "numeric",
  hour12: true,
});

const groupedEmpresas: { [key: string]: Empresa[] } = {
  Oficina: [],
  Social: [],
  Campus: [],
};
empresas.forEach((empresa) => {
  if (empresa.tipo === "Oficina") groupedEmpresas["Oficina"].push(empresa);
  else if (empresa.tipo === "Social") groupedEmpresas["Social"].push(empresa);
  else groupedEmpresas["Campus"].push(empresa);
});
const groupOrder = ["Oficina", "Social", "Campus"];

// Filter Roles for Marketing Team and strip Inactive roles
const displayedRoles = isRoleSelectFiltered
  ? roles.filter((r) => MARKETING_TEAM_ROLES.includes(r.rol) && (r.activo || r.id === user.rolId))
  : roles.filter((r) => r.activo || r.id === user.rolId);

// Safely stringify the schedule for the client-side script
const horarioString = JSON.stringify(user.horario_disponibilidad);

// Permisos (Secciones Híbridas)
const userRoleSections =
  user.rol?.permisos_seccion
    .filter((ps) => ps.activo)
    .map((ps) => ps.seccionId) || [];
const explicitPermissions = user.permisos_seccion.reduce(
  (acc, ps) => {
    acc[ps.seccionId] = ps.activo;
    return acc;
  },
  {} as Record<number, boolean>,
);

// Permisos Híbridos (Categorías) por Asignación Explícita
// Permisos de Categorías por Asignación Explícita Individual
const assignedUserCategories: Record<string, boolean> = {};
user.asignaciones_categorias?.forEach((ac) => {
  const catKey = ac.subcategoriaId ? `${ac.categoriaId}-${ac.subcategoriaId}` : `${ac.categoriaId}-null`;
  assignedUserCategories[catKey] = ac.activo;
});

// Agrupar secciones para UI
const orderGrupos = [
  "Abrir ticket",
  "Tickets soporte",
  "Tickets marketing",
  "Generales",
  "Administrador",
];
const groupedSecciones: { [key: string]: { [key: string]: typeof secciones } } =
  {};

secciones.forEach((sec) => {
  let group = sec.grupo || "Generales";
  if (group === "Otros") group = "Generales";
  const subgroup = sec.subgrupo || "General";
  if (!groupedSecciones[group]) groupedSecciones[group] = {};
  if (!groupedSecciones[group][subgroup])
    groupedSecciones[group][subgroup] = [];
  groupedSecciones[group][subgroup].push(sec);
});

if (groupedSecciones["Generales"]) {
  Object.keys(groupedSecciones["Generales"]).forEach((subgroupName) => {
    groupedSecciones["Generales"][subgroupName].sort((a, b) => {
      if (a.identificador === "feature_dark_mode") return -1;
      if (b.identificador === "feature_dark_mode") return 1;
      return a.nombre.localeCompare(b.nombre);
    });
  });
}

// --- VISIBILIDAD & PERMISOS POR ROL OBJETIVO ---
const targetRoleId = user.rolId; // 1 = Usuario, 2 = Admin, 3 = Superadmin
const currentUserId = session?.user?.id ? parseInt(String(session.user.id), 10) : -1;
const isTargetSelfSuperAdmin = isSuperAdmin && currentUserId === user.id;

// Qué roles habilitan cada bloque configurable.
//
// Antes cada bloque se resolvía sólo aquí, contra el rol GUARDADO: para
// configurar los permisos de un rol nuevo había que cambiarlo, guardar, esperar
// la recarga y volver a entrar. Ahora se pinta la UNIÓN de los bloques y cada
// uno declara sus roles en `data-roles`; el servidor sólo fija el estado
// inicial en `data-rol-hidden` (para que no haya salto al cargar) y el <select>
// de Rol lo recalcula al vuelo en el cliente, en `applyRoleVisibility` de
// src/scripts/user-edit-form-logic.ts.
//
// Ojo: los filtros que dependen de QUIÉN edita —`isTargetSelfSuperAdmin`,
// `areAuditorChecksHidden`, `canEdit`— siguen decidiéndose aquí, porque mover el
// <select> de Rol no los cambia.
const ROLES_TODOS = [1, 2, 3];
const ROLES_HORARIO = [2]; // Admin: sólo de consulta
const ROLES_SECCIONES = [1, 2];
const ROLES_CATEGORIAS = [2, 3]; // Oculto para Usuario (1)
const ROLES_ASIGNAR = [2, 3];
const ROLES_LEVANTA = [1, 2];
const ROLES_ATIENDE = [2, 3];
const ROLES_AUDITOR = [2, 3];
// Las vistas «Todos» de soporte y marketing no aplican al rol Usuario.
const ROLES_SECCION_TODOS = [2, 3];
const SECCIONES_SOLO_PRIVILEGIADAS = ["soporte_todos", "marketing_todos"];

const rolesAttr = (roles: number[]) => roles.join(",");
const rolOculto = (roles: number[]) => (roles.includes(targetRoleId) ? "false" : "true");

// El horario nunca se edita desde aquí: lo sincroniza la API de RH al iniciar
// sesión. Sólo se muestra al rol Admin (ver ROLES_HORARIO).
const isHorarioReadOnly = true;

// Los toggles de Categorías SIEMPRE son editables para Admin/Superadmin (no depende de self-edit)
const canEditCategorias = canEdit && (currentUserRoleId === 2 || currentUserRoleId === 3);

// Visibilidad independiente del rol objetivo
const showToggleActivo = !isTargetSelfSuperAdmin;
const showHorarioSection = !isTargetSelfSuperAdmin;
const showSeccionesSection = !isTargetSelfSuperAdmin;

// Estructura recursiva para subcategorías en árbol (soporta N niveles)
interface UserSubcatTreeNode {
    id: number;
    nombre: string;
    parent_subcategoriaId: number | null;
    children: UserSubcatTreeNode[];
}

function buildUserSubcategoryTree(
    parentSubId: number | null, 
    catId: number, 
    allSubs: typeof subcategories, 
    relations: typeof subcatRelations
): UserSubcatTreeNode[] {
    const levelSubs = allSubs.filter(sub => {
        if (parentSubId === null) {
            const isLinked = relations.some(r => r.categoriaId === catId && r.subcategoriaId === sub.id);
            return isLinked && sub.parent_subcategoriaId === null;
        } else {
            return sub.parent_subcategoriaId === parentSubId;
        }
    });

    return levelSubs.map(sub => {
        const children = buildUserSubcategoryTree(sub.id, catId, allSubs, relations);
        return {
            id: sub.id,
            nombre: sub.nombre,
            parent_subcategoriaId: sub.parent_subcategoriaId,
            children: children.sort((a, b) => a.nombre.localeCompare(b.nombre))
        };
    }).sort((a, b) => a.nombre.localeCompare(b.nombre));
}

interface UserCatNode {
    id: number;
    nombre: string;
    subcategorias: UserSubcatTreeNode[];        // todas (para la sección "Sin acceso")
    enabledSubcategorias: UserSubcatTreeNode[]; // solo las activas (para la sección "Habilitadas")
    disabledSubcategorias: UserSubcatTreeNode[];// solo las inactivas
    isEnabled: boolean; // si al menos una subcategoría está activa (o la cat en sí)
}

function filterActiveSubtree(
    node: UserSubcatTreeNode,
    catId: number,
    assignedUserCategoriesMap: Record<string, boolean>
): UserSubcatTreeNode | null {
    const subKey = `${catId}-${node.id}`;
    const isActive = assignedUserCategoriesMap[subKey] === true;

    // Filtrar los hijos activos
    const activeChildren = node.children
        .map(c => filterActiveSubtree(c, catId, assignedUserCategoriesMap))
        .filter((c): c is UserSubcatTreeNode => c !== null);

    if (isActive || activeChildren.length > 0) {
        return { ...node, children: activeChildren };
    }
    return null;
}

function filterInactiveSubtree(
    node: UserSubcatTreeNode,
    catId: number,
    assignedUserCategoriesMap: Record<string, boolean>
): UserSubcatTreeNode | null {
    const subKey = `${catId}-${node.id}`;
    const isActive = assignedUserCategoriesMap[subKey] === true;

    // Filtrar los hijos inactivos
    const inactiveChildren = node.children
        .map(c => filterInactiveSubtree(c, catId, assignedUserCategoriesMap))
        .filter((c): c is UserSubcatTreeNode => c !== null);

    if (!isActive || inactiveChildren.length > 0) {
        return { ...node, children: inactiveChildren };
    }
    return null;
}

const habilitadasCats: UserCatNode[] = [];
const sinAccesoCats: UserCatNode[] = [];

categories.forEach((cat) => {
    const subTree = buildUserSubcategoryTree(null, cat.id, subcategories, subcatRelations);
    const catKey = `${cat.id}-null`;
    const isCheckedCat = assignedUserCategories[catKey] === true;

    const enabledSubcategorias = subTree
        .map(n => filterActiveSubtree(n, cat.id, assignedUserCategories))
        .filter((n): n is UserSubcatTreeNode => n !== null);

    const disabledSubcategorias = subTree
        .map(n => filterInactiveSubtree(n, cat.id, assignedUserCategories))
        .filter((n): n is UserSubcatTreeNode => n !== null);

    const hasActiveSub = enabledSubcategorias.length > 0;
    const isEnabled = subTree.length === 0 ? isCheckedCat : hasActiveSub;

    const catNode: UserCatNode = {
        id: cat.id,
        nombre: cat.nombre,
        subcategorias: subTree,
        enabledSubcategorias,
        disabledSubcategorias,
        isEnabled,
    };

    if (isEnabled) {
        habilitadasCats.push(catNode);
    } else {
        sinAccesoCats.push(catNode);
    }
});

habilitadasCats.sort((a, b) => a.nombre.localeCompare(b.nombre));
sinAccesoCats.sort((a, b) => a.nombre.localeCompare(b.nombre));
