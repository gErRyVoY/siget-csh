              if (obsComidaWrapper) {
                obsComidaWrapper.classList.remove("hidden");
              }
            } else {
              // Si es Omitir, ocultar ambos
              if (obsTurnoWrapper) {
                obsTurnoWrapper.classList.add("hidden");
              }
              if (obsComidaWrapper) {
                obsComidaWrapper.classList.add("hidden");
              }
