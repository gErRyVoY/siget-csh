              if (val === "Homeoffice" || val === "Vacaciones") {
                statusEl.classList.add("text-[#7c3aed]");
              } else if (val === "Inasistencia") {
                statusEl.classList.add("text-[#ca1c1c]");
              } else {
                // Evento / Asueto → gris
                statusEl.classList.add("text-[#6b7280]");
              }
