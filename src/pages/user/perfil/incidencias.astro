        // Attach event listeners for Edit buttons
        document.querySelectorAll(".btn-editar").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const b = e.target as HTMLButtonElement;
            const idx = b.dataset.index;

            const obsEl = document.getElementById(
              `obs-${idx}`,
            ) as HTMLTextAreaElement;
            const obsComidaEl = document.getElementById(
              `obs-comida-${idx}`,
            ) as HTMLTextAreaElement;

            if (obsEl) {
              obsEl.disabled = false;
              obsEl.classList.remove("opacity-60", "cursor-not-allowed");
            }
            if (obsComidaEl) {
              obsComidaEl.disabled = false;
              obsComidaEl.classList.remove("opacity-60", "cursor-not-allowed");
            }

            const toggle = document.getElementById(
              `toggle-${idx}`,
            ) as HTMLInputElement;
            if (toggle) {
              toggle.checked = true;
              toggle.dispatchEvent(new Event("change"));
            }

            b.style.display = "none";
          });
        });
      }
    }

    function setupFortnightFilters() {
      const allButtons = document.querySelectorAll(".btn-q-all, .btn-q-1, .btn-q-2");
      
      allButtons.forEach(btn => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const filterType = target.dataset.filter;
          currentFortnightFilter = filterType || "all";
          
          const rows = document.querySelectorAll(".incidencia-card-row");
          rows.forEach((row: any) => {
            const day = parseInt(row.dataset.day, 10);
            if (filterType === "all") {
              row.classList.remove("hidden");
            } else if (filterType === "1") {
              if (day <= 15) {
                row.classList.remove("hidden");
              } else {
                row.classList.add("hidden");
              }
            } else if (filterType === "2") {
              if (day >= 16) {
                row.classList.remove("hidden");
              } else {
                row.classList.add("hidden");
              }
            }
          });

          // Sync active styles across both top and bottom sets of buttons
          const sameFilterButtons = document.querySelectorAll(`[data-filter="${filterType}"]`);
          const otherFilterButtons = document.querySelectorAll(`[data-filter]:not([data-filter="${filterType}"])`);

          sameFilterButtons.forEach(b => {
            b.classList.remove("bg-muted", "text-muted-foreground", "hover:bg-muted/80");
            b.classList.add("bg-primary", "text-primary-foreground", "hover:bg-primary/90");
          });

          otherFilterButtons.forEach(b => {
            b.classList.remove("bg-primary", "text-primary-foreground", "hover:bg-primary/90");
            b.classList.add("bg-muted", "text-muted-foreground", "hover:bg-muted/80");
          });
        });
      });
    }

    // Modal Events and Functionality
    btnsEnviarReporte.forEach(btn => {
      btn.addEventListener("click", () => {
        if (!modal) return;

        // Calcular el texto del periodo activo
        const mesesNombres = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
        const activeMes = (document.getElementById("mes") as HTMLSelectElement).value;
        const activeAnio = (document.getElementById("anio") as HTMLSelectElement).value;
        const activeMesName = mesesNombres[parseInt(activeMes, 10) - 1];

        let periodStr = "";
        if (currentFortnightFilter === "1") {
          periodStr = `Quincena 1 (días 1 al 15) de ${activeMesName} de ${activeAnio}`;
        } else if (currentFortnightFilter === "2") {
          periodStr = `Quincena 2 (días 16 en adelante) de ${activeMesName} de ${activeAnio}`;
        } else {
          periodStr = `Mes completo (${activeMesName} de ${activeAnio})`;
        }

        if (modalPeriodText) {
          modalPeriodText.innerHTML = `Se enviará el reporte correspondiente a: <strong class="text-foreground">${periodStr}</strong>.`;
        }

        modal.classList.remove("hidden");
        modal.classList.add("flex");
      });
    });

    const closeModal = () => {
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    };

    modalClose?.addEventListener("click", closeModal);
    modalCancel?.addEventListener("click", closeModal);

    // Table Modal Events and Render Logic
    const closeTablaModal = () => {
      if (tablaModal) {
        tablaModal.classList.add("hidden");
        tablaModal.classList.remove("flex");
      }
    };

    tablaModalClose?.addEventListener("click", closeTablaModal);
    tablaModalCancel?.addEventListener("click", closeTablaModal);
    document.getElementById("tabla-modal-cancel")?.addEventListener("click", closeTablaModal);

    // Cierre al hacer clic fuera de la tabla
    tablaModal?.addEventListener("click", (e) => {
      if (e.target === tablaModal) {
        closeTablaModal();
      }
    });

    const closePreviewModal = () => {
      if (previewModal) {
        previewModal.classList.add("hidden");
        previewModal.classList.remove("flex");
      }
    };

    previewModalClose?.addEventListener("click", closePreviewModal);
    previewModalCancel?.addEventListener("click", closePreviewModal);

    previewModal?.addEventListener("click", (e) => {
      if (e.target === previewModal) {
        closePreviewModal();
      }
    });

    // Cierre de todos los modales al presionar la tecla Esc
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" || e.key === "Esc") {
        closeTablaModal();
        closeModal();
        closePreviewModal();
      }
    });

    // Cierre al hacer clic fuera del modal de Enviar Reporte
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    function getWeeksText(dates: Date[]): string {
      if (dates.length === 0) return "";
      const weeks = dates.map(d => {
        const date = new Date(d.getTime());
        date.setHours(0, 0, 0, 0);
        date.setDate(date.getDate() + 3 - (date.getDay() + 6) % 7);
        const week1 = new Date(date.getFullYear(), 0, 4);
        return 1 + Math.round(((date.getTime() - week1.getTime()) / 86400000 - 3 + (week1.getDay() + 6) % 7) / 7);
      });
      const uniqueWeeks = Array.from(new Set(weeks)).sort((a: number, b: number) => a - b);
      if (uniqueWeeks.length === 1) {
        return `Semana #${uniqueWeeks[0]}`;
      }
      return `Semana #${uniqueWeeks[0]} a #${uniqueWeeks[uniqueWeeks.length - 1]}`;
    }

    function generateEmailPreviewHtml() {
      const filtered = registrosAPI.filter((r) => {
        const d = new Date(r.fecha);
        const dayNum = d.getUTCDate();
        if (currentFortnightFilter === "1") return dayNum <= 15;
        if (currentFortnightFilter === "2") return dayNum >= 16;
        return true;
      });
      const sorted = [...filtered].sort((a, b) => new Date(a.fecha).getTime() - new Date(b.fecha).getTime());

      const activeMap = new Map();
      incidenciasToSave.forEach((inc) => {
        const toggle = document.getElementById(`toggle-${inc.index}`) as HTMLInputElement;
        const isOmitida = toggle ? !toggle.checked : false;

        const obsEl = document.getElementById(`obs-${inc.index}`) as HTMLTextAreaElement;
        const obsComidaEl = document.getElementById(`obs-comida-${inc.index}`) as HTMLTextAreaElement;

        // Leer el select de tipo de inasistencia
        const selEl = document.getElementById(`tipo-inasistencia-${inc.index}`) as HTMLSelectElement;
        const specialLabel = selEl ? selEl.value : null;
        // Solo aplica como specialLabel si NO es Inasistencia
        const resolvedSpecial = (specialLabel && specialLabel !== "Inasistencia") ? specialLabel : null;

        const isAllNull = !inc.entrada_turno && !inc.salida_turno && !inc.entrada_comida && !inc.salida_comida;
        // Si hay select de tipo, el valor del turno es el specialLabel
        let valTurno = resolvedSpecial || (obsEl ? obsEl.value.trim() : "");
        let valComida = obsComidaEl ? obsComidaEl.value.trim() : "";

        const dateObj = new Date(inc.fecha);
        const dayNum = dateObj.getUTCDate();
        let inPeriod = true;
        if (currentFortnightFilter === "1" && dayNum > 15) inPeriod = false;
        if (currentFortnightFilter === "2" && dayNum < 16) inPeriod = false;

        if (inPeriod) {
          activeMap.set(new Date(inc.fecha).toISOString().split("T")[0], {
            ...inc,
            observaciones: valTurno || null,
            observaciones_comida: valComida || null,
            omitida: isOmitida,
            specialLabel: resolvedSpecial
          });
        }
      });


      const CELL_W = "85px";
      const CELL_H = "90px";
      const colorMap = {
        ok: "#d1fae5",
        tarde: "#fee2e2",
        orange: "#ffedd5",
        inasist: "#f3f4f6",
        especial: "#ede9fe"   // morado claro para Homeoffice / Vacaciones
      };

      const headerRow = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"]
        .map(d => `<th style="width:${CELL_W};padding:6px 4px;background-color:#881912;color:#fff;font-family:'Segoe UI',sans-serif;font-size:11px;font-weight:700;text-align:center;border:1px solid #6b1010;">${d}</th>`)
        .join("");

      if (sorted.length === 0) return "<p class='text-center text-muted-foreground py-8'>No hay registros disponibles.</p>";

      const firstDay = sorted[0].fecha;
      const firstDayNum = new Date(firstDay).getUTCDay();
      const emptyCellsCount = firstDayNum === 0 ? 0 : firstDayNum - 1;

      const cells = [];
      for (let i = 0; i < emptyCellsCount; i++) {
        cells.push(`<td style="width:${CELL_W};height:${CELL_H};border:1px solid #e5e7eb;background-color:#f9fafb;"></td>`);
      }

      const formatT = (t: string | null | undefined): string => {
        if (!t) return "";
        if (t.length === 4) return `${t.substring(0, 2)}:${t.substring(2, 4)}`;
        return t;
      };

      sorted.forEach((inc) => {
        const date = new Date(inc.fecha);
        const utcDay = date.getUTCDay();
        if (utcDay === 0) return;

        const capitalizedName = diasSemana[utcDay].charAt(0).toUpperCase() + diasSemana[utcDay].slice(1);
        const dayNameNormalized = capitalizedName.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
        const hDia = horario[dayNameNormalized];
        const dayNum = date.getUTCDate().toString().padStart(2, "0");

        const dateStr = date.toISOString().split("T")[0];
        const activeInc = activeMap.get(dateStr);
        const isOmitida = activeInc ? activeInc.omitida : false;
        const specialLabel = activeInc ? activeInc.specialLabel : null;

        const rEnt = parseTime(inc.entrada_turno);
        const rSal = parseTime(inc.salida_turno);
        const hIni = hDia ? parseHorarioTime(hDia.inicio) : null;
        const hFin = hDia ? parseHorarioTime(hDia.fin) : null;

        const isAllNull = !inc.entrada_turno && !inc.salida_turno && !inc.entrada_comida && !inc.salida_comida;

        let bgColor = colorMap.ok;
        let statusLines = [];

        if (isOmitida) {
          bgColor = colorMap.ok;
          if (inc.entrada_turno) {
            statusLines.push(`<span style="color:#16a34a;font-weight:700;font-size:10px;">EL ${formatT(inc.entrada_turno)}</span>`);
          }
          if (inc.entrada_comida) {
            statusLines.push(`<span style="color:#6b7280;font-size:9px;">SC ${formatT(inc.entrada_comida)}</span>`);
          }
          if (inc.salida_comida) {
            statusLines.push(`<span style="color:#6b7280;font-size:9px;">RC ${formatT(inc.salida_comida)}</span>`);
          }
          if (inc.salida_turno) {
            statusLines.push(`<span style="color:#16a34a;font-weight:700;font-size:10px;">SL ${formatT(inc.salida_turno)}</span>`);
          }
        } else if (specialLabel) {
          // Homeoffice / Vacaciones → morado; Evento / Asueto → gris
          if (specialLabel === "Homeoffice" || specialLabel === "Vacaciones") {
            bgColor = colorMap.especial;
            statusLines.push(`<span style="color:#7c3aed;font-size:10px;font-weight:700;">${specialLabel}</span>`);
          } else {
            bgColor = colorMap.inasist;
            statusLines.push(`<span style="color:#6b7280;font-size:10px;font-weight:700;">${specialLabel}</span>`);
          }
        } else if (isAllNull) {
          bgColor = colorMap.inasist;
          statusLines.push(`<span style="color:#6b7280;font-size:10px;font-weight:600;">Inasistencia</span>`);
        } else {
          if (inc.entrada_turno) {
            let elColor = "#374151";
            let elBg = bgColor;
            if (rEnt && hIni) {
              const diffEnt = timeDiffMins(rEnt, hIni);
              if (diffEnt < 0) {
                elColor = "#16a34a";
              } else if (diffEnt > 15) {
                elColor = "#dc2626";
                elBg = colorMap.tarde;
              } else if (diffEnt >= 6) {
                elColor = "#ea580c";
                elBg = colorMap.orange;
              }
              if (elBg !== bgColor) bgColor = elBg;
            }
            statusLines.push(`<span style="color:${elColor};font-weight:700;font-size:10px;">EL ${formatT(inc.entrada_turno)}</span>`);
          } else {
            statusLines.push(`<span style="color:#dc2626;font-size:9px;font-weight:700;">EL (-:--)</span>`);
            bgColor = colorMap.tarde;
          }

          if (inc.entrada_comida) {
            statusLines.push(`<span style="color:#6b7280;font-size:9px;">SC ${formatT(inc.entrada_comida)}</span>`);
          }
          if (inc.salida_comida) {
            statusLines.push(`<span style="color:#6b7280;font-size:9px;">RC ${formatT(inc.salida_comida)}</span>`);
          }

          if (inc.salida_turno) {
            let slColor = "#374151";
            if (rSal && hFin) {
              const diffSal = timeDiffMins(rSal, hFin);
              if (diffSal > 5) slColor = "#16a34a";
            }
            statusLines.push(`<span style="color:${slColor};font-weight:700;font-size:10px;">SL ${formatT(inc.salida_turno)}</span>`);
          } else {
            statusLines.push(`<span style="color:#dc2626;font-size:9px;font-weight:700;">SL (-:--)</span>`);
            bgColor = colorMap.tarde;
          }
        }

        const watermarkNum = `<span style="position:absolute;top:2px;right:4px;font-size:22px;font-weight:900;color:rgba(0,0,0,0.18);line-height:1;pointer-events:none;">${dayNum}</span>`;
        const innerContent = statusLines.map(s => `<div style="line-height:1.3;">${s}</div>`).join("");

        cells.push(
          `<td style="position:relative;width:${CELL_W};height:${CELL_H};background-color:${bgColor};border:1px solid #d1d5db;padding:4px 5px;vertical-align:top;">` +
          watermarkNum +
          `<div style="margin-top:2px;">${innerContent}</div>` +
          `</td>`
        );
      });

      const rows = [];
      for (let i = 0; i < cells.length; i += 6) {
        const chunk = cells.slice(i, i + 6);
        while (chunk.length < 6) {
          chunk.push(`<td style="width:${CELL_W};height:${CELL_H};border:1px solid #e5e7eb;background-color:#f9fafb;"></td>`);
        }
        rows.push(`<tr>${chunk.join("")}</tr>`);
      }

      const calendarTable = `
        <table style="border-collapse:collapse;width:100%;table-layout:fixed;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;">
          <thead><tr>${headerRow}</tr></thead>
          <tbody>${rows.join("")}</tbody>
        </table>
      `;

      // Leyenda dinámica: solo mostrar los colores que se usen
      const usedOk = cells.some(c => c.includes(`background-color:${colorMap.ok}`));
      const usedTarde = cells.some(c => c.includes(`background-color:${colorMap.tarde}`));
      const usedOrange = cells.some(c => c.includes(`background-color:${colorMap.orange}`));
      const usedInasist = cells.some(c => c.includes(`background-color:${colorMap.inasist}`));
      const usedEspecial = cells.some(c => c.includes(`background-color:${colorMap.especial}`));

      // Para el texto de leyenda gris: distinguir qué etiquetas grises se usan
      const greyLabels: string[] = [];
      const specialLabelsUsed = new Set<string>();
      activeMap.forEach((v) => { if (v.specialLabel) specialLabelsUsed.add(v.specialLabel); });
      if (specialLabelsUsed.has("Inasistencia") || [...activeMap.values()].some(v => !v.specialLabel && !v.entrada_turno && !v.salida_turno && !v.entrada_comida && !v.salida_comida && !v.omitida)) greyLabels.push("Inasistencia");
      if (specialLabelsUsed.has("Evento")) greyLabels.push("Evento");
      if (specialLabelsUsed.has("Asueto")) greyLabels.push("Asueto");

      const purpleLabels: string[] = [];
      if (specialLabelsUsed.has("Homeoffice")) purpleLabels.push("Homeoffice");
      if (specialLabelsUsed.has("Vacaciones")) purpleLabels.push("Vacaciones");

      const legendItems: string[] = [];
      if (usedOk) legendItems.push(`<span style="display:inline-flex;align-items:center;gap:4px;"><span style="display:inline-block;width:12px;height:12px;background-color:#d1fae5;border:1px solid #a7f3d0;border-radius:2px;"></span> A tiempo</span>`);
      if (usedTarde) legendItems.push(`<span style="display:inline-flex;align-items:center;gap:4px;"><span style="display:inline-block;width:12px;height:12px;background-color:#fee2e2;border:1px solid #fca5a5;border-radius:2px;"></span> Justificar</span>`);
      if (usedOrange) legendItems.push(`<span style="display:inline-flex;align-items:center;gap:4px;"><span style="display:inline-block;width:12px;height:12px;background-color:#ffedd5;border:1px solid #fdba74;border-radius:2px;"></span> Retardo</span>`);
      if (usedInasist && greyLabels.length > 0) legendItems.push(`<span style="display:inline-flex;align-items:center;gap:4px;"><span style="display:inline-block;width:12px;height:12px;background-color:#f3f4f6;border:1px solid #d1d5db;border-radius:2px;"></span> ${greyLabels.join(" / ")}</span>`);
      if (usedEspecial && purpleLabels.length > 0) legendItems.push(`<span style="display:inline-flex;align-items:center;gap:4px;"><span style="display:inline-block;width:12px;height:12px;background-color:#ede9fe;border:1px solid #c4b5fd;border-radius:2px;"></span> ${purpleLabels.join(" / ")}</span>`);

      const legendHtml = legendItems.length > 0 ? `
        <div style="margin:10px 0 16px;font-family:'Segoe UI',sans-serif;font-size:11px;color:#6b7280;display:flex;flex-wrap:wrap;gap:8px;">
          ${legendItems.join("")}
        </div>
      ` : "";

      // Lista de TODOS los días del periodo con las nuevas reglas
      const listLines: string[] = [];

      sorted.forEach((r: any) => {
        const date = new Date(r.fecha);
        const utcDay = date.getUTCDay();
        if (utcDay === 0) return; // Ignorar domingos

        const dayName = diasSemana[utcDay].charAt(0).toUpperCase() + diasSemana[utcDay].slice(1);
        const dayNameNorm = diasSemana[utcDay].normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
        const dayNum = date.getUTCDate();
        const hDia = horario[dayNameNorm];
        const dateStr = date.toISOString().split("T")[0];

        const activeInc = activeMap.get(dateStr);
        const isOmitida = activeInc ? activeInc.omitida : false;
        // Usar el specialLabel resuelto (nunca "Inasistencia")
        const specialLabel = activeInc ? activeInc.specialLabel : null;
        const isAllNull = !r.entrada_turno && !r.salida_turno && !r.entrada_comida && !r.salida_comida;
        const dayLabel = `<strong>${dayName} ${dayNum}.</strong>`;

        let lineText = "";

        if (isOmitida) {
          // Omitido → Sin incidencias
          lineText = `${dayLabel} <span style="color:#16a34a;">Sin incidencias.</span>`;
        } else if (specialLabel && specialLabel !== "Inasistencia") {
          // Homeoffice / Vacaciones / Evento / Asueto
          const isGrey = specialLabel === "Evento" || specialLabel === "Asueto";
          const spColor = isGrey ? "#6b7280" : "#7c3aed";
          lineText = `${dayLabel} <span style="color:${spColor};font-weight:700;">${specialLabel}.</span>`;
        } else if (isAllNull) {
          // Inasistencia real (sin select o select = Inasistencia)
          const inasistLabel = (activeInc && activeInc.specialLabel === null && !activeInc.observaciones) ? "Inasistencia" : "Sin incidencias";
          const inasistMotivo = activeInc && activeInc.observaciones ? activeInc.observaciones : null;
          if (inasistMotivo) {
            lineText = `${dayLabel} Inasistencia. <strong>Motivo:</strong> ${inasistMotivo}.`;
          } else {
            lineText = `${dayLabel} ${inasistLabel}.`;
          }
        } else {
          // Hay datos – evaluar retardo y tiempo adicional
          const rEnt = parseTime(r.entrada_turno);
          const rSal = parseTime(r.salida_turno);
          const hIni = hDia ? parseHorarioTime(hDia.inicio) : null;
          const hFin = hDia ? parseHorarioTime(hDia.fin) : null;

          let justificarMins = 0;
          let tiempoAdicionalMins = 0;
          let isJustificar = false; // true si >15 min (rojo), false si 6-15 min (naranja)

          if (rEnt && hIni) {
            const diffEnt = timeDiffMins(rEnt, hIni);
            if (diffEnt > 5) {
              justificarMins = diffEnt;
              isJustificar = diffEnt > 15;
            }
          }

          if (rSal && hFin) {
            const diffSal = timeDiffMins(rSal, hFin);
            if (diffSal > 5) tiempoAdicionalMins = diffSal;
          }

          const hasObs = activeInc && activeInc.observaciones &&
            !(["Homeoffice","Vacaciones","Evento","Asueto"].includes(activeInc.observaciones));
          const hasObsComida = activeInc && activeInc.observaciones_comida;

          if (justificarMins === 0 && tiempoAdicionalMins === 0 && !hasObs) {
            // Sin incidencia relevante
            lineText = `${dayLabel} <span style="color:#16a34a;">Sin incidencias.</span>`;
          } else {
            // Armar línea: Justificar → Tiempo adicional → Motivo
            const parts: string[] = [dayLabel];
            if (justificarMins > 0) {
              const jColor = isJustificar ? "#dc2626" : "#ea580c";
              parts.push(`<strong style="color:${jColor};">Justificar ${justificarMins} minutos.</strong>`);
            }
            if (tiempoAdicionalMins > 0) {
              parts.push(`<strong style="color:#16a34a;">Tiempo adicional ${tiempoAdicionalMins} minutos.</strong>`);
            }
            if (hasObs) {
              parts.push(`<strong>Motivo:</strong> ${activeInc.observaciones}.`);
            }
            if (hasObsComida) {
              parts.push(`<strong>Motivo (Comida):</strong> ${activeInc.observaciones_comida}.`);
            }
            lineText = parts.join(" ");
          }
        }

        listLines.push(`<div style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #e5e7eb;">${lineText}</div>`);
      });

      const htmlList = listLines.length > 0 ? `
        <div style="background-color:#f9fafb;border-left:4px solid #caab55;padding:15px;margin:15px 0;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;font-size:14px;line-height:1.6;color:#374151;">
          ${listLines.join("")}
        </div>
      ` : "";

      const mesesNombres = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
      const activeMes = (document.getElementById("mes") as HTMLSelectElement).value;
      const activeAnio = (document.getElementById("anio") as HTMLSelectElement).value;
      const activeMesName = mesesNombres[parseInt(activeMes, 10) - 1];

      let emailSubject = "";
      if (currentFortnightFilter === "1") {
        emailSubject = `[SiGeT] Reporte de incidencias - ${colaboradorName} - Quincena 1 ${activeMesName} ${activeAnio}`;
      } else if (currentFortnightFilter === "2") {
        emailSubject = `[SiGeT] Reporte de incidencias - ${colaboradorName} - Quincena 2 ${activeMesName} ${activeAnio}`;
      } else {
        emailSubject = `[SiGeT] Reporte de incidencias - ${colaboradorName} - ${activeMesName} ${activeAnio}`;
      }

      return `
        <div style="border:1px solid #e5e7eb; padding: 20px; border-radius: 8px; font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif; text-align: left;">
          <div style="margin-bottom: 20px; border-bottom: 2px solid #881912; padding-bottom: 10px;">
            <div style="color: #6b7280; font-size: 12px; font-weight: bold; margin-bottom: 4px;">ASUNTO:</div>
            <div style="color: #111827; font-size: 15px; font-weight: bold;">${emailSubject}</div>
          </div>
          <p style="margin:0 0 16px;color:#374151;">Buen día Ing. Víctor Barrera,</p>
          <p style="margin:0 0 16px;color:#374151;"><strong>Colaborador:</strong> ${colaboradorName}</p>
          <p style="margin:0 0 16px;color:#374151;">Se envía el presente correo correspondiente con los registros de las incidencias y sus justificaciones:</p>
          <div style="margin:20px 0;">
            ${calendarTable}
            ${legendHtml}
          </div>
          ${htmlList}
        </div>
      `;
    }

    btnsPreviewReporte.forEach(btn => {
      btn.addEventListener("click", () => {
        if (!previewModal || !previewReporteContainer) return;
        const html = generateEmailPreviewHtml();
        previewReporteContainer.innerHTML = html;
        previewModal.classList.remove("hidden");
        previewModal.classList.add("flex");
      });
    });

    btnsVerTabla.forEach(btn => {
      btn.addEventListener("click", () => {
        try {
          console.log("[Ver Tabla] Clic en botón. registrosAPI:", registrosAPI);
          if (!tablaModal || !tablaCalendarioContainer) {
            console.error("[Ver Tabla] Modal o contenedor no encontrados en el DOM");
            return;
          }

          const mesesNombres = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
          const activeMes = (document.getElementById("mes") as HTMLSelectElement).value;
          const activeAnio = (document.getElementById("anio") as HTMLSelectElement).value;
          const activeMesName = mesesNombres[parseInt(activeMes, 10) - 1];

          let periodStr = "";
          if (currentFortnightFilter === "1") {
            periodStr = `Quincena 1 - ${activeMesName} de ${activeAnio}`;
          } else if (currentFortnightFilter === "2") {
            periodStr = `Quincena 2 - ${activeMesName} de ${activeAnio}`;
          } else {
            periodStr = `${activeMesName} de ${activeAnio}`;
          }

          if (tablaModalTitle) {
            tablaModalTitle.innerHTML = `<span class="text-primary font-black uppercase text-base sm:text-lg tracking-wider">${periodStr}</span>`;
          }

          // Filtrar incidencias activas en el periodo seleccionado
          const filtered = registrosAPI.filter((r) => {
            const d = new Date(r.fecha);
            const dayNum = d.getUTCDate();
            if (currentFortnightFilter === "1") return dayNum <= 15;
            if (currentFortnightFilter === "2") return dayNum >= 16;
            return true;
          });

          // Ordenar cronológicamente (más antiguo primero)
          const sorted = [...filtered].sort((a, b) => new Date(a.fecha).getTime() - new Date(b.fecha).getTime());

          if (sorted.length === 0) {
            tablaCalendarioContainer.innerHTML = `<p class="text-center text-muted-foreground py-8">No hay registros disponibles para generar la tabla.</p>`;
            tablaModal.classList.remove("hidden");
            tablaModal.classList.add("flex");
            return;
          }

          const formatT = (t: string | null) => {
            if (!t) return "";
            if (t.length === 4) return `${t.substring(0, 2)}:${t.substring(2, 4)}`;
            return t;
          };

          let calendarHtml = `
            <!-- Cabecera de Días en Escritorio -->
            <div class="hidden md:grid md:grid-cols-6 gap-2 text-center font-bold text-sm text-foreground/80 mb-3 border-b border-border pb-2 uppercase tracking-wide">
              <div>Lun</div>
              <div>Mar</div>
              <div>Mie</div>
              <div>Jue</div>
              <div>Vie</div>
              <div>Sab</div>
            </div>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2">
          `;

          // Insertar celdas vacías al principio si es necesario para alinear (solo en md en adelante)
          const firstDayNum = new Date(sorted[0].fecha).getUTCDay(); // 0 = dom, 1 = lun, etc.
          const emptyCellsCount = firstDayNum === 0 ? 0 : firstDayNum - 1;
          if (emptyCellsCount > 0 && emptyCellsCount < 6) {
            for (let i = 0; i < emptyCellsCount; i++) {
              calendarHtml += `<div class="hidden md:block border border-border/10 bg-muted/[0.02] rounded-md min-h-[7.5rem] relative"></div>`;
            }
          }

          sorted.forEach((r) => {
            const { dayName, dayNum, dayNameNormalized } = formatDate(r.fecha);
            const horarioDia = horario[dayNameNormalized];
            
            const hInicio = parseHorarioTime(horarioDia?.inicio);
            const hFin = parseHorarioTime(horarioDia?.fin);
            const rEntrada = parseTime(r.entrada_turno);
            const rSalida = parseTime(r.salida_turno);

            const isAllNull = !r.entrada_turno && !r.salida_turno && !r.entrada_comida && !r.salida_comida;

            let celdaContenido = "";

            if (isAllNull) {
              celdaContenido = `<div class="text-[#ca1c1c] font-black text-sm select-none">SL (-:--)</div>`;
            } else {
              // EL
              let elClass = "text-muted-foreground";
              if (r.entrada_turno && hInicio && rEntrada) {
                const diffEnt = timeDiffMins(rEntrada, hInicio);
                if (diffEnt < 0) {
                  elClass = "text-[#16a34a] font-bold";
                } else if (diffEnt > 15) {
                  elClass = "text-[#ca1c1c] font-bold";
                } else if (diffEnt >= 6 && diffEnt <= 15) {
                  elClass = "text-[#ea580c] font-bold";
                } else {
                  elClass = "text-foreground font-bold";
                }
                celdaContenido += `<div class="${elClass}">EL (${formatT(r.entrada_turno)})</div>`;
              } else if (!r.entrada_turno) {
                celdaContenido += `<div class="text-[#ca1c1c] font-bold">EL (-:--)</div>`;
              }

              // SC (Salida comida)
              if (r.entrada_comida) {
                celdaContenido += `<div class="text-muted-foreground">SC (${formatT(r.entrada_comida)})</div>`;
              }

              // RC (Regreso comida)
              if (r.salida_comida) {
                celdaContenido += `<div class="text-muted-foreground">RC (${formatT(r.salida_comida)})</div>`;
              }

              // SL
              let slClass = "text-muted-foreground";
              if (r.salida_turno && hFin && rSalida) {
                const diffSal = timeDiffMins(rSalida, hFin);
                if (diffSal > 5) {
                  slClass = "text-[#16a34a] font-bold";
                } else {
                  slClass = "text-foreground font-bold";
                }
                celdaContenido += `<div class="${slClass}">SL (${formatT(r.salida_turno)})</div>`;
              } else if (!r.salida_turno) {
                celdaContenido += `<div class="text-[#ca1c1c] font-bold">SL (-:--)</div>`;
              }
            }

            calendarHtml += `
              <div class="border border-border bg-card hover:bg-muted/10 transition-colors rounded-md p-3 min-h-[7.5rem] relative flex flex-col justify-center items-start text-xs font-semibold leading-relaxed shadow-sm">
                <!-- Marca de Agua con el Número del Día -->
                <div class="absolute inset-0 flex items-center justify-center text-5xl font-black text-foreground/[0.12] select-none pointer-events-none z-0">${parseInt(dayNum, 10)}</div>
                
                <!-- Contenido de Asistencias -->
                <div class="relative z-10 w-full space-y-0.5 text-left">
                  <!-- Nombre del día en pantallas pequeñas -->
                  <div class="md:hidden text-[10px] uppercase text-muted-foreground border-b border-border pb-0.5 mb-1 font-bold">${dayName}</div>
                  ${celdaContenido}
                </div>
              </div>
            `;
          });

          calendarHtml += `</div>`;
          tablaCalendarioContainer.innerHTML = calendarHtml;

          tablaModal.classList.remove("hidden");
          tablaModal.classList.add("flex");
          console.log("[Ver Tabla] Modal abierto exitosamente.");
        } catch (error) {
          console.error("[Ver Tabla] Error crítico al pintar el calendario:", error);
          toast.error("Error al renderizar el calendario. Revisa la consola del navegador.");
        }
      });
    });


    // Modal submit handler
    modalSubmit.addEventListener("click", async () => {
      const activeMes = (document.getElementById("mes") as HTMLSelectElement).value;
      const activeAnio = (document.getElementById("anio") as HTMLSelectElement).value;

      // 1. Filtrar incidencias en el periodo seleccionado (tanto Enviar como Omitir)
      const periodIncidencias = incidenciasToSave.filter((inc) => {
        const dateObj = new Date(inc.fecha);
        const dayNum = dateObj.getUTCDate();

        if (currentFortnightFilter === "1") return dayNum <= 15;
        if (currentFortnightFilter === "2") return dayNum >= 16;
        return true;
      });

      if (periodIncidencias.length === 0) {
        toast.error("No hay incidencias para enviar en esta quincena/periodo.");
        return;
      }

      // Validar justificaciones en el cliente (solo para los que no están omitidos)
      let valid = true;
      const payload: any[] = [];

      periodIncidencias.forEach((inc) => {
        const toggle = document.getElementById(`toggle-${inc.index}`) as HTMLInputElement;
        const isOmitida = toggle ? !toggle.checked : false;

        const obsEl = document.getElementById(`obs-${inc.index}`) as HTMLTextAreaElement;
        const obsComidaEl = document.getElementById(`obs-comida-${inc.index}`) as HTMLTextAreaElement;

        // Leer el select de tipo de inasistencia
        const selEl = document.getElementById(`tipo-inasistencia-${inc.index}`) as HTMLSelectElement;
        const tipoInasistencia = selEl ? selEl.value : "Inasistencia";
        // specialLabel = valor del select cuando NO es Inasistencia
        const specialLabel = tipoInasistencia !== "Inasistencia" ? tipoInasistencia : null;

        let valTurno = specialLabel || (obsEl ? obsEl.value.trim() : "");
        let valComida = obsComidaEl ? obsComidaEl.value.trim() : "";

        if (!isOmitida) {
          // Solo Inasistencia requiere motivo; los demás tipos lo omiten
          if (inc.requiresObs && !specialLabel) {
            if (valTurno.length < 5) {
              if (obsEl) obsEl.classList.add("border-red-500");
              valid = false;
            } else {
              if (obsEl) obsEl.classList.remove("border-red-500");
            }
          } else if (obsEl) {
            obsEl.classList.remove("border-red-500");
          }

          if (inc.requiresObsComida) {
            if (valComida.length < 5) {
              if (obsComidaEl) obsComidaEl.classList.add("border-red-500");
              valid = false;
            } else {
              if (obsComidaEl) obsComidaEl.classList.remove("border-red-500");
            }
          }
        } else {
          if (obsEl) obsEl.classList.remove("border-red-500");
          if (obsComidaEl) obsComidaEl.classList.remove("border-red-500");
        }

        payload.push({
          mes: inc.mes,
          quincena: inc.quincena,
          fecha: inc.fecha,
          entrada_turno: inc.entrada_turno,
          salida_turno: inc.salida_turno,
          tiempo_turno: inc.tiempo_turno,
          observaciones: valTurno || null,
          entrada_comida: inc.entrada_comida,
          salida_comida: inc.salida_comida,
          observaciones_comida: valComida || null,
          omitida: isOmitida,
        });
      });

      if (!valid) {
        toast.error("Por favor, llena los motivos requeridos (mínimo 5 caracteres) marcados en rojo.");
        return;
      }

      // Cambiar estado a cargando
      modalSubmit.disabled = true;
      modalSubmit.innerHTML = `<span class="animate-spin inline-block w-4 h-4 border-2 border-current border-t-transparent rounded-full mr-2"></span> Enviando...`;
      if (modalCancel) (modalCancel as HTMLButtonElement).disabled = true;
      if (modalClose) (modalClose as HTMLButtonElement).disabled = true;

      try {
        // Enviar reporte de incidencias final
        const quincenaVal = currentFortnightFilter === "all" ? 0 : parseInt(currentFortnightFilter, 10);
        const reportRes = await fetch("/api/user/incidencias/send-report", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            mes: parseInt(activeMes, 10),
            anio: parseInt(activeAnio, 10),
            quincena: quincenaVal,
            incidencias: payload,
            todosLosRegistros: registrosAPI,
          }),
        });

        if (!reportRes.ok) {
          throw new Error((await reportRes.json()).message || "Fallo al enviar el reporte.");
        }

        toast.success("Reporte enviado exitosamente.");
        closeModal();
        setTimeout(() => {
          window.location.reload();
        }, 1500);

      } catch (err: any) {
        toast.error(err.message || "Ocurrió un error al enviar el reporte.");
        modalSubmit.disabled = false;
        modalSubmit.textContent = "Enviar";
        if (modalCancel) (modalCancel as HTMLButtonElement).disabled = false;
        if (modalClose) (modalClose as HTMLButtonElement).disabled = false;
      }
    });

    btnsGuardar?.forEach((btnGuardar) => {
      btnGuardar.addEventListener("click", async () => {
        let valid = true;
        const payload: any[] = [];

        // Filtrar incidencias en el periodo seleccionado (tanto Enviar como Omitir)
        const periodIncidencias = incidenciasToSave.filter((inc) => {
          const dateObj = new Date(inc.fecha);
          const dayNum = dateObj.getUTCDate();

          if (currentFortnightFilter === "1") return dayNum <= 15;
          if (currentFortnightFilter === "2") return dayNum >= 16;
          return true;
        });

        periodIncidencias.forEach((inc) => {
          const toggle = document.getElementById(`toggle-${inc.index}`) as HTMLInputElement;
          const isOmitida = toggle ? !toggle.checked : false;

          const obsEl = document.getElementById(`obs-${inc.index}`) as HTMLTextAreaElement;
          const obsComidaEl = document.getElementById(`obs-comida-${inc.index}`) as HTMLTextAreaElement;

          // Leer el select de tipo de inasistencia (igual que en el handler de enviar)
          const selEl = document.getElementById(`tipo-inasistencia-${inc.index}`) as HTMLSelectElement;
          const tipoInasistencia = selEl ? selEl.value : "Inasistencia";
          const specialLabel = tipoInasistencia !== "Inasistencia" ? tipoInasistencia : null;

          let valTurno = specialLabel || (obsEl ? obsEl.value.trim() : "");
          let valComida = obsComidaEl ? obsComidaEl.value.trim() : "";

          if (!isOmitida) {
            if (inc.requiresObs && !specialLabel) {
              if (valTurno.length < 5) {
                if (obsEl) obsEl.classList.add("border-red-500");
                valid = false;
              } else {
                if (obsEl) obsEl.classList.remove("border-red-500");
              }
            } else if (obsEl) {
              obsEl.classList.remove("border-red-500");
            }

            if (inc.requiresObsComida) {
              if (valComida.length < 5) {
                if (obsComidaEl) obsComidaEl.classList.add("border-red-500");
                valid = false;
              } else {
                if (obsComidaEl) obsComidaEl.classList.remove("border-red-500");
              }
            }
          } else {
            if (obsEl) obsEl.classList.remove("border-red-500");
            if (obsComidaEl) obsComidaEl.classList.remove("border-red-500");
          }

          payload.push({
            mes: inc.mes,
            quincena: inc.quincena,
            fecha: inc.fecha,
            entrada_turno: inc.entrada_turno,
            salida_turno: inc.salida_turno,
            tiempo_turno: inc.tiempo_turno,
            observaciones: valTurno || null,
            entrada_comida: inc.entrada_comida,
            salida_comida: inc.salida_comida,
            observaciones_comida: valComida || null,
            omitida: isOmitida,
          });
        });

        if (!valid) {
          toast.error(
            "Por favor, llena los motivos requeridos (mínimo 5 caracteres) marcados en rojo.",
          );
          return;
        }

        if (payload.length === 0) {
          toast.error("No hay incidencias seleccionadas.");
          return;
        }

        btnsGuardar.forEach((b: any) => {
          b.disabled = true;
          b.textContent = "Guardando...";
        });

        try {
          const res = await fetch("/api/user/incidencias", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ incidencias: payload }),
          });

          if (!res.ok) {
            throw new Error((await res.json()).message || "Error al guardar");
          }

          toast.success("Incidencias guardadas correctamente.");
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } catch (err: any) {
          toast.error(err.message);
          btnsGuardar.forEach((b: any) => {
            b.disabled = false;
            b.textContent = "Guardar incidencias";
          });
        }
      });
    });
  });
</script>
