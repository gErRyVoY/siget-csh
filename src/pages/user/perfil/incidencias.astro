            const statusEl = document.getElementById(`status-text-${idx}`);
            const obsWrapper = document.getElementById(`obs-turno-wrapper-${idx}`);
            const obsEl = document.getElementById(`obs-${idx}`) as HTMLTextAreaElement;

            // Actualizar texto y color del status
            if (statusEl) {
