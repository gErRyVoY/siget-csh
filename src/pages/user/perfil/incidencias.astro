---
import MainLayout from "@/layouts/MainLayout.astro";
import { getSession } from "auth-astro/server";
import { prisma } from "@/lib/db";

const session = await getSession(Astro.request);
if (!session || !session.user) {
  return Astro.redirect("/login");
}

const userId = Number(session.user.id);
const dbUser = await prisma.usuario.findUnique({
  where: { id: userId },
  include: { rol: true },
});

if (!dbUser) {
  return Astro.redirect("/login");
}

const isPrivileged = [2, 3].includes(dbUser.rolId);
const atiendeTickets = (dbUser as any).atiende_csh || (dbUser as any).atiende_mkt;

if (!isPrivileged && !atiendeTickets) {
  return Astro.redirect("/");
}

const currentDate = new Date();
const currentMonth = currentDate.getMonth() + 1;
const currentYear = currentDate.getFullYear();

const years = Array.from(
  { length: currentYear - 2021 + 1 },
  (_, i) => currentYear - i,
);
const months = [
  { value: 1, label: "Enero" },
  { value: 2, label: "Febrero" },
  { value: 3, label: "Marzo" },
  { value: 4, label: "Abril" },
  { value: 5, label: "Mayo" },
  { value: 6, label: "Junio" },
  { value: 7, label: "Julio" },
  { value: 8, label: "Agosto" },
  { value: 9, label: "Septiembre" },
  { value: 10, label: "Octubre" },
  { value: 11, label: "Noviembre" },
  { value: 12, label: "Diciembre" },
];

const horario = JSON.stringify(dbUser.horario_disponibilidad ?? {});
const clave = dbUser.clave ?? "";
const colaboradorName = `${dbUser.nombres} ${dbUser.apellidos}`;

const GOOGLE_API_KEY = import.meta.env.GOOGLE_API_KEY || process.env.GOOGLE_API_KEY || "";
const GOOGLE_CLIENT_ID = import.meta.env.GOOGLE_CLIENT_ID || process.env.GOOGLE_CLIENT_ID || "";
const GOOGLE_APP_ID = import.meta.env.GOOGLE_APP_ID || process.env.GOOGLE_APP_ID || "";
---

<MainLayout title="Reporte de incidencias">
  <div class="max-w-5xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <a
        href="/user/perfil"
        class="bg-muted-foreground text-white hover:bg-muted-foreground/80 px-6 py-2 rounded-md text-sm font-semibold transition-colors"
        >Volver al perfil</a
      >
    </div>

    <div
      class="bg-card border border-muted-foreground/30 rounded-lg p-6 shadow-sm"
      id="incidencias-container"
      data-clave={clave}
      data-horario={horario}
      data-colaborador-name={colaboradorName}
      data-google-api-key={GOOGLE_API_KEY}
      data-google-client-id={GOOGLE_CLIENT_ID}
      data-google-app-id={GOOGLE_APP_ID}
    >
      <form
        id="consultar-form"
        class="flex flex-col sm:flex-row items-end gap-4 mb-6"
      >
        <div class="space-y-2 w-full sm:w-1/3">
          <label for="mes" class="block text-sm font-medium">Mes</label>
          <select
            id="mes"
            name="mes"
            class="w-full rounded-md border-border bg-input p-2 accent-secondary focus:outline-none focus:ring-1 focus:ring-secondary"
          >
            {
              months.map((m) => (
                <option value={m.value} selected={m.value === currentMonth}>
                  {m.label}
                </option>
              ))
            }
          </select>
        </div>

        <div class="space-y-2 w-full sm:w-1/3">
          <label for="anio" class="block text-sm font-medium">Año</label>
          <select
            id="anio"
            name="anio"
            class="w-full rounded-md border-border bg-input p-2 accent-secondary focus:outline-none focus:ring-1 focus:ring-secondary"
          >
            {
              years.map((y) => (
                <option value={y} selected={y === currentYear}>
                  {y}
                </option>
              ))
            }
          </select>
        </div>

        <div class="w-full sm:w-1/3">
          <button
            type="submit"
            id="btn-consultar"
            class="w-full bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-2 rounded-md text-sm font-semibold transition-colors"
          >
            Consultar
          </button>
        </div>
      </form>

      <div id="guardar-container-top" class="mb-4 hidden">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <div id="quincena-filters-top" class="flex gap-2 w-full sm:w-auto text-center"></div>
          <div class="flex flex-row justify-end gap-2 w-full sm:w-auto">
            <button
              type="button"
              class="bg-blue-600 hover:bg-blue-600/90 text-white p-2.5 rounded-md transition-colors btn-preview-reporte flex items-center justify-center cursor-pointer"
              title="Previsualizar correo del reporte"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
            <button
              type="button"
              class="bg-amber-600 hover:bg-amber-600/90 text-white p-2.5 rounded-md transition-colors btn-ver-tabla flex items-center justify-center cursor-pointer"
              title="Ver tabla"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            </button>
            <button
              type="button"
              class="bg-primary text-primary-foreground hover:bg-primary/90 p-2.5 rounded-md transition-colors btn-enviar-reporte flex items-center justify-center cursor-pointer"
              title="Enviar reporte"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </button>
            <button
              class="bg-secondary text-secondary-foreground hover:bg-secondary/90 p-2.5 rounded-md transition-colors btn-guardar-incidencias flex items-center justify-center font-bold"
              title="Guardar incidencias"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-save"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div id="resultados-container" class="space-y-6">
        <!-- Results will be injected here -->
      </div>

      <div id="guardar-container" class="mt-8 hidden border-t pt-4">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <div id="quincena-filters-bottom" class="flex gap-2 w-full sm:w-auto text-center"></div>
          <div class="flex flex-row justify-end gap-2 w-full sm:w-auto">
            <button
              type="button"
              class="bg-blue-600 hover:bg-blue-600/90 text-white p-2.5 rounded-md transition-colors btn-preview-reporte flex items-center justify-center cursor-pointer"
              title="Previsualizar correo del reporte"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
            <button
              type="button"
              class="bg-amber-600 hover:bg-amber-600/90 text-white p-2.5 rounded-md transition-colors btn-ver-tabla flex items-center justify-center cursor-pointer"
              title="Ver tabla"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            </button>
            <button
              type="button"
              class="bg-primary text-primary-foreground hover:bg-primary/90 p-2.5 rounded-md transition-colors btn-enviar-reporte flex items-center justify-center cursor-pointer"
              title="Enviar reporte"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </button>
            <button
              class="bg-secondary text-secondary-foreground hover:bg-secondary/90 p-2.5 rounded-md transition-colors btn-guardar-incidencias flex items-center justify-center font-bold"
              title="Guardar incidencias"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-save"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Enviar Reporte de Incidencias -->
  <div id="enviar-reporte-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 items-center justify-center p-4 hidden">
    <div class="bg-card text-card-foreground border border-muted-foreground/30 rounded-lg max-w-md w-full shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-border flex items-center justify-between">
        <h3 class="text-lg font-bold text-foreground">Enviar Reporte de Incidencias</h3>
        <button type="button" id="modal-close" class="text-muted-foreground hover:text-foreground text-xl font-bold cursor-pointer select-none">&times;</button>
      </div>
      <!-- Modal Body -->
      <div class="p-6 space-y-4">
        <p class="text-sm text-foreground" id="modal-period-text">
          Se enviará el reporte correspondiente al periodo seleccionado.
        </p>
        <p class="text-xs text-muted-foreground">
          Al confirmar, se generará una tabla calendarizada con los registros y motivos justificados del periodo y se enviará por correo a Víctor Barrera (victor@humanitas.edu.mx).
        </p>
      </div>
      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-border bg-muted/30 flex justify-end gap-3">
        <button type="button" id="modal-cancel" class="bg-input border border-border hover:bg-muted text-foreground py-2 px-4 rounded-md text-sm font-semibold transition-colors cursor-pointer">Cancelar</button>
        <button type="button" id="modal-submit" class="bg-primary text-primary-foreground hover:bg-primary/90 py-2 px-4 rounded-md text-sm font-semibold transition-colors cursor-pointer">Enviar</button>
      </div>
    </div>
  </div>

  <!-- Modal de Tabla de Incidencias -->
  <div id="ver-tabla-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 items-center justify-center p-4 hidden">
    <div class="bg-card text-card-foreground border border-muted-foreground/30 rounded-lg max-w-5xl w-full shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-border flex items-center justify-between bg-muted/30">
        <h3 class="text-lg font-bold text-foreground" id="tabla-modal-title">Tabla de Incidencias</h3>
        <button type="button" id="tabla-modal-close" class="text-muted-foreground hover:text-foreground text-xl font-bold cursor-pointer select-none">&times;</button>
      </div>
      <!-- Modal Body -->
      <div class="p-6 overflow-auto max-h-[75vh]">
        <div id="tabla-calendario-container" class="w-full">
          <!-- Calendar template table will be injected here -->
        </div>
      </div>
      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-border bg-muted/30 flex justify-end">
        <button type="button" id="tabla-modal-cancel" class="bg-input border border-border hover:bg-muted text-foreground py-2 px-6 rounded-md text-sm font-semibold transition-colors cursor-pointer">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Modal de Previsualización de Reporte -->
  <div id="preview-reporte-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 items-center justify-center p-4 hidden">
    <div class="bg-card text-card-foreground border border-muted-foreground/30 rounded-lg max-w-5xl w-full shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-border flex items-center justify-between bg-muted/30">
        <h3 class="text-lg font-bold text-foreground" id="preview-modal-title">Previsualización del Correo</h3>
        <button type="button" id="preview-modal-close" class="text-muted-foreground hover:text-foreground text-xl font-bold cursor-pointer select-none">&times;</button>
      </div>
      <!-- Modal Body -->
      <div class="p-6 overflow-auto max-h-[75vh] bg-white text-black">
        <div id="preview-reporte-container" class="w-full">
          <!-- Live preview HTML will be injected here -->
        </div>
      </div>
      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-border bg-muted/30 flex justify-end">
        <button type="button" id="preview-modal-cancel" class="bg-input border border-border hover:bg-muted text-foreground py-2 px-6 rounded-md text-sm font-semibold transition-colors cursor-pointer">Cerrar</button>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { toast } from "@/lib/toast";

  declare global {
    interface Window {
      gapi: any;
      google: any;
    }
  }

  document.addEventListener("astro:page-load", () => {
    const container = document.getElementById("incidencias-container");
    if (!container) return;

    const form = document.getElementById("consultar-form") as HTMLFormElement;
    const btnConsultar = document.getElementById(
      "btn-consultar",
    ) as HTMLButtonElement;
    const resultadosContainer = document.getElementById("resultados-container");
    const guardarContainer = document.getElementById("guardar-container");
    const guardarContainerTop = document.getElementById(
      "guardar-container-top",
    );
    const btnsGuardar = document.querySelectorAll(".btn-guardar-incidencias");
    const btnsEnviarReporte = document.querySelectorAll(".btn-enviar-reporte");
    const btnsVerTabla = document.querySelectorAll(".btn-ver-tabla");
    const btnsPreviewReporte = document.querySelectorAll(".btn-preview-reporte");

    // Modal elements
    const modal = document.getElementById("enviar-reporte-modal");
    const modalClose = document.getElementById("modal-close");
    const modalCancel = document.getElementById("modal-cancel");
    const modalSubmit = document.getElementById("modal-submit") as HTMLButtonElement;
    const modalPeriodText = document.getElementById("modal-period-text");

    // Table Modal Elements
    const tablaModal = document.getElementById("ver-tabla-modal");
    const tablaModalClose = document.getElementById("tabla-modal-close");
    const tablaModalCancel = document.getElementById("tabla-modal-cancel");
    const tablaModalTitle = document.getElementById("tabla-modal-title");
    const tablaCalendarioContainer = document.getElementById("tabla-calendario-container");

    // Preview Modal Elements
    const previewModal = document.getElementById("preview-reporte-modal");
    const previewModalClose = document.getElementById("preview-modal-close");
    const previewModalCancel = document.getElementById("preview-modal-cancel");
    const previewReporteContainer = document.getElementById("preview-reporte-container");

    const clave = container.dataset.clave;
    const horarioStr = container.dataset.horario;
    const colaboradorName = container.dataset.colaboradorName || "Colaborador";

    let horario: Record<string, any> = {};
    try {
      horario = horarioStr ? JSON.parse(horarioStr) : {};
    } catch {
      horario = {};
    }

    const diasSemana = [
      "domingo",
      "lunes",
      "martes",
      "miércoles",
      "jueves",
      "viernes",
      "sábado",
    ];

    let incidenciasToSave: any[] = [];
    let currentFortnightFilter = "all";

    let registrosAPI: any[] = [];
    let currentMes = 0;
    let currentAnio = 0;
    let savedIncidenciasLocal: any[] = [];

    function parseTime(tStr: string | null) {
      if (!tStr) return null;
      if (tStr.length === 4) {
        return {
          h: parseInt(tStr.substring(0, 2), 10),
          m: parseInt(tStr.substring(2, 4), 10),
        };
      }
      return null;
    }

    function timeDiffMins(
      t1: { h: number; m: number },
      t2: { h: number; m: number },
    ) {
      return t1.h * 60 + t1.m - (t2.h * 60 + t2.m);
    }

    function parseHorarioTime(tStr: string | null) {
      if (!tStr || tStr === "No disponible") return null;
      const [h, m] = tStr.split(":");
      return { h: parseInt(h, 10), m: parseInt(m, 10) };
    }

    function formatDate(dateStr: string) {
      const d = new Date(dateStr);
      const dayName = diasSemana[d.getUTCDay()];
      const dayNum = d.getUTCDate().toString().padStart(2, "0");
      return {
        dayName,
        dayNum,
        dayNameNormalized: dayName
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, ""),
      };
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!clave) {
        toast.error("El usuario no tiene una clave asignada.");
        return;
      }

      if (Object.keys(horario).length === 0) {
        toast.error("Debe actualizar su horario antes.");
        return;
      }

      btnConsultar.disabled = true;
      btnConsultar.textContent = "Consultando...";
      if (resultadosContainer) resultadosContainer.innerHTML = "";
      if (guardarContainer) guardarContainer.classList.add("hidden");
      if (guardarContainerTop) guardarContainerTop.classList.add("hidden");
      incidenciasToSave = [];

      const formData = new FormData(form);
      const mes = formData.get("mes");
      const anio = formData.get("anio");

      try {
        const [resHR, resLocal] = await Promise.all([
          fetch(
            `https://pz3bmmqsty.us-east-1.awsapprunner.com/api/rh/consultar-asistencias?trabajador=${clave}&mes=${mes}&anio=${anio}`,
            {
              headers: {
                accept: "application/json",
                "x-api-key": "CHURRUMAIS-1979",
              },
            },
          ),
          fetch(`/api/user/incidencias?mes=${mes}&anio=${anio}`),
        ]);

        if (!resHR.ok) {
          throw new Error("Error al consultar la API de asistencias");
        }

        const dataHR = await resHR.json();
        const dataLocal = resLocal.ok ? await resLocal.json() : { data: [] };
        const savedIncidencias = dataLocal.data || [];

        if (
          dataHR.status !== "ok" ||
          !dataHR.data ||
          dataHR.data.length === 0
        ) {
          if (resultadosContainer)
            resultadosContainer.innerHTML =
              "<p class='text-center text-muted-foreground'>No se encontraron registros para este periodo.</p>";
          return;
        }

        const sortedRegistros = dataHR.data.sort(
          (a: any, b: any) =>
            new Date(b.fecha).getTime() - new Date(a.fecha).getTime(),
        );

        renderResultados(
          sortedRegistros,
          parseInt(mes as string),
          parseInt(anio as string),
          savedIncidencias,
        );
      } catch (err: any) {
        toast.error(err.message || "Error desconocido");
      } finally {
        btnConsultar.disabled = false;
        btnConsultar.textContent = "Consultar";
      }
    });

    function renderResultados(
      registros: any[],
      mes: number,
      anio: number,
      savedIncidencias: any[],
    ) {
      if (!resultadosContainer) return;
      
      registrosAPI = registros;
      currentMes = mes;
      currentAnio = anio;
      savedIncidenciasLocal = savedIncidencias;

      let html = "";

      incidenciasToSave = [];
      const todayStr = new Date().toISOString().split("T")[0];
      let rendered16Plus = false;
      let rendered1To15 = false;
      currentFortnightFilter = "all"; // Resetear en cada nueva búsqueda

      registros.forEach((r, index) => {
        const { dayName, dayNum, dayNameNormalized } = formatDate(r.fecha);
        const horarioDia = horario[dayNameNormalized];

        if (
          !horarioDia ||
          horarioDia.inicio === "No disponible" ||
          horarioDia.fin === "No disponible"
        ) {
          return;
        }

        const rDateStr = new Date(r.fecha).toISOString().split("T")[0];
        const isToday = rDateStr === todayStr;

        const savedRecord = savedIncidencias.find((s) => {
          if (!s.fecha) return false;
          const sDateStr = new Date(s.fecha).toISOString().split("T")[0];
          return sDateStr === rDateStr;
        });

        const isSaved = !!savedRecord;

        const hInicio = parseHorarioTime(horarioDia.inicio);
        const hFin = parseHorarioTime(horarioDia.fin);

        const rEntrada = parseTime(r.entrada_turno);
        const rSalida = parseTime(r.salida_turno);
        const rEntComida = parseTime(r.entrada_comida);
        const rSalComida = parseTime(r.salida_comida);

        let statusClass = "";
        let statusText = "";
        let extraText = "";
        let reposicionExtraText = ""; // Minutos de reposición cuando hay retardo + salida tardía
        let requiresObs = false;
        let requiresObsComida = false;
        let showRow = false;
        let tiempoTurno: number | null = null;
        let reqObsText = "Motivo:";
        let reqObsComidaText = "Motivo:";

        // Evaluar condiciones
        const isAllNull =
          !r.entrada_turno &&
          !r.salida_turno &&
          !r.entrada_comida &&
          !r.salida_comida;

        if (isAllNull) {
          statusText = "Inasistencia";
          statusClass = "text-[#ca1c1c] font-bold";
          requiresObs = true;
          showRow = true;
        } else {
          // Parcial nulls
          const isEntradaNull = !r.entrada_turno;
          const isSalidaNull = !r.salida_turno;
          const isEntComidaNull = !r.entrada_comida;
          const isSalComidaNull = !r.salida_comida;

          if (
            isEntradaNull ||
            isSalidaNull ||
            isEntComidaNull ||
            isSalComidaNull
          ) {
            statusText = "Registro incompleto";
            statusClass = "text-[#ca1c1c] font-bold";
            showRow = true;

            if (isSalidaNull && !isSalComidaNull) {
              requiresObs = true;
              reqObsText = "";
            } else if (isSalidaNull && isSalComidaNull) {
              requiresObs = true;
            } else if (
              !isEntradaNull &&
              isSalidaNull &&
              isEntComidaNull &&
              isSalComidaNull
            ) {
              requiresObs = true;
            } else {
              requiresObs = true;
            }
          } else if (hInicio && rEntrada) {
            // Tiempos
            const diffEntrada = timeDiffMins(rEntrada, hInicio); // > 0 means late

            // Calcular minutos de salida tardía
            let diffSalida = 0;
            if (hFin && rSalida) {
              diffSalida = timeDiffMins(rSalida, hFin); // > 0 means late exit
            }

            // Reposición completa: entrada anticipada Y salida tardía
            const isReposicionCompleta = diffEntrada < -5 && diffSalida > 5;

            if (isReposicionCompleta) {
              const minsExtra = (-diffEntrada) + diffSalida;
              statusText = "Tiempo adicional";
              statusClass = "text-[#16a34a] font-bold";
              tiempoTurno = minsExtra;
              extraText = `${minsExtra} minutos`;
              requiresObs = true;
              showRow = true;
            } else if (diffEntrada > 5) {
              const minsRetardo = diffEntrada;
              if (diffEntrada > 15) {
                statusText = "Justificar";
                statusClass = "text-[#ca1c1c] font-bold";
              } else {
                statusText = "Retardo";
                statusClass = "text-[#ea580c] font-bold";
              }
              tiempoTurno = -minsRetardo;
              extraText = `${minsRetardo} minutos`;
              requiresObs = true;
              showRow = true;
              // Salida tardía adicional al retardo
              if (diffSalida > 5) {
                reposicionExtraText = `${diffSalida} minutos`;
              }
            } else {
              // Sin retardo – verificar solo salida tardía o entrada anticipada
              const earlyMins = diffEntrada < -5 ? (-diffEntrada) : 0;
              const lateMins = diffSalida > 5 ? diffSalida : 0;
              const totalExtra = earlyMins + lateMins;

              if (totalExtra > 5) {
                statusText = "Tiempo adicional";
                statusClass = "text-[#16a34a] font-bold";
                tiempoTurno = totalExtra;
                extraText = `${totalExtra} minutos`;
                requiresObs = true;
                showRow = true;
              }
            }
          }

          if (rEntComida && rSalComida && statusText !== "Registro incompleto") {
            const diffComida = timeDiffMins(rSalComida, rEntComida);
            if (diffComida > 30) {
              if (statusText === "") {
                statusText = "Horario excedido";
                statusClass = "text-[#ca1c1c] font-bold";
                showRow = true;
                // Calcular reposición parcial si la entrada fue anticipada o la salida tardía
                if (hInicio && rEntrada && hFin && rSalida) {
                  const diffEntRepo = timeDiffMins(rEntrada, hInicio);
                  const diffSalRepo = timeDiffMins(rSalida, hFin);
                  let minsRepo = 0;
                  if (diffEntRepo < -5) minsRepo += (-diffEntRepo);
                  if (diffSalRepo > 5) minsRepo += diffSalRepo;
                  if (minsRepo > 0) {
                    reposicionExtraText = `${minsRepo} minutos`;
                  }
                }
              }
              // Only require obs for comida if BOTH entrada and salida comida are present
              requiresObsComida = true;
            }
          }
        }

        if (showRow) {
          // Format time string manually
          const formatT = (t: string | null) => {
            if (!t) return "";
            if (t.length === 4)
              return `${t.substring(0, 2)}:${t.substring(2, 4)}`;
            return t;
          };

          const obsId = `obs-${index}`;
          const obsComidaId = `obs-comida-${index}`;

          const savedObs = savedRecord ? savedRecord.observaciones : "";
          const savedObsComida = savedRecord
            ? savedRecord.observaciones_comida
