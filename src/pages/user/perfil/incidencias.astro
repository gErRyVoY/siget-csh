          const specialOpciones = ["Homeoffice", "Vacaciones", "Evento", "Asueto"];
          const savedSpecialObs = isAllNull && specialOpciones.includes(savedObsValue) ? savedObsValue : "Inasistencia";

          const dayInt = parseInt(dayNum, 10);
          if (dayInt >= 16) {
            rendered16Plus = true;
          } else {
            rendered1To15 = true;
          }

          // Push to state
          incidenciasToSave.push({
            index,
            fecha: r.fecha,
            entrada_turno: r.entrada_turno,
            salida_turno: r.salida_turno,
            entrada_comida: r.entrada_comida,
            salida_comida: r.salida_comida,
            tiempo_turno: tiempoTurno,
            mes,
            quincena: dayInt <= 15 ? 1 : 2,
            requiresObs,
            requiresObsComida,
          });

          // Calcular distintivos de horario
          let entradaClass = "text-foreground";
          let salidaClass = "text-foreground";
          let comidaClass = "text-foreground";

          if (hInicio && rEntrada) {
            const diffEnt = timeDiffMins(rEntrada, hInicio);
            if (diffEnt > 15) {
              entradaClass = "text-[#ca1c1c] font-bold";
            } else if (diffEnt >= 6 && diffEnt <= 15) {
              entradaClass = "text-[#ea580c] font-bold";
            } else if (diffEnt < 0) {
              entradaClass = "text-[#16a34a] font-bold";
            }
          }

          if (hFin && rSalida) {
            const diffSal = timeDiffMins(rSalida, hFin);
            if (diffSal > 5) {
              salidaClass = "text-[#16a34a] font-bold";
            }
          }

          if (rEntComida && rSalComida && statusText !== "Registro incompleto") {
            const diffCom = timeDiffMins(rSalComida, rEntComida);
            if (diffCom > 30) {
              comidaClass = "text-[#ca1c1c] font-bold";
            }
          }

          html += `
            <div class="border rounded-md overflow-hidden bg-card mb-4 relative pb-10 sm:pb-0 incidencia-card-row" id="row-${index}" data-day="${parseInt(dayNum, 10)}" data-is-inasistencia="${isAllNull ? '1' : '0'}">
                <div class="bg-muted-foreground/80 text-white flex justify-between items-center px-4 py-2">
                    <span class="font-bold capitalize">${dayName} ${dayNum}</span>
                    <div class="flex items-center gap-2">
                        ${isAllNull ? `
                          <select id="tipo-inasistencia-${index}" class="incidencia-tipo-select text-xs font-semibold bg-muted-foreground/20 border-none rounded-md px-2 py-1 cursor-pointer focus:outline-none focus:ring-1 focus:ring-primary" data-index="${index}">
                            <option value="Inasistencia" ${savedSpecialObs === 'Inasistencia' ? 'selected' : ''}>Inasistencia</option>
                            <option value="Homeoffice" ${savedSpecialObs === 'Homeoffice' ? 'selected' : ''}>Homeoffice</option>
                            <option value="Vacaciones" ${savedSpecialObs === 'Vacaciones' ? 'selected' : ''}>Vacaciones</option>
                            <option value="Evento" ${savedSpecialObs === 'Evento' ? 'selected' : ''}>Evento</option>
                            <option value="Asueto" ${savedSpecialObs === 'Asueto' ? 'selected' : ''}>Asueto</option>
                          </select>
                        ` : ''}
                        <span class="text-xs font-semibold select-none toggle-label w-12 text-right" id="label-toggle-${index}">${toggleChecked ? "Enviar" : "Omitir"}</span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="toggle-${index}" class="sr-only peer incidencia-toggle" ${toggleChecked ? "checked" : ""} data-index="${index}">
                            <div class="w-11 h-6 bg-muted-foreground peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                        </label>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row">
                    <div class="p-4 border-b sm:border-b-0 sm:border-r flex flex-col justify-center items-center ${statusText === 'Horario excedido' ? '' : statusClass} sm:w-[150px] shrink-0 text-center" id="status-col-${index}">
                        ${isAllNull ? `<span id="status-text-${index}" class="${
                          savedSpecialObs === 'Homeoffice' || savedSpecialObs === 'Vacaciones' ? 'text-[#7c3aed] font-bold' :
                          savedSpecialObs === 'Inasistencia' ? 'text-[#ca1c1c] font-bold' : 'text-[#6b7280] font-bold'
                        }">${savedSpecialObs}</span>` : `
                          ${statusText !== 'Horario excedido' ? `<span>${statusText}</span>` : ''}
                          ${statusText !== 'Horario excedido' && extraText ? `<span class="mt-1">${extraText}</span>` : ''}
                          ${reposicionExtraText ? `<span class="mt-2 text-green-600 font-bold">Tiempo adicional</span><span class="text-green-600 font-bold">${reposicionExtraText}</span>` : ''}
                        `}
                    </div>
                    <div class="p-4 border-b sm:border-b-0 sm:border-r space-y-2 sm:w-[250px] flex-shrink-0 text-sm">
                        <div class="flex justify-between items-center font-bold">
