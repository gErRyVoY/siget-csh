      });

      // Clear filters first
      const filtersTop = document.getElementById("quincena-filters-top");
      const filtersBottom = document.getElementById("quincena-filters-bottom");
      if (filtersTop) filtersTop.innerHTML = "";
      if (filtersBottom) filtersBottom.innerHTML = "";

      if (html === "") {
        resultadosContainer.innerHTML =
          "<p class='text-center text-muted-foreground'>No se encontraron incidencias en este periodo (horario cumplido).</p>";
      } else {
        resultadosContainer.innerHTML = html;
        if (guardarContainer) guardarContainer.classList.remove("hidden");
        if (guardarContainerTop) guardarContainerTop.classList.remove("hidden");

        // Setup fortnight filter buttons segun los periodos disponibles
        const hasBothPeriods = rendered1To15 && rendered16Plus;
        const hasOnlyQ1 = rendered1To15 && !rendered16Plus;
        const hasOnlyQ2 = rendered16Plus && !rendered1To15;

        if (hasBothPeriods) {
          // Hay dias en ambas quincenas: mostrar los 3 botones
          const btnHtml = `
            <button type="button" class="btn-q-all bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 rounded-md text-xs font-semibold transition-colors cursor-pointer" data-filter="all">Ver todo</button>
            <button type="button" class="btn-q-1 bg-muted text-muted-foreground hover:bg-muted/80 px-4 py-2 rounded-md text-xs font-semibold transition-colors cursor-pointer" data-filter="1">Quincena 1</button>
            <button type="button" class="btn-q-2 bg-muted text-muted-foreground hover:bg-muted/80 px-4 py-2 rounded-md text-xs font-semibold transition-colors cursor-pointer" data-filter="2">Quincena 2</button>
          `;
          if (filtersTop) filtersTop.innerHTML = btnHtml;
          if (filtersBottom) filtersBottom.innerHTML = btnHtml;
          currentFortnightFilter = "all";
          setupFortnightFilters();
        } else if (hasOnlyQ1) {
          // Solo hay dias en la primera quincena
          const btnHtml = `
            <button type="button" class="btn-q-1 bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 rounded-md text-xs font-semibold transition-colors cursor-pointer" data-filter="1">Quincena 1</button>
          `;
          if (filtersTop) filtersTop.innerHTML = btnHtml;
          if (filtersBottom) filtersBottom.innerHTML = btnHtml;
          currentFortnightFilter = "1";
          setupFortnightFilters();
        } else if (hasOnlyQ2) {
          // Solo hay dias en la segunda quincena
          const btnHtml = `
            <button type="button" class="btn-q-2 bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 rounded-md text-xs font-semibold transition-colors cursor-pointer" data-filter="2">Quincena 2</button>
          `;
          if (filtersTop) filtersTop.innerHTML = btnHtml;
          if (filtersBottom) filtersBottom.innerHTML = btnHtml;
          currentFortnightFilter = "2";
          setupFortnightFilters();
        }

        // Attach event listeners for toggles (Enviar/Omitir)
        document.querySelectorAll(".incidencia-toggle").forEach((toggle) => {
          toggle.addEventListener("change", (e) => {
            const t = e.target as HTMLInputElement;
