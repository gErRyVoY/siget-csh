---
import MainLayout from "@/layouts/MainLayout.astro";
import { getSession } from "auth-astro/server";
import { prisma } from "@/lib/db";

const session = await getSession(Astro.request);
if (!session || !session.user) {
  return Astro.redirect("/login");
}

const userId = Number(session.user.id);
const dbUser = await prisma.usuario.findUnique({
  where: { id: userId },
  include: { rol: true },
});

if (!dbUser) {
  return Astro.redirect("/login");
}

const atiendeTickets =
  dbUser.rol.atiendeTicketsCsh || dbUser.rol.atiendeTicketsMkt;

if (!atiendeTickets) {
  return Astro.redirect("/");
}

const currentDate = new Date();
const currentMonth = currentDate.getMonth() + 1;
const currentYear = currentDate.getFullYear();

const years = Array.from(
  { length: currentYear - 2021 + 1 },
  (_, i) => currentYear - i,
);
const months = [
  { value: 1, label: "Enero" },
  { value: 2, label: "Febrero" },
  { value: 3, label: "Marzo" },
  { value: 4, label: "Abril" },
  { value: 5, label: "Mayo" },
  { value: 6, label: "Junio" },
  { value: 7, label: "Julio" },
  { value: 8, label: "Agosto" },
  { value: 9, label: "Septiembre" },
  { value: 10, label: "Octubre" },
  { value: 11, label: "Noviembre" },
  { value: 12, label: "Diciembre" },
];

const horario = JSON.stringify(dbUser.horario_disponibilidad ?? {});
const clave = dbUser.clave ?? "";

const GOOGLE_API_KEY = import.meta.env.GOOGLE_API_KEY || process.env.GOOGLE_API_KEY || "";
const GOOGLE_CLIENT_ID = import.meta.env.GOOGLE_CLIENT_ID || process.env.GOOGLE_CLIENT_ID || "";
const GOOGLE_APP_ID = import.meta.env.GOOGLE_APP_ID || process.env.GOOGLE_APP_ID || "";
---

<MainLayout title="Reporte de incidencias">
  <div class="max-w-5xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <a
        href="/user/perfil"
        class="bg-muted-foreground text-white hover:bg-muted-foreground/80 px-6 py-2 rounded-md text-sm font-semibold transition-colors"
        >Volver al perfil</a
      >
    </div>

    <div
      class="bg-card border border-muted-foreground/30 rounded-lg p-6 shadow-sm"
      id="incidencias-container"
      data-clave={clave}
      data-horario={horario}
      data-google-api-key={GOOGLE_API_KEY}
      data-google-client-id={GOOGLE_CLIENT_ID}
      data-google-app-id={GOOGLE_APP_ID}
    >
      <form
        id="consultar-form"
        class="flex flex-col sm:flex-row items-end gap-4 mb-6"
      >
        <div class="space-y-2 w-full sm:w-1/3">
          <label for="mes" class="block text-sm font-medium">Mes</label>
          <select
            id="mes"
            name="mes"
            class="w-full rounded-md border-border bg-input p-2 accent-secondary focus:outline-none focus:ring-1 focus:ring-secondary"
          >
            {
              months.map((m) => (
                <option value={m.value} selected={m.value === currentMonth}>
                  {m.label}
                </option>
              ))
            }
          </select>
        </div>

        <div class="space-y-2 w-full sm:w-1/3">
          <label for="anio" class="block text-sm font-medium">Año</label>
          <select
            id="anio"
            name="anio"
            class="w-full rounded-md border-border bg-input p-2 accent-secondary focus:outline-none focus:ring-1 focus:ring-secondary"
          >
            {
              years.map((y) => (
                <option value={y} selected={y === currentYear}>
                  {y}
                </option>
              ))
            }
          </select>
        </div>

        <div class="w-full sm:w-1/3">
          <button
            type="submit"
            id="btn-consultar"
            class="w-full bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-2 rounded-md text-sm font-semibold transition-colors"
          >
            Consultar
          </button>
        </div>
      </form>

      <div id="guardar-container-top" class="mb-4 hidden">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <div id="quincena-filters-top" class="flex gap-2 w-full sm:w-auto text-center"></div>
          <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
            <button
              type="button"
              class="bg-amber-600 hover:bg-amber-600/90 text-white px-6 py-2 rounded-md text-sm font-semibold transition-colors btn-ver-tabla w-full sm:w-auto text-center cursor-pointer font-bold"
            >
              Ver tabla
            </button>
            <button
              type="button"
              class="bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-2 rounded-md text-sm font-semibold transition-colors btn-enviar-reporte w-full sm:w-auto text-center cursor-pointer font-bold"
            >
              Enviar reporte
            </button>
            <button
              class="bg-secondary text-secondary-foreground hover:bg-secondary/90 px-6 py-2 rounded-md text-sm font-semibold transition-colors btn-guardar-incidencias w-full sm:w-auto text-center font-bold"
            >
              Guardar incidencias
            </button>
          </div>
        </div>
      </div>

      <div id="resultados-container" class="space-y-6">
        <!-- Results will be injected here -->
      </div>

      <div id="guardar-container" class="mt-8 hidden border-t pt-4">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <div id="quincena-filters-bottom" class="flex gap-2 w-full sm:w-auto text-center"></div>
          <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
            <button
              type="button"
              class="bg-amber-600 hover:bg-amber-600/90 text-white px-6 py-2 rounded-md text-sm font-semibold transition-colors btn-ver-tabla w-full sm:w-auto text-center cursor-pointer font-bold"
            >
              Ver tabla
            </button>
            <button
              type="button"
              class="bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-2 rounded-md text-sm font-semibold transition-colors btn-enviar-reporte w-full sm:w-auto text-center cursor-pointer font-bold"
            >
              Enviar reporte
            </button>
            <button
              class="bg-secondary text-secondary-foreground hover:bg-secondary/90 px-6 py-2 rounded-md text-sm font-semibold transition-colors btn-guardar-incidencias w-full sm:w-auto text-center font-bold"
            >
              Guardar incidencias
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Enviar Reporte de Incidencias -->
  <div id="enviar-reporte-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-card text-card-foreground border border-muted-foreground/30 rounded-lg max-w-md w-full shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-border flex items-center justify-between">
        <h3 class="text-lg font-bold text-foreground">Enviar Reporte de Incidencias</h3>
        <button type="button" id="modal-close" class="text-muted-foreground hover:text-foreground text-xl font-bold cursor-pointer select-none">&times;</button>
      </div>
      <!-- Modal Body -->
      <div class="p-6 space-y-4">
        <p class="text-sm text-foreground" id="modal-period-text">
          Se enviará el reporte correspondiente al periodo seleccionado.
        </p>
        <p class="text-xs text-muted-foreground">
          Al confirmar, se generará una tabla calendarizada con los registros y motivos justificados del periodo y se enviará por correo al Director del CSH.
        </p>
      </div>
      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-border bg-muted/30 flex justify-end gap-3">
        <button type="button" id="modal-cancel" class="bg-input border border-border hover:bg-muted text-foreground py-2 px-4 rounded-md text-sm font-semibold transition-colors cursor-pointer">Cancelar</button>
        <button type="button" id="modal-submit" class="bg-primary text-primary-foreground hover:bg-primary/90 py-2 px-4 rounded-md text-sm font-semibold transition-colors cursor-pointer">Enviar</button>
      </div>
    </div>
  </div>

  <!-- Modal de Tabla de Incidencias -->
  <div id="ver-tabla-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-card text-card-foreground border border-muted-foreground/30 rounded-lg max-w-5xl w-full shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-border flex items-center justify-between bg-muted/30">
        <h3 class="text-lg font-bold text-foreground" id="tabla-modal-title">Tabla de Incidencias</h3>
        <button type="button" id="tabla-modal-close" class="text-muted-foreground hover:text-foreground text-xl font-bold cursor-pointer select-none">&times;</button>
      </div>
      <!-- Modal Body -->
      <div class="p-6 overflow-auto max-h-[75vh]">
        <div id="tabla-calendario-container" class="w-full">
          <!-- Calendar template table will be injected here -->
        </div>
      </div>
      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-border bg-muted/30 flex justify-end">
        <button type="button" id="tabla-modal-cancel" class="bg-input border border-border hover:bg-muted text-foreground py-2 px-6 rounded-md text-sm font-semibold transition-colors cursor-pointer">Cerrar</button>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { toast } from "@/lib/toast";

  declare global {
    interface Window {
      gapi: any;
      google: any;
    }
  }

  document.addEventListener("astro:page-load", () => {
    const container = document.getElementById("incidencias-container");
    if (!container) return;

    const form = document.getElementById("consultar-form") as HTMLFormElement;
    const btnConsultar = document.getElementById(
      "btn-consultar",
    ) as HTMLButtonElement;
    const resultadosContainer = document.getElementById("resultados-container");
    const guardarContainer = document.getElementById("guardar-container");
    const guardarContainerTop = document.getElementById(
      "guardar-container-top",
    );
    const btnsGuardar = document.querySelectorAll(".btn-guardar-incidencias");
    const btnsEnviarReporte = document.querySelectorAll(".btn-enviar-reporte");
    const btnsVerTabla = document.querySelectorAll(".btn-ver-tabla");

    // Modal elements
    const modal = document.getElementById("enviar-reporte-modal");
    const modalClose = document.getElementById("modal-close");
    const modalCancel = document.getElementById("modal-cancel");
    const modalSubmit = document.getElementById("modal-submit") as HTMLButtonElement;
    const modalPeriodText = document.getElementById("modal-period-text");

    // Table Modal Elements
    const tablaModal = document.getElementById("ver-tabla-modal");
    const tablaModalClose = document.getElementById("tabla-modal-close");
    const tablaModalCancel = document.getElementById("tabla-modal-cancel");
    const tablaModalTitle = document.getElementById("tabla-modal-title");
    const tablaCalendarioContainer = document.getElementById("tabla-calendario-container");

    const clave = container.dataset.clave;
    const horarioStr = container.dataset.horario;

    let horario: Record<string, any> = {};
    try {
      horario = horarioStr ? JSON.parse(horarioStr) : {};
    } catch {
      horario = {};
    }

    const diasSemana = [
      "domingo",
      "lunes",
      "martes",
      "miércoles",
      "jueves",
      "viernes",
      "sábado",
    ];

    let incidenciasToSave: any[] = [];
    let currentFortnightFilter = "all";

    let registrosAPI: any[] = [];
    let currentMes = 0;
    let currentAnio = 0;
    let savedIncidenciasLocal: any[] = [];

    function parseTime(tStr: string | null) {
      if (!tStr) return null;
      if (tStr.length === 4) {
        return {
          h: parseInt(tStr.substring(0, 2), 10),
          m: parseInt(tStr.substring(2, 4), 10),
        };
      }
      return null;
    }

    function timeDiffMins(
      t1: { h: number; m: number },
      t2: { h: number; m: number },
    ) {
      return t1.h * 60 + t1.m - (t2.h * 60 + t2.m);
    }

    function parseHorarioTime(tStr: string | null) {
      if (!tStr || tStr === "No disponible") return null;
      const [h, m] = tStr.split(":");
      return { h: parseInt(h, 10), m: parseInt(m, 10) };
    }

    function formatDate(dateStr: string) {
      const d = new Date(dateStr);
      const dayName = diasSemana[d.getUTCDay()];
      const dayNum = d.getUTCDate().toString().padStart(2, "0");
      return {
        dayName,
        dayNum,
        dayNameNormalized: dayName
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, ""),
      };
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!clave) {
        toast.error("El usuario no tiene una clave asignada.");
        return;
      }

      if (Object.keys(horario).length === 0) {
        toast.error("Debe actualizar su horario antes.");
        return;
      }

      btnConsultar.disabled = true;
      btnConsultar.textContent = "Consultando...";
      if (resultadosContainer) resultadosContainer.innerHTML = "";
      if (guardarContainer) guardarContainer.classList.add("hidden");
      if (guardarContainerTop) guardarContainerTop.classList.add("hidden");
      incidenciasToSave = [];

      const formData = new FormData(form);
      const mes = formData.get("mes");
      const anio = formData.get("anio");

      try {
        const [resHR, resLocal] = await Promise.all([
          fetch(
            `https://pz3bmmqsty.us-east-1.awsapprunner.com/api/rh/consultar-asistencias?trabajador=${clave}&mes=${mes}&anio=${anio}`,
            {
              headers: {
                accept: "application/json",
                "x-api-key": "CHURRUMAIS-1979",
              },
            },
          ),
          fetch(`/api/user/incidencias?mes=${mes}&anio=${anio}`),
        ]);

        if (!resHR.ok) {
          throw new Error("Error al consultar la API de asistencias");
        }

        const dataHR = await resHR.json();
        const dataLocal = resLocal.ok ? await resLocal.json() : { data: [] };
        const savedIncidencias = dataLocal.data || [];

        if (
          dataHR.status !== "ok" ||
          !dataHR.data ||
          dataHR.data.length === 0
        ) {
          if (resultadosContainer)
            resultadosContainer.innerHTML =
              "<p class='text-center text-muted-foreground'>No se encontraron registros para este periodo.</p>";
          return;
        }

        const sortedRegistros = dataHR.data.sort(
          (a: any, b: any) =>
            new Date(b.fecha).getTime() - new Date(a.fecha).getTime(),
        );

        renderResultados(
          sortedRegistros,
          parseInt(mes as string),
          parseInt(anio as string),
          savedIncidencias,
        );
      } catch (err: any) {
        toast.error(err.message || "Error desconocido");
      } finally {
        btnConsultar.disabled = false;
        btnConsultar.textContent = "Consultar";
      }
    });

    function renderResultados(
      registros: any[],
      mes: number,
      anio: number,
      savedIncidencias: any[],
    ) {
      if (!resultadosContainer) return;
      
      registrosAPI = registros;
      currentMes = mes;
      currentAnio = anio;
      savedIncidenciasLocal = savedIncidencias;

      let html = "";

      incidenciasToSave = [];
      const todayStr = new Date().toISOString().split("T")[0];
      let rendered16Plus = false;

      registros.forEach((r, index) => {
        const { dayName, dayNum, dayNameNormalized } = formatDate(r.fecha);
        const horarioDia = horario[dayNameNormalized];

        if (
          !horarioDia ||
          horarioDia.inicio === "No disponible" ||
          horarioDia.fin === "No disponible"
        ) {
          return;
        }

        const rDateStr = new Date(r.fecha).toISOString().split("T")[0];
        const isToday = rDateStr === todayStr;

        const savedRecord = savedIncidencias.find((s) => {
          if (!s.fecha) return false;
          const sDateStr = new Date(s.fecha).toISOString().split("T")[0];
          return sDateStr === rDateStr;
        });

        const isSaved = !!savedRecord;

        const hInicio = parseHorarioTime(horarioDia.inicio);
        const hFin = parseHorarioTime(horarioDia.fin);

        const rEntrada = parseTime(r.entrada_turno);
        const rSalida = parseTime(r.salida_turno);
        const rEntComida = parseTime(r.entrada_comida);
        const rSalComida = parseTime(r.salida_comida);

        let statusClass = "";
        let statusText = "";
        let extraText = "";
        let reposicionExtraText = ""; // Minutos de reposición cuando hay retardo + salida tardía
        let requiresObs = false;
        let requiresObsComida = false;
        let showRow = false;
        let tiempoTurno: number | null = null;
        let reqObsText = "Motivo:";
        let reqObsComidaText = "Motivo:";

        // Evaluar condiciones
        const isAllNull =
          !r.entrada_turno &&
          !r.salida_turno &&
          !r.entrada_comida &&
          !r.salida_comida;

        if (isAllNull) {
          statusText = "Inasistencia";
          statusClass = "text-red-600 font-bold";
          requiresObs = true;
          showRow = true;
        } else {
          // Parcial nulls
          const isEntradaNull = !r.entrada_turno;
          const isSalidaNull = !r.salida_turno;
          const isEntComidaNull = !r.entrada_comida;
          const isSalComidaNull = !r.salida_comida;

          if (
            isEntradaNull ||
            isSalidaNull ||
            isEntComidaNull ||
            isSalComidaNull
          ) {
            statusText = "Registro incompleto";
            statusClass = "text-red-600 font-bold";
            showRow = true;

            if (isSalidaNull && !isSalComidaNull) {
              requiresObs = true;
              reqObsText = "";
            } else if (isSalidaNull && isSalComidaNull) {
              requiresObs = true;
              requiresObsComida = true;
            } else if (
              !isEntradaNull &&
              isSalidaNull &&
              isEntComidaNull &&
              isSalComidaNull
            ) {
              requiresObs = true;
            } else {
              requiresObs = true;
            }
          } else if (hInicio && rEntrada) {
            // Tiempos
            const diffEntrada = timeDiffMins(rEntrada, hInicio); // > 0 means late
            
            // Check if it qualifies as Reposición (entry before start AND exit after end)
            let isReposicion = false;
            let minsExtraReposicion = 0;
            if (hFin && rSalida) {
              const diffSalida = timeDiffMins(rSalida, hFin); // > 0 means late exit
              if (diffEntrada < 0 && diffSalida > 0) {
                isReposicion = true;
                minsExtraReposicion = (-diffEntrada) + diffSalida;
              }
            }

            if (isReposicion) {
              statusText = "Reposición de tiempo";
              statusClass = "text-green-600 font-bold";
              tiempoTurno = minsExtraReposicion;
              extraText = `${minsExtraReposicion} minutos`;
              requiresObs = true;
              showRow = true;
            } else if (diffEntrada > 5) {
              const minsRetardo = diffEntrada - 5;
              statusText = "Retardo";
              statusClass = "text-red-600 font-bold";
              tiempoTurno = -minsRetardo;
              extraText = `${minsRetardo} minutos`;
              requiresObs = true;
              showRow = true;
              // Comprobar si además hay salida tardía (reposición parcial)
              if (hFin && rSalida) {
                const diffSalRetardo = timeDiffMins(rSalida, hFin); // >0 si salida tardía
                if (diffSalRetardo > 5) {
                  reposicionExtraText = `${diffSalRetardo} minutos`;
                }
              }
            } else {
              // Check extra time
              if (hFin && rSalida) {
                const earlyMins = -diffEntrada; // positive if early
                const lateMins = timeDiffMins(rSalida, hFin); // positive if left late

                let totalExtra = 0;
                if (earlyMins >= 60) totalExtra += earlyMins;
                if (lateMins >= 60) totalExtra += lateMins;

                if (totalExtra >= 60) {
                  statusText = "Tiempo extra";
                  statusClass = "text-green-600 font-bold";
                  tiempoTurno = totalExtra;
                  extraText = `${totalExtra} minutos`;
                  requiresObs = true;
                  showRow = true;
                }
              }
            }
          }

          if (rEntComida && rSalComida) {
            const diffComida = timeDiffMins(rSalComida, rEntComida);
            if (diffComida > 30) {
              if (statusText === "") {
                statusText = "Horario excedido";
                statusClass = "text-red-600 font-bold";
                showRow = true;
                // Calcular reposición parcial si la entrada fue anticipada o la salida tardía
                if (hInicio && rEntrada && hFin && rSalida) {
                  const diffEntRepo = timeDiffMins(rEntrada, hInicio);
                  const diffSalRepo = timeDiffMins(rSalida, hFin);
                  let minsRepo = 0;
                  if (diffEntRepo < -5) minsRepo += (-diffEntRepo);
                  if (diffSalRepo > 5) minsRepo += diffSalRepo;
                  if (minsRepo > 0) {
                    reposicionExtraText = `${minsRepo} minutos`;
                  }
                }
              }
              requiresObsComida = true;
            }
          }
        }

        if (showRow) {
          // Format time string manually
          const formatT = (t: string | null) => {
            if (!t) return "";
            if (t.length === 4)
              return `${t.substring(0, 2)}:${t.substring(2, 4)}`;
            return t;
          };

          const obsId = `obs-${index}`;
          const obsComidaId = `obs-comida-${index}`;

          const savedObs = savedRecord ? savedRecord.observaciones : "";
          const savedObsComida = savedRecord
            ? savedRecord.observaciones_comida
            : "";

          let toggleChecked = isSaved ? false : !isToday;

          const dayInt = parseInt(dayNum, 10);
          if (dayInt >= 16) {
            rendered16Plus = true;
          }

          // Push to state
          incidenciasToSave.push({
            index,
            fecha: r.fecha,
            entrada_turno: r.entrada_turno,
            salida_turno: r.salida_turno,
            entrada_comida: r.entrada_comida,
            salida_comida: r.salida_comida,
            tiempo_turno: tiempoTurno,
            mes,
            quincena: dayInt <= 15 ? 1 : 2,
            requiresObs,
            requiresObsComida,
          });

          // Calcular distintivos de horario
          let entradaClass = "text-foreground";
          let salidaClass = "text-foreground";
          let comidaClass = "text-foreground";

          if (hInicio && rEntrada) {
            const diffEnt = timeDiffMins(rEntrada, hInicio);
            if (diffEnt > 5) {
              entradaClass = "text-destructive font-bold";
            } else if (diffEnt < 0) {
              entradaClass = "text-green-600 font-bold";
            }
          }

          if (hFin && rSalida) {
            const diffSal = timeDiffMins(rSalida, hFin);
            if (diffSal > 5) {
              salidaClass = "text-green-600 font-bold";
            }
          }

          if (rEntComida && rSalComida) {
            const diffCom = timeDiffMins(rSalComida, rEntComida);
            if (diffCom > 30) {
              comidaClass = "text-destructive font-bold";
            }
          }

          html += `
            <div class="border rounded-md overflow-hidden bg-card mb-4 relative pb-10 sm:pb-0 incidencia-card-row" id="row-${index}" data-day="${parseInt(dayNum, 10)}">
                <div class="bg-muted-foreground/80 text-white flex justify-between items-center px-4 py-2">
                    <span class="font-bold capitalize">${dayName} ${dayNum}</span>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold select-none toggle-label w-12 text-right" id="label-toggle-${index}">${toggleChecked ? "Enviar" : "Omitir"}</span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="toggle-${index}" class="sr-only peer incidencia-toggle" ${toggleChecked ? "checked" : ""} data-index="${index}">
                            <div class="w-11 h-6 bg-muted-foreground peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                        </label>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row">
                    <div class="p-4 border-b sm:border-b-0 sm:border-r flex flex-col justify-center items-center ${statusText === 'Horario excedido' ? '' : statusClass} sm:w-[150px] shrink-0 text-center">
                        ${statusText !== 'Horario excedido' ? `<span>${statusText}</span>` : ''}
                        ${statusText !== 'Horario excedido' && extraText ? `<span class="mt-1">${extraText}</span>` : ''}
                        ${reposicionExtraText ? `<span class="mt-2 text-green-600 font-bold">Reposición de tiempo</span><span class="text-green-600 font-bold">${reposicionExtraText}</span>` : ''}
                    </div>
                    <div class="p-4 border-b sm:border-b-0 sm:border-r space-y-2 sm:w-[250px] flex-shrink-0 text-sm">
                        <div class="flex justify-between items-center font-bold">
                            <span>Entrada laboral:</span>
                            <span>${horarioDia.inicio}</span>
                        </div>
                        <div class="flex justify-between items-center text-muted-foreground mb-2">
                            <span>Registro entrada:</span>
                            <span class="${entradaClass}">${formatT(r.entrada_turno)}</span>
                        </div>
                        <div class="flex justify-between items-center font-bold pt-2 border-t">
                            <span>Salida laboral:</span>
                            <span>${horarioDia.fin}</span>
                        </div>
                        <div class="flex justify-between items-center text-muted-foreground">
                            <span>Registro salida:</span>
                            <span class="${salidaClass}">${formatT(r.salida_turno)}</span>
                        </div>
                        <div class="flex justify-between items-center text-muted-foreground pt-2 border-t mt-2">
                            <span>Entrada comida:</span>
                            <span class="${comidaClass}">${formatT(r.entrada_comida)}</span>
                        </div>
                        <div class="flex justify-between items-center text-muted-foreground">
                            <span>Salida comida:</span>
                            <span class="${comidaClass}">${formatT(r.salida_comida)}</span>
                        </div>
                        ${requiresObsComida ? '<div class="text-red-600 font-bold mt-2">Horario excedido</div>' : ''}
                    </div>
                    <div class="p-4 space-y-4 flex-1">
                        ${
                          requiresObs
                            ? `
                            <div>
                                <label class="block font-bold text-sm mb-1">Motivo (Turno):</label>
                                <textarea id="${obsId}" class="w-full text-sm border-border bg-input p-2 rounded-md ${isSaved ? "opacity-60 cursor-not-allowed" : ""}" rows="2" placeholder="${reqObsText}" ${isSaved ? "disabled" : ""}>${savedObs || ""}</textarea>
                            </div>
                        `
                            : ""
                        }
                        ${
                          requiresObsComida
                            ? `
                            <div>
                                <label class="block font-bold text-sm mb-1">Motivo (Comida):</label>
                                <textarea id="${obsComidaId}" class="w-full text-sm border-border bg-input p-2 rounded-md ${isSaved ? "opacity-60 cursor-not-allowed" : ""}" rows="2" placeholder="${reqObsComidaText}" ${isSaved ? "disabled" : ""}>${savedObsComida || ""}</textarea>
                            </div>
                        `
                            : ""
                        }
                    </div>
                </div>
                ${
                  isSaved
                    ? `
                <div class="absolute bottom-2 sm:bottom-4 right-4 text-xs">
                    <button type="button" class="text-primary hover:underline font-medium btn-editar" data-index="${index}">Editar</button>
                </div>
                `
                    : ""
                }
            </div>
            `;
        }
      });

      // Clear filters first
      const filtersTop = document.getElementById("quincena-filters-top");
      const filtersBottom = document.getElementById("quincena-filters-bottom");
      if (filtersTop) filtersTop.innerHTML = "";
      if (filtersBottom) filtersBottom.innerHTML = "";

      if (html === "") {
        resultadosContainer.innerHTML =
          "<p class='text-center text-muted-foreground'>No se encontraron incidencias en este periodo (horario cumplido).</p>";
      } else {
        resultadosContainer.innerHTML = html;
        if (guardarContainer) guardarContainer.classList.remove("hidden");
        if (guardarContainerTop) guardarContainerTop.classList.remove("hidden");

        // Setup fortnight filters if we have rendered days >= 16
        if (rendered16Plus) {
          const btnHtml = `
            <button type="button" class="btn-q-all bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 rounded-md text-xs font-semibold transition-colors cursor-pointer" data-filter="all">Ver todo</button>
            <button type="button" class="btn-q-1 bg-muted text-muted-foreground hover:bg-muted/80 px-4 py-2 rounded-md text-xs font-semibold transition-colors cursor-pointer" data-filter="1">Quincena 1</button>
            <button type="button" class="btn-q-2 bg-muted text-muted-foreground hover:bg-muted/80 px-4 py-2 rounded-md text-xs font-semibold transition-colors cursor-pointer" data-filter="2">Quincena 2</button>
          `;
          if (filtersTop) filtersTop.innerHTML = btnHtml;
          if (filtersBottom) filtersBottom.innerHTML = btnHtml;

          setupFortnightFilters();
        }

        // Attach event listeners for toggles
        document.querySelectorAll(".incidencia-toggle").forEach((toggle) => {
          toggle.addEventListener("change", (e) => {
            const t = e.target as HTMLInputElement;
            const idx = t.dataset.index;
            const label = document.getElementById(`label-toggle-${idx}`);
            if (label) {
              label.textContent = t.checked ? "Enviar" : "Omitir";
            }
          });
        });

        // Attach event listeners for Edit buttons
        document.querySelectorAll(".btn-editar").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const b = e.target as HTMLButtonElement;
            const idx = b.dataset.index;

            const obsEl = document.getElementById(
              `obs-${idx}`,
            ) as HTMLTextAreaElement;
            const obsComidaEl = document.getElementById(
              `obs-comida-${idx}`,
            ) as HTMLTextAreaElement;

            if (obsEl) {
              obsEl.disabled = false;
              obsEl.classList.remove("opacity-60", "cursor-not-allowed");
            }
            if (obsComidaEl) {
              obsComidaEl.disabled = false;
              obsComidaEl.classList.remove("opacity-60", "cursor-not-allowed");
            }

            const toggle = document.getElementById(
              `toggle-${idx}`,
            ) as HTMLInputElement;
            if (toggle) {
              toggle.checked = true;
              toggle.dispatchEvent(new Event("change"));
            }

            b.style.display = "none";
          });
        });
      }
    }

    function setupFortnightFilters() {
      const allButtons = document.querySelectorAll(".btn-q-all, .btn-q-1, .btn-q-2");
      
      allButtons.forEach(btn => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const filterType = target.dataset.filter;
          currentFortnightFilter = filterType || "all";
          
          const rows = document.querySelectorAll(".incidencia-card-row");
          rows.forEach((row: any) => {
            const day = parseInt(row.dataset.day, 10);
            if (filterType === "all") {
              row.classList.remove("hidden");
            } else if (filterType === "1") {
              if (day <= 15) {
                row.classList.remove("hidden");
              } else {
                row.classList.add("hidden");
              }
            } else if (filterType === "2") {
              if (day >= 16) {
                row.classList.remove("hidden");
              } else {
                row.classList.add("hidden");
              }
            }
          });

          // Sync active styles across both top and bottom sets of buttons
          const sameFilterButtons = document.querySelectorAll(`[data-filter="${filterType}"]`);
          const otherFilterButtons = document.querySelectorAll(`[data-filter]:not([data-filter="${filterType}"])`);

          sameFilterButtons.forEach(b => {
            b.classList.remove("bg-muted", "text-muted-foreground", "hover:bg-muted/80");
            b.classList.add("bg-primary", "text-primary-foreground", "hover:bg-primary/90");
          });

          otherFilterButtons.forEach(b => {
            b.classList.remove("bg-primary", "text-primary-foreground", "hover:bg-primary/90");
            b.classList.add("bg-muted", "text-muted-foreground", "hover:bg-muted/80");
          });
        });
      });
    }

    // Modal Events and Functionality
    btnsEnviarReporte.forEach(btn => {
      btn.addEventListener("click", () => {
        if (!modal) return;

        // Calcular el texto del periodo activo
        const mesesNombres = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
        const activeMes = (document.getElementById("mes") as HTMLSelectElement).value;
        const activeAnio = (document.getElementById("anio") as HTMLSelectElement).value;
        const activeMesName = mesesNombres[parseInt(activeMes, 10) - 1];

        let periodStr = "";
        if (currentFortnightFilter === "1") {
          periodStr = `Quincena 1 (días 1 al 15) de ${activeMesName} de ${activeAnio}`;
        } else if (currentFortnightFilter === "2") {
          periodStr = `Quincena 2 (días 16 en adelante) de ${activeMesName} de ${activeAnio}`;
        } else {
          periodStr = `Mes completo (${activeMesName} de ${activeAnio})`;
        }

        if (modalPeriodText) {
          modalPeriodText.innerHTML = `Se enviará el reporte correspondiente a: <strong class="text-foreground">${periodStr}</strong>.`;
        }

        modal.classList.remove("hidden");
      });
    });

    const closeModal = () => {
      if (modal) modal.classList.add("hidden");
    };

    modalClose?.addEventListener("click", closeModal);
    modalCancel?.addEventListener("click", closeModal);

    // Table Modal Events and Render Logic
    const closeTablaModal = () => {
      if (tablaModal) tablaModal.classList.add("hidden");
    };

    tablaModalClose?.addEventListener("click", closeTablaModal);
    tablaModalCancel?.addEventListener("click", closeTablaModal);
    document.getElementById("tabla-modal-cancel")?.addEventListener("click", closeTablaModal);

    btnsVerTabla.forEach(btn => {
      btn.addEventListener("click", () => {
        try {
          console.log("[Ver Tabla] Clic en botón. registrosAPI:", registrosAPI);
          if (!tablaModal || !tablaCalendarioContainer) {
            console.error("[Ver Tabla] Modal o contenedor no encontrados en el DOM");
            return;
          }

          const mesesNombres = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
          const activeMes = (document.getElementById("mes") as HTMLSelectElement).value;
          const activeAnio = (document.getElementById("anio") as HTMLSelectElement).value;
          const activeMesName = mesesNombres[parseInt(activeMes, 10) - 1];

          let periodStr = "";
          if (currentFortnightFilter === "1") {
            periodStr = `Quincena 1 - ${activeMesName} de ${activeAnio}`;
          } else if (currentFortnightFilter === "2") {
            periodStr = `Quincena 2 - ${activeMesName} de ${activeAnio}`;
          } else {
            periodStr = `${activeMesName} de ${activeAnio}`;
          }

          if (tablaModalTitle) {
            tablaModalTitle.innerHTML = `<span class="text-primary font-black uppercase text-base sm:text-lg tracking-wider">${periodStr}</span>`;
          }

          // Filtrar incidencias activas en el periodo seleccionado
          const filtered = registrosAPI.filter((r) => {
            const d = new Date(r.fecha);
            const dayNum = d.getUTCDate();
            if (currentFortnightFilter === "1") return dayNum <= 15;
            if (currentFortnightFilter === "2") return dayNum >= 16;
            return true;
          });

          // Ordenar cronológicamente (más antiguo primero)
          const sorted = [...filtered].sort((a, b) => new Date(a.fecha).getTime() - new Date(b.fecha).getTime());

          if (sorted.length === 0) {
            tablaCalendarioContainer.innerHTML = `<p class="text-center text-muted-foreground py-8">No hay registros disponibles para generar la tabla.</p>`;
            tablaModal.classList.remove("hidden");
            return;
          }

          const formatT = (t: string | null) => {
            if (!t) return "";
            if (t.length === 4) return `${t.substring(0, 2)}:${t.substring(2, 4)}`;
            return t;
          };

          let calendarHtml = `
            <!-- Cabecera de Días en Escritorio -->
            <div class="hidden md:grid md:grid-cols-6 gap-2 text-center font-bold text-sm text-foreground/80 mb-3 border-b border-border pb-2 uppercase tracking-wide">
              <div>Lun</div>
              <div>Mar</div>
              <div>Mie</div>
              <div>Jue</div>
              <div>Vie</div>
              <div>Sab</div>
            </div>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2">
          `;

          // Insertar celdas vacías al principio si es necesario para alinear (solo en md en adelante)
          const firstDayNum = new Date(sorted[0].fecha).getUTCDay(); // 0 = dom, 1 = lun, etc.
          const emptyCellsCount = firstDayNum === 0 ? 0 : firstDayNum - 1;
          if (emptyCellsCount > 0 && emptyCellsCount < 6) {
            for (let i = 0; i < emptyCellsCount; i++) {
              calendarHtml += `<div class="hidden md:block border border-border/10 bg-muted/[0.02] rounded-md min-h-[7.5rem] relative"></div>`;
            }
          }

          sorted.forEach((r) => {
            const { dayName, dayNum, dayNameNormalized } = formatDate(r.fecha);
            const horarioDia = horario[dayNameNormalized];
            
            const hInicio = parseHorarioTime(horarioDia?.inicio);
            const hFin = parseHorarioTime(horarioDia?.fin);
            const rEntrada = parseTime(r.entrada_turno);
            const rSalida = parseTime(r.salida_turno);

            const isAllNull = !r.entrada_turno && !r.salida_turno && !r.entrada_comida && !r.salida_comida;

            let celdaContenido = "";

            if (isAllNull) {
              celdaContenido = `<div class="text-[#ca1c1c] font-black text-sm select-none">SL (-:--)</div>`;
            } else {
              // EL
              let elClass = "text-muted-foreground";
              if (r.entrada_turno && hInicio && rEntrada) {
                const diffEnt = timeDiffMins(rEntrada, hInicio);
                if (diffEnt < 0) {
                  elClass = "text-[#16a34a] font-bold";
                } else if (diffEnt > 15) {
                  elClass = "text-[#ca1c1c] font-bold";
                } else if (diffEnt >= 6 && diffEnt <= 15) {
                  elClass = "text-[#ea580c] font-bold";
                } else {
                  elClass = "text-foreground font-bold";
                }
                celdaContenido += `<div class="${elClass}">EL (${formatT(r.entrada_turno)})</div>`;
              } else if (!r.entrada_turno) {
                celdaContenido += `<div class="text-[#ca1c1c] font-bold">EL (-:--)</div>`;
              }

              // SC (Salida comida)
              if (r.entrada_comida) {
                celdaContenido += `<div class="text-muted-foreground">SC (${formatT(r.entrada_comida)})</div>`;
              }

              // RC (Regreso comida)
              if (r.salida_comida) {
                celdaContenido += `<div class="text-muted-foreground">RC (${formatT(r.salida_comida)})</div>`;
              }

              // SL
              let slClass = "text-muted-foreground";
              if (r.salida_turno && hFin && rSalida) {
                const diffSal = timeDiffMins(rSalida, hFin);
                if (diffSal > 5) {
                  slClass = "text-[#16a34a] font-bold";
                } else {
                  slClass = "text-foreground font-bold";
                }
                celdaContenido += `<div class="${slClass}">SL (${formatT(r.salida_turno)})</div>`;
              } else if (!r.salida_turno) {
                celdaContenido += `<div class="text-[#ca1c1c] font-bold">SL (-:--)</div>`;
              }
            }

            calendarHtml += `
              <div class="border border-border bg-card hover:bg-muted/10 transition-colors rounded-md p-3 min-h-[7.5rem] relative flex flex-col justify-center items-start text-xs font-semibold leading-relaxed shadow-sm">
                <!-- Marca de Agua con el Número del Día -->
                <div class="absolute inset-0 flex items-center justify-center text-5xl font-black text-foreground/[0.12] select-none pointer-events-none z-0">${parseInt(dayNum, 10)}</div>
                
                <!-- Contenido de Asistencias -->
                <div class="relative z-10 w-full space-y-0.5 text-left">
                  <!-- Nombre del día en pantallas pequeñas -->
                  <div class="md:hidden text-[10px] uppercase text-muted-foreground border-b border-border pb-0.5 mb-1 font-bold">${dayName}</div>
                  ${celdaContenido}
                </div>
              </div>
            `;
          });

          calendarHtml += `</div>`;
          tablaCalendarioContainer.innerHTML = calendarHtml;

          tablaModal.classList.remove("hidden");
          console.log("[Ver Tabla] Modal abierto exitosamente.");
        } catch (error) {
          console.error("[Ver Tabla] Error crítico al pintar el calendario:", error);
          toast.error("Error al renderizar el calendario. Revisa la consola del navegador.");
        }
      });
    });


    // Modal submit handler
    modalSubmit.addEventListener("click", async () => {
      const activeMes = (document.getElementById("mes") as HTMLSelectElement).value;
      const activeAnio = (document.getElementById("anio") as HTMLSelectElement).value;

      // 1. Filtrar incidencias activas en el periodo seleccionado y validadas
      const activeIncidencias = incidenciasToSave.filter((inc) => {
        const toggle = document.getElementById(`toggle-${inc.index}`) as HTMLInputElement;
        const isToggled = toggle ? toggle.checked : false;
        if (!isToggled) return false;

        const dateObj = new Date(inc.fecha);
        const dayNum = dateObj.getUTCDate();

        if (currentFortnightFilter === "1") return dayNum <= 15;
        if (currentFortnightFilter === "2") return dayNum >= 16;
        return true;
      });

      if (activeIncidencias.length === 0) {
        toast.error("No hay incidencias seleccionadas para enviar en esta quincena/periodo.");
        return;
      }

      // Validar justificaciones en el cliente
      let valid = true;
      const payload: any[] = [];

      activeIncidencias.forEach((inc) => {
        const obsEl = document.getElementById(`obs-${inc.index}`) as HTMLTextAreaElement;
        const obsComidaEl = document.getElementById(`obs-comida-${inc.index}`) as HTMLTextAreaElement;

        let valTurno = obsEl ? obsEl.value.trim() : "";
        let valComida = obsComidaEl ? obsComidaEl.value.trim() : "";

        if (inc.requiresObs) {
          if (valTurno.length < 5) {
            if (obsEl) obsEl.classList.add("border-red-500");
            valid = false;
          } else {
            if (obsEl) obsEl.classList.remove("border-red-500");
          }
        }

        if (inc.requiresObsComida) {
          if (valComida.length < 5) {
            if (obsComidaEl) obsComidaEl.classList.add("border-red-500");
            valid = false;
          } else {
            if (obsComidaEl) obsComidaEl.classList.remove("border-red-500");
          }
        }

        payload.push({
          mes: inc.mes,
          quincena: inc.quincena,
          fecha: inc.fecha,
          entrada_turno: inc.entrada_turno,
          salida_turno: inc.salida_turno,
          tiempo_turno: inc.tiempo_turno,
          observaciones: valTurno || null,
          entrada_comida: inc.entrada_comida,
          salida_comida: inc.salida_comida,
          observaciones_comida: valComida || null,
        });
      });

      if (!valid) {
        toast.error("Por favor, llena los motivos requeridos (mínimo 5 caracteres) marcados en rojo.");
        return;
      }

      // Cambiar estado a cargando
      modalSubmit.disabled = true;
      modalSubmit.innerHTML = `<span class="animate-spin inline-block w-4 h-4 border-2 border-current border-t-transparent rounded-full mr-2"></span> Enviando...`;
      if (modalCancel) (modalCancel as HTMLButtonElement).disabled = true;
      if (modalClose) (modalClose as HTMLButtonElement).disabled = true;

      try {
        // Enviar reporte de incidencias final
        const quincenaVal = currentFortnightFilter === "all" ? 0 : parseInt(currentFortnightFilter, 10);
        const reportRes = await fetch("/api/user/incidencias/send-report", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            mes: parseInt(activeMes, 10),
            anio: parseInt(activeAnio, 10),
            quincena: quincenaVal,
            incidencias: payload,
          }),
        });

        if (!reportRes.ok) {
          throw new Error((await reportRes.json()).message || "Fallo al enviar el reporte.");
        }

        toast.success("Reporte enviado exitosamente.");
        closeModal();
        setTimeout(() => {
          window.location.reload();
        }, 1500);

      } catch (err: any) {
        toast.error(err.message || "Ocurrió un error al enviar el reporte.");
        modalSubmit.disabled = false;
        modalSubmit.textContent = "Enviar";
        if (modalCancel) (modalCancel as HTMLButtonElement).disabled = false;
        if (modalClose) (modalClose as HTMLButtonElement).disabled = false;
      }
    });

    btnsGuardar?.forEach((btnGuardar) => {
      btnGuardar.addEventListener("click", async () => {
        let valid = true;
        const payload: any[] = [];

        incidenciasToSave.forEach((inc) => {
          const toggle = document.getElementById(
            `toggle-${inc.index}`,
          ) as HTMLInputElement;
          // Only send if toggle is checked
          if (!toggle || !toggle.checked) {
            return;
          }

          const obsEl = document.getElementById(
            `obs-${inc.index}`,
          ) as HTMLTextAreaElement;
          const obsComidaEl = document.getElementById(
            `obs-comida-${inc.index}`,
          ) as HTMLTextAreaElement;

          let valTurno = obsEl ? obsEl.value.trim() : "";
          let valComida = obsComidaEl ? obsComidaEl.value.trim() : "";

          if (inc.requiresObs) {
            if (valTurno.length < 5) {
              if (obsEl) obsEl.classList.add("border-red-500");
              valid = false;
            } else {
              if (obsEl) obsEl.classList.remove("border-red-500");
            }
          }

          if (inc.requiresObsComida) {
            if (valComida.length < 5) {
              if (obsComidaEl) obsComidaEl.classList.add("border-red-500");
              valid = false;
            } else {
              if (obsComidaEl) obsComidaEl.classList.remove("border-red-500");
            }
          }

          if (valid) {
            payload.push({
              mes: inc.mes,
              quincena: inc.quincena,
              fecha: inc.fecha,
              entrada_turno: inc.entrada_turno,
              salida_turno: inc.salida_turno,
              tiempo_turno: inc.tiempo_turno,
              observaciones: valTurno || null,
              entrada_comida: inc.entrada_comida,
              salida_comida: inc.salida_comida,
              observaciones_comida: valComida || null,
            });
          }
        });

        if (!valid) {
          toast.error(
            "Por favor, llena los motivos requeridos (mínimo 5 caracteres) marcados en rojo.",
          );
          return;
        }

        if (payload.length === 0) {
          toast.error("No hay incidencias seleccionadas para enviar.");
          return;
        }

        btnsGuardar.forEach((b: any) => {
          b.disabled = true;
          b.textContent = "Guardando...";
        });

        try {
          const res = await fetch("/api/user/incidencias", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ incidencias: payload }),
          });

          if (!res.ok) {
            throw new Error((await res.json()).message || "Error al guardar");
          }

          toast.success("Incidencias guardadas correctamente.");
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } catch (err: any) {
          toast.error(err.message);
          btnsGuardar.forEach((b: any) => {
            b.disabled = false;
            b.textContent = "Guardar incidencias";
          });
        }
      });
    });
  });
</script>
