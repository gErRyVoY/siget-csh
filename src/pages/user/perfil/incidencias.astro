                        }
                        ${
                          requiresObsComida
                            ? `
                            <div id="obs-comida-wrapper-${index}" ${!toggleChecked ? 'class="hidden"' : ''}>
                                <label class="block font-bold text-sm mb-1">Motivo (Comida):</label>
                                <textarea id="${obsComidaId}" class="w-full text-sm border-border bg-input p-2 rounded-md ${isSaved ? "opacity-60 cursor-not-allowed" : ""}" rows="2" placeholder="${reqObsComidaText}" ${isSaved ? "disabled" : ""}>${savedObsComida || ""}</textarea>
                            </div>
                        `
                            : ""
                        }
                    </div>
                </div>
                ${
                  isSaved
                    ? `
                <div class="absolute bottom-2 sm:bottom-4 right-4 text-xs">
                    <button type="button" class="text-primary hover:underline font-medium btn-editar" data-index="${index}">Editar</button>
                </div>
