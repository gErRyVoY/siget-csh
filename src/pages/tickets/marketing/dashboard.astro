---
import MainLayout from "@/layouts/MainLayout.astro";
import { prisma } from "@/lib/db";
import StatCard from "@/components/dashboard/StatCard.astro";

// Reutilizar sesión resuelta por middleware.ts (evita N+1 a la BD por navegación)
const session = Astro.locals.session;
if (!session || !session.user) {
    return Astro.redirect("/login");
}

const MARKETING_CATEGORY_ID = 12;
const rolId = session.user.rol?.id ?? 1;
const isAdminOrSuper = rolId === 2 || rolId === 3;
const currentUserId = parseInt(session.user.id as string, 10);

const statusColors: Record<string, string> = {
    "Total de Tickets": "#6b7280",
    "Tickets Nuevos": "#a1a1aa",
    "Tickets En progreso": "#3b82f6",
    "Tickets En espera": "#38bdf8",
    "Tickets Solucionados": "#84cc16",
    "Tickets Duplicados": "#171717",
    "Tickets Cancelados": "#dc2626",
    "Sin asignar": "#475569",
};

// ── Stats Generales ──────────────────────────────────────────────
const [ticketCounts, statuses] = await Promise.all([
    prisma.ticket.groupBy({
        by: ["estatusId"],
        _count: { id: true },
        where: { categoriaId: MARKETING_CATEGORY_ID },
    }),
    prisma.estatus.findMany(),
]);

const getCount = (name: string) => {
    const status = statuses.find((s) => s.nombre === name);
    if (!status) return 0;
    return ticketCounts.find((c) => c.estatusId === status.id)?._count.id || 0;
};

const getStatusId = (name: string) =>
    statuses.find((s) => s.nombre === name)?.id;

const stats = {
    nuevos: getCount("Nuevo"),
    enProgreso: getCount("En progreso"),
    enEspera: getCount("En espera"),
    total: ticketCounts.reduce((acc, curr) => acc + curr._count.id, 0),
    solucionados: getCount("Solucionado"),
    duplicados: getCount("Duplicado"),
    cancelados: getCount("Cancelado"),
};

// ── Stats Personales (solo admin/superadmin) ─────────────────────
let personalStats = {
    nuevos: 0,
    enProgreso: 0,
    enEspera: 0,
    total: 0,
    solucionados: 0,
    duplicados: 0,
    cancelados: 0,
};
let recentPersonalTickets: any[] = [];

if (isAdminOrSuper && !isNaN(currentUserId)) {
    const [personalCounts, personalRecent] = await Promise.all([
        prisma.ticket.groupBy({
            by: ["estatusId"],
            where: { atiendeId: currentUserId, categoriaId: MARKETING_CATEGORY_ID },
            _count: { id: true },
        }),
        prisma.ticket.findMany({
            where: {
                atiendeId: currentUserId,
                categoriaId: MARKETING_CATEGORY_ID,
                estatus: { nombre: { in: ["Nuevo", "En progreso", "En espera"] } },
            },
            orderBy: { fechaalta: "desc" },
            take: 5,
            include: {
                estatus: { select: { nombre: true } },
                empresa: { select: { nombre: true } },
                subcategoria: { select: { nombre: true } },
                solicitante: { select: { nombres: true, apellidos: true } },
            },
        }),
    ]);

    const getPersonalCount = (name: string) => {
        const status = statuses.find((s) => s.nombre === name);
        if (!status) return 0;
        return personalCounts.find((c) => c.estatusId === status.id)?._count.id || 0;
    };

    personalStats = {
        nuevos: getPersonalCount("Nuevo"),
        enProgreso: getPersonalCount("En progreso"),
        enEspera: getPersonalCount("En espera"),
        total: personalCounts.reduce((acc, curr) => acc + curr._count.id, 0),
        solucionados: getPersonalCount("Solucionado"),
        duplicados: getPersonalCount("Duplicado"),
        cancelados: getPersonalCount("Cancelado"),
    };
    recentPersonalTickets = personalRecent;
}

// ── Stats del Solicitante Marketing (solo rol Usuario = 1) ──────────────
let userMktStats = {
    nuevos: 0,
    enProgreso: 0,
    enEspera: 0,
    total: 0,
    solucionados: 0,
    cancelados: 0,
    duplicados: 0,
    sinAsignar: 0,
};
let recentUserMktTickets: any[] = [];

if (rolId === 1 && !isNaN(currentUserId)) {
    const [mktSolCounts, mktSolRecent] = await Promise.all([
        prisma.ticket.groupBy({
            by: ["estatusId"],
            where: { solicitanteId: currentUserId, categoriaId: MARKETING_CATEGORY_ID },
            _count: { id: true },
        }),
        prisma.ticket.findMany({
            where: {
                solicitanteId: currentUserId,
                categoriaId: MARKETING_CATEGORY_ID,
                estatus: { nombre: { in: ["Nuevo", "En progreso", "En espera"] } },
            },
            orderBy: { fechaalta: "desc" },
            take: 5,
            include: {
                estatus: { select: { nombre: true } },
                empresa: { select: { nombre: true } },
                subcategoria: { select: { nombre: true } },
            },
        }),
    ]);

    const getMktSolCount = (name: string) => {
        const status = statuses.find((s) => s.nombre === name);
        if (!status) return 0;
        return mktSolCounts.find((c) => c.estatusId === status.id)?._count.id || 0;
    };

    userMktStats = {
        nuevos: getMktSolCount("Nuevo"),
        enProgreso: getMktSolCount("En progreso"),
        enEspera: getMktSolCount("En espera"),
        total: mktSolCounts.reduce((acc, curr) => acc + curr._count.id, 0),
        solucionados: getMktSolCount("Solucionado"),
        cancelados: getMktSolCount("Cancelado"),
        duplicados: getMktSolCount("Duplicado"),
        sinAsignar: getMktSolCount("Sin asignar"),
    };
    recentUserMktTickets = mktSolRecent;
}
---

<MainLayout title="Dashboard Marketing">
    <div class="w-full max-w-full mx-auto overflow-hidden">
        <h1 class="text-3xl font-bold mb-6">Dashboard Marketing</h1>

        {isAdminOrSuper ? (
            <!-- Layout con Pestañas para Admin/Superadmin -->
            <div>
                <!-- Tab Navigation -->
                <div class="flex items-center gap-1 border-b border-border mb-6">
                    <button
                        id="tab-personal"
                        data-tab="personal"
                        class="tab-btn relative px-5 py-2.5 text-sm font-semibold rounded-t-md transition-colors duration-150 text-primary border-b-2 border-primary bg-card"
                    >
                        <span class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                            Personal
                        </span>
                    </button>
                    <button
                        id="tab-general"
                        data-tab="general"
                        class="tab-btn relative px-5 py-2.5 text-sm font-semibold rounded-t-md transition-colors duration-150 text-muted-foreground border-b-2 border-transparent hover:text-foreground"
                    >
                        <span class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                            General
                        </span>
                    </button>
                </div>

                <!-- ══════ TAB: PERSONAL ══════ -->
                <div id="panel-personal" class="tab-panel">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <!-- 1. Total asignados: Primer lugar, solo informativo sin enlace -->
                        <div class="block">
                            <StatCard title="Total asignados" value={personalStats.total.toString()} description="Todos mis tickets históricos" color={statusColors["Total de Tickets"]} statKey="p-total" />
                        </div>

                        <!-- 2. Mis Nuevos (solo si >= 1) -->
                        {personalStats.nuevos >= 1 && (
                            <a href={`/tickets/marketing?status=${getStatusId("Nuevo")}&assignee=${currentUserId}`} class="block transition-transform hover:scale-105">
                                <StatCard title="Mis Nuevos" value={personalStats.nuevos.toString()} description="Tickets nuevos asignados a mí" color={statusColors["Tickets Nuevos"]} statKey="p-nuevos" />
                            </a>
                        )}

                        <!-- 3. En progreso (solo si >= 1) -->
                        {personalStats.enProgreso >= 1 && (
                            <a href={`/tickets/marketing?status=${getStatusId("En progreso")}&assignee=${currentUserId}`} class="block transition-transform hover:scale-105">
                                <StatCard title="En progreso" value={personalStats.enProgreso.toString()} description="Mis tickets en atención activa" color={statusColors["Tickets En progreso"]} statKey="p-enProgreso" />
                            </a>
                        )}

                        <!-- 4. En espera (solo si >= 1) -->
                        {personalStats.enEspera >= 1 && (
                            <a href={`/tickets/marketing?status=${getStatusId("En espera")}&assignee=${currentUserId}`} class="block transition-transform hover:scale-105">
                                <StatCard title="En espera" value={personalStats.enEspera.toString()} description="Esperando respuesta del solicitante" color={statusColors["Tickets En espera"]} statKey="p-enEspera" />
                            </a>
                        )}

                        <!-- 5. Solucionados (solo si >= 1) -->
                        {personalStats.solucionados >= 1 && (
                            <a href={`/tickets/marketing?status=${getStatusId("Solucionado")}&assignee=${currentUserId}`} class="block transition-transform hover:scale-105">
                                <StatCard title="Solucionados" value={personalStats.solucionados.toString()} description="Tickets resueltos por mí" color={statusColors["Tickets Solucionados"]} statKey="p-solucionados" />
                            </a>
                        )}

                        <!-- 6. Duplicados (solo si >= 1) -->
                        {personalStats.duplicados >= 1 && (
                            <a href={`/tickets/marketing?status=${getStatusId("Duplicado")}&assignee=${currentUserId}`} class="block transition-transform hover:scale-105">
                                <StatCard title="Duplicados" value={personalStats.duplicados.toString()} description="Mis solicitudes duplicadas" color={statusColors["Tickets Duplicados"]} statKey="p-duplicados" />
                            </a>
                        )}

                        <!-- 7. Cancelados (solo si >= 1) -->
                        {personalStats.cancelados >= 1 && (
                            <a href={`/tickets/marketing?status=${getStatusId("Cancelado")}&assignee=${currentUserId}`} class="block transition-transform hover:scale-105">
                                <StatCard title="Cancelados" value={personalStats.cancelados.toString()} description="Tickets cancelados asignados a mí" color={statusColors["Tickets Cancelados"]} statKey="p-cancelados" />
                            </a>
                        )}
                    </div>

                    {recentPersonalTickets.length > 0 && (
                        <div class="mt-8 bg-card border border-border rounded-xl shadow-sm overflow-hidden">
                            <div class="px-5 py-4 border-b border-border flex items-center justify-between">
                                <h2 class="text-sm font-semibold text-foreground flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M9 12h6"/><path d="M12 9v6"/><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/></svg>
                                    Mis tickets activos recientes
                                </h2>
                                <a href="/tickets/marketing/usuario" class="text-xs text-primary hover:underline font-medium">Ver todos →</a>
                            </div>
                            <div class="divide-y divide-border">
                                {recentPersonalTickets.map((ticket) => (
                                    <a
                                        href={`/tickets/view/${ticket.id}?source=marketing_todos`}
                                        class="flex items-center justify-between px-5 py-3 hover:bg-muted/40 transition-colors group"
                                    >
                                        <div class="flex items-center gap-3 min-w-0">
                                            <span class="text-xs font-mono text-muted-foreground shrink-0">#{ticket.id}</span>
                                            <div class="min-w-0">
                                                <p class="text-sm font-medium text-foreground truncate group-hover:text-primary transition-colors">
                                                    {ticket.solicitante?.nombres} {ticket.solicitante?.apellidos}
                                                </p>
                                                <p class="text-xs text-muted-foreground truncate">
                                                    {ticket.empresa?.nombre} · {ticket.subcategoria?.nombre || "Marketing"}
                                                </p>
                                            </div>
                                        </div>
                                        <span class="text-xs font-semibold px-2 py-0.5 rounded-full shrink-0 ml-2" style={`background-color: ${ticket.estatus.nombre === "Nuevo" ? "#a1a1aa" : ticket.estatus.nombre === "En progreso" ? "#3b82f6" : "#38bdf8"}; color: white;`}>
                                            {ticket.estatus.nombre}
                                        </span>
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}
                </div>

                <!-- ══════ TAB: GENERAL ══════ -->
                <div id="panel-general" class="tab-panel hidden">
                    <div id="main-stats" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <!-- 1. Total: solo informativo sin enlace -->
                        <div class="block">
                            <StatCard title="Total de Tickets" value={stats.total.toString()} description="Todos los tickets de Marketing" color={statusColors["Total de Tickets"]} statKey="total" />
                        </div>
                        <!-- 2. Solucionados -->
                        <a href={`/tickets/marketing?status=${getStatusId("Solucionado")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Tickets Solucionados" value={stats.solucionados.toString()} description="Marcados como solucionados" color={statusColors["Tickets Solucionados"]} statKey="solucionados" />
                        </a>
                        <!-- 3. Cancelados -->
                        <a href={`/tickets/marketing?status=${getStatusId("Cancelado")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Tickets Cancelados" value={stats.cancelados.toString()} description="Tickets que no procedieron" color={statusColors["Tickets Cancelados"]} statKey="cancelados" />
                        </a>
                        <!-- 4. Duplicados -->
                        <a href={`/tickets/marketing?status=${getStatusId("Duplicado")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Tickets Duplicados" value={stats.duplicados.toString()} description="Solicitudes duplicadas" color={statusColors["Tickets Duplicados"]} statKey="duplicados" />
                        </a>
                        <!-- 5. Nuevos -->
                        <a href={`/tickets/marketing?status=${getStatusId("Nuevo")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Tickets Nuevos" value={stats.nuevos.toString()} description="Tickets sin atender" color={statusColors["Tickets Nuevos"]} statKey="nuevos" />
                        </a>
                        <!-- 6. En progreso -->
                        <a href={`/tickets/marketing?status=${getStatusId("En progreso")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Tickets En progreso" value={stats.enProgreso.toString()} description="Siendo atendidos activamente" color={statusColors["Tickets En progreso"]} statKey="enProgreso" />
                        </a>
                        <!-- 7. En espera -->
                        <a href={`/tickets/marketing?status=${getStatusId("En espera")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Tickets En espera" value={stats.enEspera.toString()} description="En espera de una respuesta" color={statusColors["Tickets En espera"]} statKey="enEspera" />
                        </a>
                    </div>
                </div>
            </div>
        ) : rolId === 1 ? (
            <!-- Dashboard Marketing: Rol Usuario - solo MIS tickets levantados -->
            <div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Total: siempre visible aunque sea 0 -->
                    <a href="/tickets/marketing/usuario" class="block transition-transform hover:scale-105">
                        <StatCard title="Total" value={userMktStats.total.toString()} description="Todos mis tickets de Marketing" color={statusColors["Total de Tickets"]} statKey="u-mkt-total" />
                    </a>

                    <!-- Tarjetas dinámicas: solo si count > 0 -->
                    {userMktStats.nuevos > 0 && (
                        <a href={`/tickets/marketing/usuario?status=${getStatusId("Nuevo")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Mis nuevos" value={userMktStats.nuevos.toString()} description="Mis tickets sin respuesta" color={statusColors["Tickets Nuevos"]} statKey="u-mkt-nuevos" />
                        </a>
                    )}
                    {userMktStats.enProgreso > 0 && (
                        <a href={`/tickets/marketing/usuario?status=${getStatusId("En progreso")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="En progreso" value={userMktStats.enProgreso.toString()} description="Siendo atendidos activamente" color={statusColors["Tickets En progreso"]} statKey="u-mkt-enProgreso" />
                        </a>
                    )}
                    {userMktStats.enEspera > 0 && (
                        <a href={`/tickets/marketing/usuario?status=${getStatusId("En espera")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="En espera" value={userMktStats.enEspera.toString()} description="Esperando respuesta" color={statusColors["Tickets En espera"]} statKey="u-mkt-enEspera" />
                        </a>
                    )}
                    {userMktStats.solucionados > 0 && (
                        <a href={`/tickets/marketing/usuario?status=${getStatusId("Solucionado")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Solucionados" value={userMktStats.solucionados.toString()} description="Mis tickets resueltos" color={statusColors["Tickets Solucionados"]} statKey="u-mkt-solucionados" />
                        </a>
                    )}
                    {userMktStats.cancelados > 0 && (
                        <a href={`/tickets/marketing/usuario?status=${getStatusId("Cancelado")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Cancelados" value={userMktStats.cancelados.toString()} description="Tickets que no procedieron" color={statusColors["Tickets Cancelados"]} statKey="u-mkt-cancelados" />
                        </a>
                    )}
                    {userMktStats.sinAsignar > 0 && (
                        <a href={`/tickets/marketing/usuario?status=${getStatusId("Sin asignar")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Sin asignar" value={userMktStats.sinAsignar.toString()} description="Pendientes de asignación" color={statusColors["Sin asignar"]} statKey="u-mkt-sinAsignar" />
                        </a>
                    )}
                    {userMktStats.duplicados > 0 && (
                        <a href={`/tickets/marketing/usuario?status=${getStatusId("Duplicado")}`} class="block transition-transform hover:scale-105">
                            <StatCard title="Duplicados" value={userMktStats.duplicados.toString()} description="Solicitudes duplicadas" color={statusColors["Tickets Duplicados"]} statKey="u-mkt-duplicados" />
                        </a>
                    )}

                    <!-- CTA dorada para levantar ticket Marketing -->
                    <a href="/tickets/marketing/nuevo-ticket-marketing" class="block transition-transform hover:scale-105">
                        <div class="relative flex flex-col items-center justify-center gap-3 p-6 rounded-xl border-2 border-primary bg-primary/10 hover:bg-primary/20 transition-colors shadow-sm min-h-[120px] group">
                            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary/20 group-hover:bg-primary/30 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M9 12h6"/><path d="M12 9v6"/><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/></svg>
                            </div>
                            <div class="text-center">
                                <p class="text-sm font-bold text-primary">Levantar ticket</p>
                                <p class="text-xs text-primary/70 mt-0.5">Marketing</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Tickets activos recientes -->
                {recentUserMktTickets.length > 0 ? (
                    <div class="mt-8 bg-card border border-border rounded-xl shadow-sm overflow-hidden">
                        <div class="px-5 py-4 border-b border-border flex items-center justify-between">
                            <h2 class="text-sm font-semibold text-foreground flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M9 12h6"/><path d="M12 9v6"/><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/></svg>
                                Mis tickets activos recientes
                            </h2>
                            <a href="/tickets/marketing/usuario" class="text-xs text-primary hover:underline font-medium">Ver todos →</a>
                        </div>
                        <div class="divide-y divide-border">
                            {recentUserMktTickets.map((ticket) => (
                                <a
                                    href={`/tickets/view/${ticket.id}?source=marketing_todos`}
                                    class="flex items-center justify-between px-5 py-3 hover:bg-muted/40 transition-colors group"
                                >
                                    <div class="flex items-center gap-3 min-w-0">
                                        <span class="text-xs font-mono text-muted-foreground shrink-0">#{ticket.id}</span>
                                        <div class="min-w-0">
                                            <p class="text-sm font-medium text-foreground truncate group-hover:text-primary transition-colors">
                                                {ticket.empresa?.nombre} · {ticket.subcategoria?.nombre || "Marketing"}
                                            </p>
                                        </div>
                                    </div>
                                    <span
                                        class="ml-3 shrink-0 px-2.5 py-0.5 rounded-full text-[11px] font-bold text-white shadow-sm"
                                        style={`background-color: ${ticket.estatus?.nombre === "Nuevo" ? "#a1a1aa" : ticket.estatus?.nombre === "En progreso" ? "#3b82f6" : "#38bdf8"}`}
                                    >
                                        {ticket.estatus?.nombre}
                                    </span>
                                </a>
                            ))}
                        </div>
                    </div>
                ) : (
                    <div class="mt-8 bg-card border border-border rounded-xl p-8 text-center text-muted-foreground text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-muted-foreground/40"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5z"/><polyline points="14 2 14 8 20 8"/></svg>
                        No tienes tickets de Marketing activos en este momento.
                    </div>
                )}
            </div>
        ) : (
            <!-- Vista simple para Marketing agents (no admin) -->
            <div>
                <div id="main-stats" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- 1. Total: solo informativo sin enlace -->
                    <div class="block">
                        <StatCard title="Total de Tickets" value={stats.total.toString()} description="Todos los tickets de Marketing" color={statusColors["Total de Tickets"]} statKey="total" />
                    </div>
                    <!-- 2. Solucionados -->
                    <a href={`/tickets/marketing?status=${getStatusId("Solucionado")}`} class="block transition-transform hover:scale-105">
                        <StatCard title="Tickets Solucionados" value={stats.solucionados.toString()} description="Marcados como solucionados" color={statusColors["Tickets Solucionados"]} statKey="solucionados" />
                    </a>
                    <!-- 3. Cancelados -->
                    <a href={`/tickets/marketing?status=${getStatusId("Cancelado")}`} class="block transition-transform hover:scale-105">
                        <StatCard title="Tickets Cancelados" value={stats.cancelados.toString()} description="Tickets que no procedieron" color={statusColors["Tickets Cancelados"]} statKey="cancelados" />
                    </a>
                    <!-- 4. Duplicados -->
                    <a href={`/tickets/marketing?status=${getStatusId("Duplicado")}`} class="block transition-transform hover:scale-105">
                        <StatCard title="Tickets Duplicados" value={stats.duplicados.toString()} description="Solicitudes duplicadas" color={statusColors["Tickets Duplicados"]} statKey="duplicados" />
                    </a>
                    <!-- 5. Nuevos -->
                    <a href={`/tickets/marketing?status=${getStatusId("Nuevo")}`} class="block transition-transform hover:scale-105">
                        <StatCard title="Tickets Nuevos" value={stats.nuevos.toString()} description="Tickets sin atender" color={statusColors["Tickets Nuevos"]} statKey="nuevos" />
                    </a>
                    <!-- 6. En progreso -->
                    <a href={`/tickets/marketing?status=${getStatusId("En progreso")}`} class="block transition-transform hover:scale-105">
                        <StatCard title="Tickets En progreso" value={stats.enProgreso.toString()} description="Siendo atendidos activamente" color={statusColors["Tickets En progreso"]} statKey="enProgreso" />
                    </a>
                    <!-- 7. En espera -->
                    <a href={`/tickets/marketing?status=${getStatusId("En espera")}`} class="block transition-transform hover:scale-105">
                        <StatCard title="Tickets En espera" value={stats.enEspera.toString()} description="En espera de una respuesta" color={statusColors["Tickets En espera"]} statKey="enEspera" />
                    </a>
                </div>
            </div>
        )}
    </div>
</MainLayout>

<script>
    // Referencia nombrada al listener para poder removerlo en astro:before-preparation
    let mktDashboardSseHandler: ((e: Event) => void) | null = null;

    document.addEventListener("astro:page-load", () => {
        // ── Tab switching ──────────────────────────────────────────
        const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
        const panels = document.querySelectorAll<HTMLElement>(".tab-panel");

        tabBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const target = btn.dataset.tab;
                tabBtns.forEach((b) => {
                    b.classList.remove("text-primary", "border-primary", "bg-card", "border-b-2");
                    b.classList.add("text-muted-foreground", "border-transparent");
                });
                btn.classList.remove("text-muted-foreground", "border-transparent");
                btn.classList.add("text-primary", "border-primary", "bg-card", "border-b-2");
                panels.forEach((p) => {
                    if (p.id === `panel-${target}`) {
                        p.classList.remove("hidden");
                    } else {
                        p.classList.add("hidden");
                    }
                });
            });
        });

        // ── Real-time updates via SSE bus ──────────────────────────
        const updateStats = async () => {
            try {
                const response = await fetch("/api/dashboard/stats-marketing");
                if (!response.ok) return;
                const data = await response.json();
                const updateEl = (key: string, value: any) => {
                    const el = document.querySelector(`[data-stat-key="${key}"]`);
                    if (el) el.textContent = value.toString();
                };
                updateEl("nuevos", data.nuevos);
                updateEl("enProgreso", data.enProgreso);
                updateEl("enEspera", data.enEspera);
                updateEl("total", data.total);
                updateEl("solucionados", data.solucionados);
                updateEl("duplicados", data.duplicados);
                updateEl("cancelados", data.cancelados);
            } catch (error) {
                console.error("Error updating dashboard stats:", error);
            }
        };

        const userId = document.body.dataset.userId;
        if (userId) {
            // Remover listener anterior si existe (evitar duplicados en View Transitions)
            if (mktDashboardSseHandler) {
                window.removeEventListener("siget:sse-event", mktDashboardSseHandler);
            }

            // Suscribirse al bus global de SSE emitido por MainLayout.astro
            // SIN abrir un nuevo EventSource (MainLayout ya gestiona la conexión única)
            mktDashboardSseHandler = (e: Event) => {
                const data = (e as CustomEvent).detail;
                if (["ticket_created", "ticket_updated", "ticket_assigned"].includes(data.type)) {
                    updateStats();
                }
            };
            window.addEventListener("siget:sse-event", mktDashboardSseHandler);
        }
    });

    document.addEventListener("astro:before-preparation", () => {
        // Limpiar el listener al abandonar la página
        if (mktDashboardSseHandler) {
            window.removeEventListener("siget:sse-event", mktDashboardSseHandler);
            mktDashboardSseHandler = null;
        }
    });
</script>
