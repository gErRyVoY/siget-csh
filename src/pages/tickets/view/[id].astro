---
import MainLayout from "@/layouts/MainLayout.astro";
import { prisma } from "@/lib/db";
import {
    type Ticket,
    type Empresa,
    type Estatus,
    Prioridad,
    type HistorialSolicitud,
} from "@prisma/client";
import {
    getCampusesActivos,
    getCarrerasActivas,
    getDescuentosActivos,
    getEstatus,
    getRutaSubcategoria,
} from "@/lib/reference-data";
import {
    campusOptions,
    carreraOptions,
    bloqueOptions,
} from "@/config/form-options";
import { MARKETING_CATEGORY_ID } from "@/config/ticket-categories";
import { buildManuallyAssignableWhere, canAssignMarketingTickets } from "@/services/ticketAssignmentService";

const { id } = Astro.params;
if (!id) {
    return Astro.redirect("/404");
}

const ticketId = parseInt(id, 10);

const S3_BUCKET_URL = `https://${import.meta.env.S3_BUCKET_NAME}.s3.${import.meta.env.S3_REGION}.amazonaws.com`;

// Google Drive credentials — usar process.env para leer en RUNTIME.
// IMPORTANTE: import.meta.env es reemplazado estáticamente por Vite en build-time.
// Si las variables no existen durante el build (Docker), quedan como string vacío.
// process.env sí lee del entorno real del proceso Node.js en producción.
const GOOGLE_API_KEY_SERVER = process.env.GOOGLE_API_KEY || '';
const GOOGLE_CLIENT_ID_SERVER = process.env.GOOGLE_CLIENT_ID || '';
const GOOGLE_APP_ID_SERVER = process.env.GOOGLE_APP_ID || '';

const ALLOWED_STATUSES = [
    "Sin asignar",
    "Nuevo",
    "En progreso",
    "En espera",
    "Solucionado",
    "Cancelado",
    "Duplicado",
];
const statusColors: { [key: string]: string } = {
    Nuevo: "#a1a1aa",
    "En progreso": "#3b82f6",
    "En espera": "#38bdf8",
    Solucionado: "#84cc16",
    Cancelado: "#dc2626",
    Duplicado: "#171717",
};

// El ticket, su historial y el catálogo de estatus no dependen entre sí, así que
// van en paralelo. El comentario que había aquí («consultas secuenciales para
// evitar el agotamiento del connection pool») dejó de aplicar cuando el
// DATABASE_URL pasó a connection_limit=30.
const [ticket, ticketHistory, todosLosEstatus] = await Promise.all([
    prisma.ticket.findUnique({
        where: { id: ticketId },
        // Con la estrategia por defecto este include eran 14 sentencias (una por
        // relación, incluidas las cinco anidadas del traslado); con `join` es una.
        relationLoadStrategy: 'join',
        include: {
            estatus: true,
            categoria: true,
            subcategoria: true,
            solicitante: { include: { empresa: true } },
            atiende: true,
            empresa: true,
            traslados: {
                include: {
                    origen: true,
                    destino: true,
                    carrera: {
                        include: {
                            oferta: true,
                        }
                    },
                    descuento: true,
                    bloque: true,
                }
            },
        },
    }),
    prisma.historialSolicitud.findMany({
        where: { ticketId: ticketId },
        include: {
            usuario: { select: { nombres: true, apellidos: true } },
            estatus: { select: { nombre: true } },
        },
        orderBy: { fecha_cambio: "desc" },
    }),
    getEstatus(),
]);

if (!ticket) {
    return Astro.redirect("/404");
}

// Reutilizar sesión resuelta por middleware.ts (evita N+1 a la BD por navegación)
const session = Astro.locals.session;
const PRIVILEGED_ROLES = [2, 3]; // admin y superadmin

const userRoleId = session?.user?.rol?.id ?? -1;
const userId = session?.user?.id ? parseInt(String(session.user.id), 10) : -1;
const isPrivileged = PRIVILEGED_ROLES.includes(userRoleId);
const isMktAgent = (session?.user as any)?.atiende_mkt === true;
const isSuperAdmin = userRoleId === 3;
const isAdmin = userRoleId === 2;

// --- Control de Acceso a nivel de ticket ---
// Determinar si el usuario puede ver este ticket:
// 1. Es el solicitante que lo levantó (siempre puede verlo)
// 2. Tiene rol privilegiado CSH y el ticket NO es de Marketing
// 3. Tiene rol de Marketing y el ticket SÍ es de Marketing
const isOwner = ticket.solicitanteId === userId;
const isMktTicket = ticket.categoriaId === MARKETING_CATEGORY_ID;

// Los tickets de Marketing no se asignan solos: entran «Sin asignar» y el equipo
// hace el triaje (ver PASO 0 de `findBestAgentHybrid`). Con la regla de admin de
// abajo —«sólo si el ticket ya está asignado a mí»— nadie del equipo podía dar el
// primer paso, porque un ticket sin dueño nunca la cumple: sólo un superadmin
// podía repartirlos. Así que mientras siga sin asignar, cualquier admin del
// equipo de Marketing puede asignárselo o asignarlo a otra persona del equipo.
// Se incluye al solicitante a propósito: excluirlo devolvería al mismo bloqueo
// cuando quien levanta el ticket es del propio equipo.
const puedeTriarMarketing =
    isPrivileged && isMktTicket && ticket.atiendeId === null
        ? await canAssignMarketingTickets(userId)
        : false;

// Lógica de edición del campo Atiende:
// - Superadmin: siempre puede reasignar
// - Admin: solo si el ticket está asignado a él mismo (y no es el creador)
// - Equipo de Marketing: si el ticket de Marketing está sin asignar
// - Resto: no puede cambiar Atiende
const canEditAtiende: boolean =
    isSuperAdmin ||
    (isAdmin && !isOwner && ticket.atiendeId === userId) ||
    puedeTriarMarketing;
const canViewAsCsh = isPrivileged && !isMktTicket;
const canViewAsMkt = isMktAgent && isMktTicket;

if (!isOwner && !canViewAsCsh && !canViewAsMkt) {
    Astro.cookies.set('siget_flash_unauthorized', '1', {
        path: '/',
        maxAge: 30,
        sameSite: 'lax',
        httpOnly: false,
        secure: false,
    });
    return Astro.redirect("/");
}

const isReadOnly = false; // Reverted: Allow editing for all statuses

const isTraslado = ticket.traslados != null;
const traslado = ticket.traslados ?? null;

type OpcionAutocompletado = { id: number; label: string };
type PersonaOpcion = { id: number; nombres: string; apellidos: string };

/**
 * Agentes del desplegable «Atiende». Sólo los ven los usuarios privilegiados; el
 * resto ve únicamente al agente actual, sin consultar nada.
 *
 * El criterio vive en `buildManuallyAssignableWhere` para que sea literalmente el
 * mismo que valida el PATCH (`canAgentBeAssignedManually`): antes eran dos reglas
 * distintas y el desplegable ofrecía candidatos que el guardado rechazaba con 400.
 */
function cargarAgentesAsignables(): Promise<PersonaOpcion[]> {
    if (!isPrivileged) return Promise.resolve([]);

    // Se copian fuera del `where` porque TypeScript no arrastra el estrechamiento
    // de `ticket` (no nulo desde el redirect a /404) al interior de la función.
    const categoriaId = ticket!.categoriaId;
    const subcategoriaId = ticket!.subcategoriaId;

    return prisma.usuario.findMany({
        where: buildManuallyAssignableWhere(categoriaId, subcategoriaId, isMktTicket),
        select: { id: true, nombres: true, apellidos: true },
        orderBy: { nombres: "asc" }
    });
}

/**
 * Catálogos y auditores que sólo usa la vista de traslados. Antes se cargaban al
 * principio de la página —campus, carreras y descuentos— en toda petición, incluso
 * para tickets normales, junto con los dos catálogos de auditores. Ahora sólo se
 * piden si el ticket es un traslado, y los tres catálogos salen del caché de
 * catálogos (src/lib/reference-data.ts).
 */
async function cargarDatosDeTraslado() {
    if (!isTraslado) {
        return {
            campuses: [] as Empresa[],
            mappedCampuses: [] as OpcionAutocompletado[],
            mappedCarreras: [] as OpcionAutocompletado[],
            mappedDescuentos: [] as OpcionAutocompletado[],
            auditoresDocs: [] as PersonaOpcion[],
            auditoresReq: [] as PersonaOpcion[],
        };
    }

    const [campuses, carreras, descuentos, auditoresDocs, auditoresReq] =
        await Promise.all([
            getCampusesActivos(),
            getCarrerasActivas(),
            getDescuentosActivos(),
            prisma.usuario.findMany({
                where: { empresaId: 15, activo: true, auditor_docs: true },
                select: { id: true, nombres: true, apellidos: true },
            }),
            prisma.usuario.findMany({
                where: { empresaId: 15, activo: true, auditor_req: true },
                select: { id: true, nombres: true, apellidos: true },
            }),
        ]);

    return {
        campuses,
        mappedCampuses: campuses.map((c) => ({ id: c.id, label: c.nombre })),
        mappedCarreras: carreras.map((c) => {
            let label = c.descripcion;
            if (c.oferta.descripcion.includes("Licenciatura")) label = `Licenciatura en ${label}`;
            else if (c.oferta.descripcion.includes("Maestría")) label = `Maestría en ${label}`;
            else if (c.oferta.descripcion.includes("Doctorado")) label = `Doctorado en ${label}`;
            return { id: c.id, label };
        }),
        mappedDescuentos: descuentos.map((d) => ({ id: d.id, label: d.descripcion })),
        auditoresDocs,
        auditoresReq,
    };
}

// Ninguna de las tres cosas depende de las otras: un solo viaje en paralelo en
// lugar de tres bloques en serie. Y van después del control de acceso, así que una
// petición no autorizada ya no paga estas consultas.
const [targetAgents, agentesAsignables, datosTraslado] = await Promise.all([
    // Emails de agentes para permisos de Drive
    prisma.usuario.findMany({
        where: {
            activo: true,
            mail: { not: '' },
            ...(isMktTicket ? { atiende_mkt: true } : { atiende_csh: true }),
        },
        select: { mail: true },
    }),
    cargarAgentesAsignables(),
    cargarDatosDeTraslado(),
]);

const targetAgentEmails = targetAgents
    .map((u) => u.mail)
    .filter(Boolean) as string[];

const allCampuses = datosTraslado.campuses;
const mappedCampuses = datosTraslado.mappedCampuses;
const mappedCarreras = datosTraslado.mappedCarreras;
const mappedDescuentos = datosTraslado.mappedDescuentos;
const cshAuditorDocs = datosTraslado.auditoresDocs;
const cshAuditorReq = datosTraslado.auditoresReq;

// La ruta de la subcategoría se recorre en memoria sobre el caché de catálogos.
// Antes este bloque emitía una consulta por cada nivel de la jerarquía (N+1).
const breadcrumbPath = [ticket.categoria.nombre];
if (ticket.subcategoria) {
    breadcrumbPath.push(...(await getRutaSubcategoria(ticket.subcategoria.id)));
}

const priorities = Object.values(Prioridad);

// Los estatus salen del caché de catálogos. Se ordenan por id para conservar el
// orden que devolvía la consulta sin ORDER BY (1 Sin asignar … 7 Duplicado).
let statuses: Estatus[] = todosLosEstatus
    .filter((s) => ALLOWED_STATUSES.includes(s.nombre))
    .sort((a, b) => a.id - b.id);

let agents: PersonaOpcion[] = agentesAsignables;

if (!isPrivileged) {
    // Regular users only see the current agent (if any)
    agents = ticket.atiende ? [ticket.atiende] : [];

    // Regular users can only see 'Duplicado', 'Nuevo', or 'Sin asignar' if it's currently the ticket's status
    statuses = statuses.filter(
        (s) =>
            (s.nombre !== "Duplicado" || ticket.estatus.nombre === "Duplicado") &&
            (s.nombre !== "Nuevo" || ticket.estatus.nombre === "Nuevo") &&
            (s.nombre !== "Sin asignar" || ticket.estatus.nombre === "Sin asignar")
    );
}

const parseFileName = (key: string) => {
    if (!key) return "archivo-desconocido";
    return key.split("/").pop()?.split("-").slice(1).join("-") || key;
};

const source = Astro.url.searchParams.get("source");
const backLink =
    source === "mis-tickets" ? "/tickets/soporte/usuario" :
    source === "todos" ? "/tickets/soporte" :
    source === "marketing_todos" ? "/tickets/marketing" :
    source === "marketing_usuario" ? "/tickets/marketing/usuario" :
    "/tickets/soporte";

let afectadoLabel = "Clave";
let nombreLabel = "Nombre del Afectado";

if (ticket.categoriaId === 1) {
    afectadoLabel = "Matrícula";
    nombreLabel = "Nombre del Alumno";
} else if (ticket.categoriaId === 2) {
    afectadoLabel = "Folio";
    nombreLabel = "Nombre del Aspirante";
} else if (ticket.categoriaId === 3) {
    nombreLabel = "Nombre del Colaborador";
} else if (ticket.categoriaId === 4) {
    nombreLabel = "Nombre del Docente";
}

const fieldMap: Record<string, string> = {
    prioridad: "Prioridad",
    estatusId: "Estatus",
    atiendeId: "Atiende",
    archivado: "Archivado",
    afectado_clave: afectadoLabel,
    afectado_nombre: nombreLabel,
    descripcion: "Descripción",
    // Traslados keys
    matricula: "Matrícula",
    alumno: "Nombre Alumno",
    nuevo_ingreso: "Nuevo Ingreso",
    bloque_nombre: "Bloque",
    origen_nombre: "Campus Origen",
    destino_nombre: "Campus Destino",
    carrera_nombre: "Carrera",
    descuento_nombre: "Descuento",
    validacion_docs: "Validación Documentos",
    descripcion_docs: "Comentarios Documentos",
    validacion_edocta: "Validación Adeudo Financiero",
    descripcion_edocta: "Comentarios Edo. Cta.",
    validacion_calif: "Validación Adeudo Escolar",
    descripcion_calif: "Comentarios Académicos",
    auditor_docs: "Auditor Documentos",
    auditor_req: "Auditor Requisitos/Adeudos",
};

const currentUserId = userId; // Alias: userId ya declarado en el bloque de access control

// Permission Logic for Auditors
const canEditDocs = isPrivileged || (traslado && traslado.auditor_docsId === currentUserId);
const canEditReq = isPrivileged || (traslado && traslado.auditor_reqId === currentUserId);

const ofertaDesc = traslado?.carrera?.oferta?.descripcion || "";
let carreraDisplayValue = traslado?.carrera?.descripcion || "";
if (ofertaDesc.includes("Licenciatura")) carreraDisplayValue = `Licenciatura en ${carreraDisplayValue}`;
else if (ofertaDesc.includes("Maestría")) carreraDisplayValue = `Maestría en ${carreraDisplayValue}`;
else if (ofertaDesc.includes("Doctorado")) carreraDisplayValue = `Doctorado en ${carreraDisplayValue}`;

const groupB = [
    "Licenciatura en Arquitectura",
    "Licenciatura en Arte y Teatro",
    "Licenciatura en Diseño Gráfico",
];
const isInitialEscolarizada = carreraDisplayValue.toLowerCase().includes("escolarizada") || groupB.includes(carreraDisplayValue);
---

<MainLayout title={`Ticket #${isTraslado ? "TRL-" : ""}${ticket.id}`}>
    <style>
        @keyframes flash {
            0% {
                background-color: transparent;
            }
            50% {
                background-color: var(--muted);
            }
            100% {
                background-color: transparent;
            }
        }
        .flash-animation {
            animation: flash 1s ease-in-out;
        }
        @media (max-width: 1119px) {
            #action-buttons-container.has-files {
                flex-direction: column;
                align-items: end;
                width: calc(2 / 5 * 100%);
            }
            #action-buttons-container.has-files #submit-button {
                order: 1;
            }
            #action-buttons-container.has-files #upload-files-button {
                order: 2;
            }
            #action-buttons-container.has-files #delete-files-button {
                order: 3;
            }
            #action-buttons-container.has-files #help-text {
                order: 4;
                text-align: right;
            }
        }
    </style>
    <div class="max-w-4xl mx-auto">
        <div class="mb-4 text-sm text-muted-foreground">
            {breadcrumbPath.join(" > ")}
        </div>

        <form 
            id="edit-ticket-form"
            data-campus-list={JSON.stringify(mappedCampuses)}
            data-carrera-list={JSON.stringify(mappedCarreras)}
            data-descuento-list={JSON.stringify(mappedDescuentos)}
            data-bloque-options={JSON.stringify(bloqueOptions)}
            data-api-key={GOOGLE_API_KEY_SERVER}
            data-client-id={GOOGLE_CLIENT_ID_SERVER}
            data-app-id={GOOGLE_APP_ID_SERVER}
            data-agent-emails={targetAgentEmails.join(',')}
        >
            <div class="bg-card border border-secondary rounded-lg p-4 mb-4">
                {isTraslado && traslado ? (
                    /* --- VISTA TRASLADOS (EDITABLE) --- */
                    <div class="space-y-6">
                        {/* Hidden Inputs for IDs */}
                        <input type="hidden" name="origenId" id="origenId" value={traslado.origenId ?? ''} />
                        <input type="hidden" name="destinoId" id="destinoId" value={traslado.destinoId ?? ''} />
                        <input type="hidden" name="carreraId" id="carreraId" value={traslado.carreraId ?? ''} />
                        <input type="hidden" name="descuentoId" id="descuentoId" value={traslado.descuentoId ?? ''} />
                        {/* Header: Back Button & Status & Save */}
                        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
                            <div class="flex justify-end items-center lg:justify-start gap-4 w-full">
                                <a
                                    href={backLink}
                                    class="bg-muted-foreground text-white hover:bg-muted-foreground/90 px-6 py-2 rounded-md text-sm font-semibold transition-colors shrink-0"
                                >
                                    Volver a la lista
                                </a>
                                {/* Only show Save button if privileged or owner (handled by logic usually, but here checking privilege for layout) */}
                                {(isPrivileged || isOwner) && (
                                    <button
                                        type="button"
                                        id="btn-save-transfer-changes"
                                        class="bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-2 rounded-md text-sm font-semibold shadow transition-colors"
                                    >
                                        Guardar cambios
                                    </button>
                                )}
                            </div>
                            
                            <div class="flex items-center gap-4 w-full justify-end">
                                <div>
                                    <label for="prioridad" class="block text-xs font-medium text-muted-foreground text-right mb-1">Prioridad</label>
                                    <select
                                        id="prioridad"
                                        name="prioridad"
                                        class="block w-32 rounded-md border-border bg-input p-2 text-sm"
                                        disabled={!isPrivileged}
                                    >
                                        {priorities.map((p) => (
                                            <option value={p} selected={p === ticket.prioridad}>{p}</option>
                                        ))}
                                    </select>
                                </div>
                                <div>
                                    <label for="estatusId" class="block text-xs font-medium text-muted-foreground text-right mb-1">Estatus</label>
                                    <select
                                        id="estatusId"
                                        name="estatusId"
                                        class="block w-40 rounded-md border-border p-2 text-sm font-medium"
                                        style={`background-color: ${(ticket.estatus.nombre === "Nuevo" && !ticket.atiendeId) ? "var(--primary)" : (statusColors[ticket.estatus.nombre] || "#a1a1aa")}; color: white;`}
                                        disabled={!isPrivileged && !isOwner}
                                    >
                                        {statuses.map((s) => {
                                            let label = s.nombre;
                                            let color = statusColors[s.nombre] || "#a1a1aa";
                                            if (s.nombre === "Nuevo" && !ticket.atiendeId) {
                                                label = "Sin asignar";
                                                color = "var(--primary)";
                                            }
                                            return (
                                                <option 
                                                    value={s.id} 
                                                    selected={s.id === ticket.estatusId} 
                                                    style={`background-color: ${color}; color: white;`}
                                                >
                                                    {label}
                                                </option>
                                            );
                                        })}
                                    </select>
                                </div>
                            </div>
                        </div>

                         <div id="transfer-edit-fields" class="space-y-6">
                            {/* Student Info */}
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-b border-border pb-6">
                                <div>
                                    <label for="matricula" class="block text-xs font-medium text-muted-foreground mb-1">Matrícula</label>
                                    <input 
                                        type="text" 
                                        id="matricula" 
                                        name="matricula" 
                                        value={traslado.matricula} 
                                        class="w-full rounded-md border-border bg-input px-3 py-2 text-sm disabled:bg-muted disabled:cursor-not-allowed disabled:opacity-80"
                                        disabled={!isPrivileged}
                                    />
                                </div>
                                <div>
                                    <label for="alumno" class="block text-xs font-medium text-muted-foreground mb-1">Nombre del alumno</label>
                                    <input 
                                        type="text" 
                                        id="alumno" 
                                        name="alumno" 
                                        value={traslado.alumno} 
                                        class="w-full rounded-md border-border bg-muted px-3 py-2 text-sm cursor-not-allowed opacity-80"
                                        disabled
                                    />
                                </div>
                            </div>

                            {/* Campus Info */}
                             <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-b border-border pb-6">
                                <div class="relative">
                                    <label for="campus-origen" class="block text-xs font-medium text-muted-foreground mb-1">Campus origen</label>
                                    <input type="hidden" id="origenId" name="origenId" value={traslado.origenId || ''} />
                                    {(() => {
                                        const isVirtual = (traslado.origen?.nombre || '').toLowerCase() === "virtual";
                                        const allowsVirtual = Boolean(traslado.origen?.tckt_virtual);
                                        const virtualCampus = allCampuses.find(c => c.nombre.toLowerCase() === "virtual");
                                        const virtualEmpresas = allCampuses.filter(c => c.tckt_virtual && c.nombre.toLowerCase() !== "virtual");

                                        if (!isVirtual && !allowsVirtual) {
                                            return (
                                                <input 
                                                    type="text" 
                                                    id="campus-origen" 
                                                    name="campus-origen" 
                                                    value={traslado.origen?.nombre} 
                                                    class="w-full rounded-md border-border bg-muted px-3 py-2 text-sm cursor-not-allowed opacity-80"
                                                    disabled
                                                />
                                            );
                                        } else if (!isVirtual && allowsVirtual) {
                                            return (
                                                <select 
                                                    id="campus-origen" 
                                                    name="campus-origen" 
                                                    class="w-full rounded-md border-border bg-input px-3 py-2 text-sm disabled:bg-muted disabled:cursor-not-allowed disabled:opacity-80"
                                                    disabled={!isPrivileged}
                                                >
                                                    <option value={traslado.origen?.nombre} data-id={traslado.origen?.id} selected>{traslado.origen?.nombre}</option>
                                                    <option value="Virtual" data-id={virtualCampus?.id || 13}>Virtual</option>
                                                </select>
                                            );
                                        } else {
                                            return (
                                                <select 
                                                    id="campus-origen" 
                                                    name="campus-origen" 
                                                    class="w-full rounded-md border-border bg-input px-3 py-2 text-sm disabled:bg-muted disabled:cursor-not-allowed disabled:opacity-80"
                                                    disabled={!isPrivileged}
                                                >
                                                    <option value="Virtual" data-id={traslado.origen?.id || virtualCampus?.id || 13} selected>Virtual</option>
                                                    {virtualEmpresas.map(emp => (
                                                        <option value={emp.nombre} data-id={emp.id}>{emp.nombre}</option>
                                                    ))}
                                                </select>
                                            );
                                        }
                                    })()}
                                </div>
                                <div class="relative">
                                    <label for="campus-destino" class="block text-xs font-medium text-muted-foreground mb-1">Campus destino</label>
                                    <input type="hidden" id="destinoId" name="destinoId" value={traslado.destinoId || ''} />
                                    <input 
                                        type="text" 
                                        id="campus-destino" 
                                        name="campus-destino" 
                                        value={traslado.destino?.nombre} 
