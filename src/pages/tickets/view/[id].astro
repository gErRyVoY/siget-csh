                                    <div>
                                        <strong class="text-foreground">Google Workspace:</strong>
                                        <p class="text-[11px] leading-tight mt-0.5">Documentos, Hojas de cálculo y Presentaciones de Google Drive.</p>
                                    </div>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-primary font-bold">🎥</span>
                                    <div>
                                        <strong class="text-foreground">Videos (Google Drive):</strong>
                                        <p class="text-[11px] leading-tight mt-0.5">.mp4, .avi, .mov, .hevc, .3gp y video/* (compartición hasta 5 videos).</p>
                                    </div>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-primary font-bold">📁</span>
                                    <div>
                                        <strong class="text-foreground">Carpetas (Google Drive):</strong>
                                        <p class="text-[11px] leading-tight mt-0.5">Selección y compartición directa de hasta 5 carpetas de Drive.</p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <input type="file" id="file-input" multiple class="hidden" />

        <div class="bg-card border border-secondary rounded-lg p-8">
            <div class="mb-6">
                <label
                    for="new-comment"
                    class="block text-sm font-medium text-muted-foreground mb-2"
                    >Añadir comentario</label
                >
                <textarea
                    id="new-comment"
                    name="new-comment"
                    rows="3"
                    class="w-full rounded-md border-border bg-input p-2 text-sm"
                    placeholder="Escribe un comentario..."></textarea>

                <!-- Recursos de Google Drive (Carpetas y Videos) -->
                <div id="drive-resources-section" class="hidden mt-3 space-y-3">
                    <div id="drive-folders-list" class="space-y-2"></div>
                    <div id="drive-videos-list" class="space-y-2"></div>
                </div>
            </div>
            <ul class="space-y-6">
                {
                    ticketHistory.length > 0 ? (
                        ticketHistory.map((entry, index) => {
                            const hasFiles =
                                entry.archivos &&
                                (entry.archivos as any).newFiles &&
                                (entry.archivos as any).newFiles.length > 0;
                            const fieldChanges =
                                (entry.cambios as any)?.fieldChanges || [];
                            return (
                                <li
                                    class="flex gap-4 border-t border-border pt-4 first:pt-0 first:border-t-0"
                                    data-history-entry={
                                        index === 0 ? "true" : "false"
                                    }
                                >
                                    <div class="grow">
                                        <div class="flex justify-between items-center">
                                            <p class="font-semibold text-sm">
                                                {entry.usuario.nombres}{" "}
                                                {entry.usuario.apellidos}
                                            </p>
                                            <p class="text-sm text-muted-foreground">
                                                {new Date(
                                                    entry.fecha_cambio,
                                                ).toLocaleString("es-MX", {
                                                    dateStyle: "full",
                                                    timeStyle: "short",
                                                })}
                                            </p>
                                        </div>
                                        <div class="flex items-center gap-4 mt-1">
                                            {entry.estatus && (
                                                <span
                                                    style={`background-color: ${statusColors[entry.estatus.nombre] || "#a1a1aa"};`}
                                                    class="px-2 py-1 text-xs font-bold text-white rounded-full border border-transparent dark:border-white/20"
                                                >
                                                    {entry.estatus.nombre}
                                                </span>
                                            )}
                                            {hasFiles && (
                                                <div class="relative">
                                                    <button
                                                        type="button"
                                                        class="attachment-clip cursor-pointer"
                                                        aria-expanded="false"
                                                    >
                                                        <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            width="20"
                                                            height="20"
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="2"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                        >
                                                            <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.59a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                                                        </svg>
                                                    </button>
                                                    <div class="attachment-dropdown hidden absolute z-10 bg-card border rounded-md shadow-lg mt-1 py-1 w-72 max-w-[80vw] md:w-96">
                                                        {(
                                                            entry.archivos as any
                                                        ).newFiles.map(
                                                            (key: string) => (
                                                                <a
                                                                    href="#"
                                                                    data-key={
                                                                        key
                                                                    }
                                                                    class="attachment-link block px-4 py-1 text-sm text-card-foreground hover:underline hover:text-[#722f37]"
                                                                >
                                                                    {parseFileName(
                                                                        key,
                                                                    )}
                                                                </a>
                                                            ),
                                                        )}
                                                    </div>
                                                </div>
                                            )}
                                        </div>
                                        {entry.comentario && (
                                            <p class="mt-2 text-sm p-3 bg-muted/50 rounded-md">
                                                {entry.comentario}
                                            </p>
                                        )}
                                        {fieldChanges.length > 0 && isPrivileged && (
                                            <div class="mt-2 text-xs p-2 bg-blue-50 border border-blue-200 dark:bg-blue-900/20 dark:border-blue-800 rounded-md">
                                                <p class="font-semibold mb-1">
                                                    Cambios de campos:
                                                </p>
                                                {fieldChanges.map(
                                                    (change: any) => (
                                                        <p>
                                                            {`• `}
                                                            <span class="font-semibold capitalize">
                                                                {fieldMap[
                                                                    change.field
                                                                ] ||
                                                                    change.field}
                                                                :
                                                            </span>
                                                            {` '${String(change.oldValue)}' → '${String(change.newValue)}'`}
                                                        </p>
                                                    ),
                                                )}
                                            </div>
                                        )}
                                    </div>
                                </li>
                            );
                        })
                    ) : (
                        <p class="text-center text-muted-foreground">
                            No hay historial de cambios para este ticket.
                        </p>
                    )
                }
            </ul>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div
        id="delete-confirmation-modal"
        class="fixed inset-0 z-50 items-center justify-center hidden"
        role="dialog"
        aria-modal="true"
    >
        <div
            class="absolute inset-0 bg-black/50 backdrop-blur-sm"
            id="delete-modal-overlay"
        >
        </div>
        <div
            class="relative bg-card border border-border rounded-lg shadow-lg p-6 w-full max-w-sm mx-4"
        >
            <h3 class="text-lg font-semibold mb-2">Elige el tipo de borrado</h3>
            <p class="text-sm text-muted-foreground mb-6">
                ¿Deseas eliminar todos los archivos adjuntos o seleccionar
                cuáles borrar?
            </p>
            <div class="flex flex-col gap-3">
                <button
                    id="confirm-delete-all"
                    class="w-full bg-destructive text-destructive-foreground hover:bg-destructive/90 px-4 py-2 rounded-md text-sm font-semibold transition-colors"
                >
                    Borrar todos
                </button>
                <button
                    id="confirm-delete-select"
                    class="w-full bg-secondary text-secondary-foreground hover:bg-secondary/80 px-4 py-2 rounded-md text-sm font-semibold transition-colors"
                >
                    Seleccionar
                </button>
                <button
                    id="cancel-delete-modal"
                    class="w-full bg-muted text-muted-foreground hover:bg-muted/80 px-4 py-2 rounded-md text-sm font-semibold transition-colors"
                >
                    Cancelar
                </button>
            </div>
        </div>
    </div>

    <!-- Status Change Confirmation Modal -->
    <div
        id="status-change-confirmation-modal"
        class="fixed inset-0 z-50 items-center justify-center hidden"
        role="dialog"
        aria-modal="true"
    >
        <div
            class="absolute inset-0 bg-black/50 backdrop-blur-sm"
            id="status-change-modal-overlay"
        >
        </div>
        <div
            class="relative bg-card border border-border rounded-lg shadow-lg p-6 w-full max-w-sm mx-4"
        >
            <h3 class="text-lg font-semibold mb-2">Confirmación de Estatus</h3>
            <p class="text-sm text-muted-foreground mb-6">
                ¿Desea cambiar el estatus del ticket a "En espera"?
            </p>
            <div class="flex gap-3">
                <button
                    id="confirm-status-change-yes"
                    class="flex-1 bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 rounded-md text-sm font-semibold transition-colors"
                >
                    Sí
                </button>
                <button
                    id="confirm-status-change-no"
                    class="flex-1 bg-secondary text-secondary-foreground hover:bg-secondary/80 px-4 py-2 rounded-md text-sm font-semibold transition-colors"
                >
                    No
                </button>
            </div>
        </div>
    </div>

</MainLayout>
<script
    define:vars={{
        ticketId,
        ticket,
        statuses,
        currentUserId: session?.user?.id,
        accessToken: session?.accessToken,
        canEditAtiende,
    }}
>
    window.ticketViewData = {
        ticketId,
        ticket,
        statuses,
        accessToken: accessToken || "",
        currentUserId: currentUserId ? parseInt(currentUserId, 10) : null,
        isCreator: currentUserId
            ? parseInt(currentUserId, 10) === ticket.solicitanteId
            : false,
        canEditAtiende,
    };
</script>
<script>
    import {
        init,
        initEditForm,
        initFileUploads,
        initHistoryToggles,
        initStatusColorizer,
        handleNewHistoryEntry,
    } from "@/scripts/ticket-view-logic.ts";
    import { toast } from "@/lib/toast";
    import { navigate } from "astro:transitions/client";

    document.addEventListener("astro:page-load", () => {
        init();
        initEditForm();
        initFileUploads();
        initHistoryToggles();
        initStatusColorizer();
        handleNewHistoryEntry();

        // --- TRASLADOS EDIT LOGIC ---
        const initTransferLogic = () => {
            const transferForm = document.getElementById("edit-ticket-form") as HTMLFormElement | null;
            if (!transferForm) return;

            // Parse Options & Maps
            const campusOptions: string[] = JSON.parse(transferForm.dataset.campusOptions || "[]");
            const carreraOptions: string[] = JSON.parse(transferForm.dataset.carreraOptions || "[]");
            const bloqueOptionsFull: string[] = JSON.parse(transferForm.dataset.bloqueOptions || "[]");
            const descuentoOptions: string[] = JSON.parse(transferForm.dataset.descuentoOptions || "[]");
            const mappedCampusesList: { id: number; label: string }[] = JSON.parse(transferForm.dataset.campusList || "[]");
            const mappedCarrerasList: { id: number; label: string }[] = JSON.parse(transferForm.dataset.carreraList || "[]");

            const matriculaInput = document.getElementById("matricula") as HTMLInputElement | null;
            const alumnoInput = document.getElementById("alumno") as HTMLInputElement | null;
            const carreraInput = document.getElementById("carrera") as HTMLInputElement | null;
            const carreraIdInput = document.getElementById("carreraId") as HTMLInputElement | null;
            const escolarizadaContainer = document.getElementById("escolarizada-container");
            const escolarizadaCheckbox = document.getElementById("escolarizada") as HTMLInputElement | null;
            const campusOrigenEl = document.getElementById("campus-origen") as (HTMLInputElement | HTMLSelectElement) | null;
            const origenIdHidden = document.getElementById("origenId") as HTMLInputElement | null;
            const campusDestinoInput = document.getElementById("campus-destino") as HTMLInputElement | null;
            const destinoIdHidden = document.getElementById("destinoId") as HTMLInputElement | null;
            const bloqueSelect = document.getElementById("bloque-sugerido") as HTMLSelectElement | null;

            function formatName(str: string) {
                if (!str) return "";
                return str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
            }

            function formatCarrera(str: string) {
                if (!str) return "";
                return str.toLowerCase().split(' ').map(w => {
                    if (["en", "y", "de", "la", "el"].includes(w)) return w;
                    return w.charAt(0).toUpperCase() + w.slice(1);
                }).join(' ').trim();
            }

            // Escolarizada helper
            const handleEscolarizadaLogic = () => {
                if (!carreraInput || !escolarizadaContainer || !escolarizadaCheckbox) return;
                const carrera = carreraInput.value;
                const groupB = [
                    "Licenciatura en Arquitectura",
                    "Licenciatura en Arte y Teatro",
                    "Licenciatura en Diseño Gráfico",
                ];

                if (carrera.toLowerCase().includes("licenciatura")) {
                    escolarizadaContainer.classList.remove("hidden");
                    escolarizadaContainer.classList.add("flex");
                    if (groupB.includes(carrera)) {
                        escolarizadaCheckbox.checked = true;
                    }
                } else {
                    escolarizadaContainer.classList.add("hidden");
                    escolarizadaContainer.classList.remove("flex");
                    escolarizadaCheckbox.checked = false;
                }
            };

            // Bloque Options Logic
            const handleBloqueOptions = () => {
                if (!bloqueSelect) return;
                const carreraVal = (carreraInput?.value || "").toLowerCase();
                const normalize = (str: string) => str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
                const carreraNorm = normalize(carreraVal);

                let filteredOptions: string[] = [];
                if (carreraNorm.includes("licenciatura")) {
                    const nums = Array.from({ length: 16 }, (_, i) => String(i + 1));
                    filteredOptions = [...nums, "Actualización"];
                } else if (carreraNorm.includes("maestria")) {
                    const nums = Array.from({ length: 5 }, (_, i) => String(i + 1));
                    filteredOptions = [...nums, "Seminario", "Actualización"];
                } else {
                    filteredOptions = bloqueOptionsFull;
                }

                const currentVal = bloqueSelect.dataset.currentVal 
                    ? bloqueSelect.dataset.currentVal.toLowerCase().replace(/\s+/g, '-') 
                    : (bloqueSelect.value || "0");
                
                bloqueSelect.innerHTML = "";

                // Opción por defecto
                const defaultOption = document.createElement('option');
                defaultOption.value = "0";
                defaultOption.textContent = "Elige un bloque";
                if (!currentVal || currentVal === "0" || currentVal === "null" || currentVal === "") {
                    defaultOption.selected = true;
                }
                bloqueSelect.appendChild(defaultOption);

                filteredOptions.forEach(opt => {
                    const normalizedOpt = opt.toLowerCase().replace(/\s+/g, '-');
                    const optionEl = document.createElement('option');
                    optionEl.value = normalizedOpt;
                    optionEl.textContent = opt;
                    if (normalizedOpt === currentVal && currentVal !== "0" && currentVal !== "") {
                        optionEl.selected = true;
                    }
                    bloqueSelect.appendChild(optionEl);
                });
            };

            if (bloqueSelect) {
                bloqueSelect.addEventListener('change', () => {
                    bloqueSelect.dataset.currentVal = bloqueSelect.value;
                });
            }

            // Consultar alumno API
            async function consultarDetalleAlumno() {
                const matricula = matriculaInput?.value?.trim();
                const campus = campusOrigenEl?.value?.trim();

                if (!matricula || !campus) return;

                const loadingToast = toast.info(
                    `<div class="flex items-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Buscando alumno...</span>
                    </div>`,
                    { allowHtml: true, duration: 0 }
                );

                try {
                    const url = `https://pz3bmmqsty.us-east-1.awsapprunner.com/api/alumnos/consultar-detalle?campus=${encodeURIComponent(campus)}&matricula=${encodeURIComponent(matricula)}`;
                    const res = await fetch(url, {
                        headers: {
                            'x-api-key': 'CHURRUMAIS-1979'
                        }
                    });
                    
                    let json;
                    try {
                        json = await res.json();
                    } catch (e) {}

                    loadingToast.dismiss();

                    if (res.ok && json?.status === "success" && json?.data) {
                        const data = json.data;

                        if (data.Alumno && alumnoInput) {
                            alumnoInput.value = formatName(data.Alumno);
                        }
                        if (data.carrera && carreraInput) {
                            let rawCarrera = String(data.carrera || '').trim();
                            const isEscolarizada = /\bescolarizad[ao]s?\b/i.test(rawCarrera);

                            if (isEscolarizada) {
                                rawCarrera = rawCarrera.replace(/\s*\bescolarizad[ao]s?\b/gi, '').replace(/\s+/g, ' ').trim();
                            }

                            if (campus.toLowerCase() === "virtual") {
                                rawCarrera = rawCarrera.replace(/\s*bloques\b/gi, '').replace(/\s+/g, ' ').trim();
                            }

                            const formatted = formatCarrera(rawCarrera);
                            const matchedCarreraObj = mappedCarrerasList.find(
                                (c) => c.label.toLowerCase() === formatted.toLowerCase() || c.label.toLowerCase().includes(formatted.toLowerCase())
                            );

                            const matchedLabel = matchedCarreraObj?.label || formatted;
                            carreraInput.value = matchedLabel;
                            if (carreraIdInput && matchedCarreraObj?.id) {
                                carreraIdInput.value = String(matchedCarreraObj.id);
                            }

                            handleEscolarizadaLogic();

                            if (escolarizadaCheckbox) {
                                const groupB = [
                                    "Licenciatura en Arquitectura",
                                    "Licenciatura en Arte y Teatro",
                                    "Licenciatura en Diseño Gráfico",
                                ];
                                if (isEscolarizada || groupB.includes(matchedLabel)) {
                                    escolarizadaCheckbox.checked = true;
                                } else {
                                    escolarizadaCheckbox.checked = false;
                                }
                            }

                            handleBloqueOptions();
                        }

                        toast.success("Datos del alumno autocompletados.");
                    } else if (json?.detail) {
                        toast.error(json.detail);
                    } else {
                        toast.error("Ocurrió un error al consultar el alumno.");
                    }
                } catch (e) {
                    loadingToast.dismiss();
                    console.error("Error fetching alumno details", e);
                    toast.error("Error de conexión al consultar el alumno.");
                }
            }

            // Matricula listeners: reset fields on typing, fetch on blur/enter
            if (matriculaInput) {
                matriculaInput.addEventListener("input", () => {
                    if (alumnoInput) alumnoInput.value = "";
                    if (carreraInput) carreraInput.value = "";
                    if (carreraIdInput) carreraIdInput.value = "";
                    if (escolarizadaCheckbox) escolarizadaCheckbox.checked = false;
                    if (escolarizadaContainer) {
                        escolarizadaContainer.classList.add("hidden");
                        escolarizadaContainer.classList.remove("flex");
                    }
                    handleBloqueOptions();
                });

                matriculaInput.addEventListener("blur", () => {
                    consultarDetalleAlumno();
                });

                matriculaInput.addEventListener("keydown", (e) => {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        consultarDetalleAlumno();
                    }
                });
            }

            // Campus Origen select change listener
            if (campusOrigenEl && campusOrigenEl.tagName === "SELECT") {
                campusOrigenEl.addEventListener("change", () => {
                    const sel = campusOrigenEl as HTMLSelectElement;
                    const selectedOpt = sel.options[sel.selectedIndex];
                    if (origenIdHidden && selectedOpt) {
                        const optId = selectedOpt.getAttribute("data-id");
                        if (optId) {
                            origenIdHidden.value = optId;
                        } else {
                            const found = mappedCampusesList.find(c => c.label.toLowerCase() === sel.value.toLowerCase());
                            if (found) origenIdHidden.value = String(found.id);
                        }
                    }
                    if (matriculaInput?.value?.trim()) {
                        consultarDetalleAlumno();
                    }
                });
            }

            // Autocomplete Helper
            function setupAutocomplete(inputId: string, suggestionsId: string, options: string[]) {
                const input = document.getElementById(inputId) as HTMLInputElement | null;
                const suggestions = document.getElementById(suggestionsId);
                if (!input || !suggestions) return;

                const normalizeText = (text: string) => text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

                const closeSuggestions = () => {
                    suggestions.classList.add("hidden");
                    suggestions.innerHTML = "";
                };

                input.addEventListener("input", function () {
                    const val = normalizeText((this as HTMLInputElement).value);
                    suggestions.innerHTML = "";
                    if (!val) {
                        closeSuggestions();
                        return;
                    }
                    const origenVal = campusOrigenEl?.value?.trim() || "";
                    let currentOptions = options;
                    if (inputId === "campus-destino" && origenVal) {
                        currentOptions = options.filter(opt => normalizeText(opt) !== normalizeText(origenVal));
                    }
                    const filtered = currentOptions.filter(opt => normalizeText(opt).includes(val));
                    if (filtered.length > 0) {
                        suggestions.classList.remove("hidden");
                        filtered.forEach(opt => {
                            const div = document.createElement("div");
                            div.textContent = opt;
                            div.className = "p-2 hover:bg-secondary hover:text-secondary-foreground cursor-pointer text-sm transition-colors";
                            div.onclick = () => {
                                input.value = opt;
                                closeSuggestions();
                                if (inputId === 'campus-destino' && destinoIdHidden) {
                                    const match = mappedCampusesList.find(c => c.label.toLowerCase() === opt.toLowerCase());
                                    if (match) destinoIdHidden.value = String(match.id);
                                } else if (inputId === 'descuento-valor') {
                                    const descHidden = document.getElementById('descuentoId') as HTMLInputElement | null;
                                    const mappedDesc = JSON.parse(transferForm?.dataset.descuentoList || "[]");
                                    const match = mappedDesc.find((d: any) => d.label.toLowerCase() === opt.toLowerCase());
                                    if (descHidden && match) descHidden.value = String(match.id);
                                }
                            };
                            suggestions.appendChild(div);
                        });
                    } else {
                        closeSuggestions();
                    }
                });
                
                document.addEventListener("click", (e) => {
                    if (e.target !== input && e.target !== suggestions) closeSuggestions();
                });
            }

            // Discount Logic
            const tieneDescuentoCk = document.getElementById("tiene_descuento") as HTMLInputElement | null;
            const descuentoContainer = document.getElementById("descuento-container");
            if (tieneDescuentoCk && descuentoContainer) {
                tieneDescuentoCk.addEventListener("change", () => {
                    if (tieneDescuentoCk.checked) {
                        descuentoContainer.classList.remove("hidden");
                    } else {
                        descuentoContainer.classList.add("hidden");
                        const descValInput = document.getElementById("descuento-valor") as HTMLInputElement | null;
                        const descIdInput = document.getElementById("descuentoId") as HTMLInputElement | null;
                        if (descValInput) descValInput.value = "";
                        if (descIdInput) descIdInput.value = "1";
                    }
                });
            }

            // Init autocompletes
            setupAutocomplete("campus-destino", "campus-destino-suggestions", campusOptions);
            setupAutocomplete("descuento-valor", "descuento-suggestions", descuentoOptions);
            
            handleBloqueOptions();

            // Save Handler for Transfer Button
            const saveBtn = document.getElementById("btn-save-transfer-changes");
            if (saveBtn) {
                const newSaveBtn = saveBtn.cloneNode(true) as HTMLButtonElement;
                saveBtn.replaceWith(newSaveBtn);
                
                newSaveBtn.addEventListener("click", async () => {
                    const originalText = newSaveBtn.textContent || "Guardar cambios";

                    // Validación: El ingeniero asignado no puede ser el mismo auditor
                    const atiendeSelect = document.querySelector("select[name='atiendeId']") as HTMLSelectElement | null;
                    const auditorDocsSelect = document.querySelector("select[name='auditor_docsId']") as HTMLSelectElement | null;
                    const auditorReqSelect = document.querySelector("select[name='auditor_reqId']") as HTMLSelectElement | null;

                    const atiendeId = atiendeSelect ? atiendeSelect.value : "";
                    const auditorDocsId = auditorDocsSelect ? auditorDocsSelect.value : "";
                    const auditorReqId = auditorReqSelect ? auditorReqSelect.value : "";

                    if (atiendeId) {
                        if (atiendeId === auditorDocsId) {
                            toast.error("El ingeniero asignado no puede ser el auditor de documentos.");
                            return;
                        }
                        if (atiendeId === auditorReqId) {
                            toast.error("El ingeniero asignado no puede ser el auditor de adeudos.");
                            return;
                        }
                    }

                    newSaveBtn.textContent = "Guardando...";
                    newSaveBtn.disabled = true;

                    const newCommentElement = document.getElementById('new-comment') as HTMLTextAreaElement | null;
                    const newComment = newCommentElement?.value?.trim() || "";

                    const payload = {
                        ticketId: (window as any).ticketViewData.ticketId,
                        prioridad: (document.getElementById("prioridad") as HTMLSelectElement)?.value,
                        estatusId: (document.getElementById("estatusId") as HTMLSelectElement)?.value,
                        atiendeId: (document.querySelector("select[name='atiendeId']") as HTMLSelectElement)?.value,
                        
                        matricula: (document.getElementById("matricula") as HTMLInputElement)?.value?.trim(),
                        alumno: (document.getElementById("alumno") as HTMLInputElement)?.value?.trim(),
                        origenId: (document.getElementById("origenId") as HTMLInputElement)?.value,
                        destinoId: (document.getElementById("destinoId") as HTMLInputElement)?.value,
                        carreraId: (document.getElementById("carreraId") as HTMLInputElement)?.value,
                        nuevo_ingreso: (document.getElementById("nuevo_ingreso") as HTMLInputElement)?.checked,
                        tiene_descuento: (document.getElementById("tiene_descuento") as HTMLInputElement)?.checked,
                        descuentoId: (document.getElementById("descuentoId") as HTMLInputElement)?.value,
                        descuento_nombre: (document.getElementById("descuento-valor") as HTMLInputElement)?.value?.trim(),
                        bloque_nombre: (() => { const v = (document.getElementById("bloque-sugerido") as HTMLSelectElement)?.value; return (!v || v === "0" || v === "null") ? null : v; })(),
                        
                        auditor_docsId: (document.querySelector("select[name='auditor_docsId']") as HTMLSelectElement)?.value,
                        auditor_reqId: (document.querySelector("select[name='auditor_reqId']") as HTMLSelectElement)?.value,
                        validacion_docs: (document.querySelector("input[name='validacion_docs']") as HTMLInputElement)?.checked,
                        descripcion_docs: (document.querySelector("textarea[name='descripcion_docs']") as HTMLTextAreaElement)?.value,
                        validacion_edocta: (document.querySelector("input[name='validacion_edocta']") as HTMLInputElement)?.checked,
                        descripcion_edocta: (document.querySelector("textarea[name='descripcion_edocta']") as HTMLTextAreaElement)?.value,
                        validacion_calif: (document.querySelector("input[name='validacion_calif']") as HTMLInputElement)?.checked,
                        descripcion_calif: (document.querySelector("textarea[name='descripcion_calif']") as HTMLTextAreaElement)?.value,
                        newComment: newComment || undefined
                    };

                    try {
                        const res = await fetch("/api/tickets/update", {
                            method: "PATCH",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(payload)
                        });
                        if (!res.ok) {
                            const errData = await res.json();
                            throw new Error(errData.message || "Error al actualizar el ticket");
                        }
                        const resData = await res.json();
                        if (resData?.hasNewHistoryEntry) {
                            toast.success("Ticket actualizado correctamente");
                            setTimeout(() => {
                                const params = new URLSearchParams(window.location.search);
                                params.set("new_entry", "true");
                                window.location.assign(`${window.location.pathname}?${params.toString()}`);
                            }, 800);
                        } else {
                            toast.info("No se detectaron cambios para guardar.");
                            setTimeout(() => {
                                const params = new URLSearchParams(window.location.search);
                                params.delete("new_entry");
                                const searchStr = params.toString() ? `?${params.toString()}` : "";
                                window.location.assign(`${window.location.pathname}${searchStr}`);
                            }, 800);
                        }
                    } catch (e: any) {
                        console.error(e);
                        toast.error(e.message || "Error al actualizar");
                        newSaveBtn.textContent = originalText;
                        newSaveBtn.disabled = false;
                    }
                });
            }
        };
        initTransferLogic();
    });

</script>
