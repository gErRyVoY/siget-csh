---
import MainLayout from "@/layouts/MainLayout.astro";
import UserTransferIcon from "@/components/icons/UserTransferIcon.astro";
import { prisma } from "@/lib/db";
import {
    campusOptions,
    carreraOptions,
    bloqueOptions,
} from "@/config/form-options";

const GOOGLE_API_KEY = import.meta.env.GOOGLE_API_KEY || process.env.GOOGLE_API_KEY || '';
const GOOGLE_CLIENT_ID = import.meta.env.GOOGLE_CLIENT_ID || process.env.GOOGLE_CLIENT_ID || '';
const GOOGLE_APP_ID = import.meta.env.GOOGLE_APP_ID || process.env.GOOGLE_APP_ID || '';

const descuentos = await prisma.descuento.findMany({
    where: { activo: true },
    select: { descripcion: true },
});
const descuentoOptions = descuentos.map((d) => d.descripcion);

// Precargar campus origen si el usuario pertenece a un campus Magno o Ejecutivo, o si tiene habilitado tckt_virtual
// Reutilizar sesión resuelta por middleware.ts (evita N+1 a la BD por navegación)
const session = Astro.locals.session;
const userId = session?.user?.id ? parseInt(String(session.user.id), 10) : null;
let preloadedCampus = "";
let preloadedReadOnly = false;
let allowedOriginCampus = ""; // campus propio habilitado como opción cuando tiene Virtual
if (userId) {
    const usuario = await prisma.usuario.findUnique({
        where: { id: userId },
        select: { empresa: { select: { nombre: true, tipo: true, tckt_virtual: true } } },
    });
    const empresa = usuario?.empresa;
    if (empresa) {
        const allowVirtual = empresa.tckt_virtual;
        const isMagnoEjecutivo = ["Magno", "Ejecutivo"].includes(empresa.tipo);

        if (isMagnoEjecutivo && allowVirtual) {
            // Campo vacío al inicio; el usuario elige entre su campus o Virtual
            preloadedCampus = "";
            preloadedReadOnly = false;
            const campusMatch = campusOptions.find(
                (c) => c.toLowerCase() === empresa.nombre.toLowerCase()
            );
            allowedOriginCampus = campusMatch || empresa.nombre;
        } else if (isMagnoEjecutivo) {
            // Solo Magno/Ejecutivo sin Virtual: bloquear con su campus
            const campusMatch = campusOptions.find(
                (c) => c.toLowerCase() === empresa.nombre.toLowerCase()
            );
            if (campusMatch) {
                preloadedCampus = campusMatch;
                preloadedReadOnly = true;
            }
        } else if (allowVirtual) {
            // Si no es Magno/Ejecutivo pero tiene allowVirtual: forzar Virtual y bloquear
            preloadedCampus = "Virtual";
            preloadedReadOnly = true;
        }
    }
}

// Emails de agentes CSH (para permisos de carpeta Drive en solicitudes de traslado)
const agentsCshTraslado = await prisma.usuario.findMany({
    where: { activo: true, atiende_csh: true, mail: { not: '' } },
    select: { mail: true },
});
const agentCshTraslEmail = agentsCshTraslado
    .map((u) => u.mail)
    .filter(Boolean) as string[];
---

<MainLayout title="Solicitud de nuevo traslado">
    <div class="max-w-3xl">
        <div class="bg-card text-card-foreground rounded-xl border shadow-sm">
            <div class="p-6 border-b border-border flex items-center gap-4">
                <div class="p-2 bg-primary/10 rounded-lg text-primary">
                    <UserTransferIcon class="h-6 w-6" />
                </div>
                <div>
                    <!-- <h1 class="text-2xl font-bold">Solicitud de Traslado</h1> -->
                    <p class="text-lg mt-1">
                        Ingresa la <span class="font-bold text-secondary"
                            >matrícula</span
                        > y <span class="font-bold text-secondary">campus</span> del
                        alumno para autocomplementar la información.
                    </p>
                </div>
            </div>

            <div class="p-6">
                <form
                    id="nuevo-traslado-form"
                    class="space-y-6"
                    data-campus-options={JSON.stringify(campusOptions)}
                    data-carrera-options={JSON.stringify(carreraOptions)}
                    data-descuento-options={JSON.stringify(descuentoOptions)}
                    data-bloque-options={JSON.stringify(bloqueOptions)}
                    data-google-api-key={GOOGLE_API_KEY}
                    data-google-client-id={GOOGLE_CLIENT_ID}
                    data-google-app-id={GOOGLE_APP_ID}
                    data-access-token={session?.accessToken || ""}
                    data-agent-emails={agentCshTraslEmail.join(',')}
                    data-preloaded-campus={preloadedCampus}
                    data-preloaded-readonly={preloadedReadOnly ? "true" : "false"}
                    data-allowed-origin-campus={allowedOriginCampus}
                >
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Campus origen -->
                        <div class="relative">
                            <label
                                for="campus-origen"
                                class="block text-sm font-medium text-foreground mb-1"
                            >
                                Campus origen <span class="text-destructive"
                                    >*</span
                                >
                            </label>
                            <input
                                type="text"
                                id="campus-origen"
                                name="campus-origen"
                                autocomplete="off"
                                class="w-full rounded-md border-border bg-input px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                placeholder="Buscar campus..."
                                required
                            />
                            <div
                                id="campus-origen-suggestions"
                                class="absolute z-10 w-full bg-popover text-popover-foreground border border-[#797979] rounded-md mt-1 hidden max-h-40 overflow-y-auto shadow-md"
                            >
                            </div>
                            <p
                                id="campus-origen-error"
                                class="text-destructive text-xs mt-1 hidden"
                            >
                            </p>
                        </div>

                        <!-- Campus destino -->
                        <div class="relative">
                            <label
                                for="campus-destino"
                                class="block text-sm font-medium text-foreground mb-1"
                            >
                                Campus destino <span class="text-destructive"
                                    >*</span
                                >
                            </label>
                            <input
                                type="text"
                                id="campus-destino"
                                name="campus-destino"
                                autocomplete="off"
                                class="w-full rounded-md border-border bg-input px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                placeholder="Buscar campus..."
                                required
                            />
                            <div
                                id="campus-destino-suggestions"
                                class="absolute z-10 w-full bg-popover text-popover-foreground border border-[#797979] rounded-md mt-1 hidden max-h-40 overflow-y-auto shadow-md"
                            >
                            </div>
                            <p
                                id="campus-destino-error"
                                class="text-destructive text-xs mt-1 hidden"
                            >
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Matrícula -->
                        <div>
                            <label
                                for="matricula"
                                class="block text-sm font-medium text-foreground mb-1"
                            >
                                Matrícula <span class="text-destructive">*</span
                                >
                            </label>
                            <input
                                type="text"
                                id="matricula"
                                name="matricula"
                                pattern="[a-zA-Z0-9]+"
                                class="w-full rounded-md border-border bg-input px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                placeholder="Ej: 123456"
                                required
                            />
                            <p
                                id="matricula-error"
                                class="text-destructive text-xs mt-1 hidden"
                            >
                            </p>
                        </div>

                        <!-- Nombre Completo -->
                        <div>
                            <label
                                for="nombre-completo"
                                class="block text-sm font-medium text-foreground mb-1"
                            >
                                Nombre completo <span class="text-destructive"
                                    >*</span
                                >
                            </label>
                            <input
                                type="text"
                                id="nombre-completo"
                                name="nombre-completo"
                                readonly
                                class="w-full rounded-md border-border bg-muted px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 cursor-not-allowed opacity-80"
                                placeholder="Se autocompletará al buscar..."
                                required
                            />
                            <p
                                id="nombre-completo-error"
                                class="text-destructive text-xs mt-1 hidden"
                            >
                            </p>
                        </div>
                    </div>

                    <!-- Carrera y modalidad -->
                    <div class="relative">
                        <div class="flex justify-between items-center mb-1">
                            <label
                                for="carrera"
                                class="block text-sm font-medium text-foreground"
                            >
                                Carrera <span class="text-destructive">*</span>
                            </label>
                            <div
                                id="escolarizada-container"
                                class="items-center hidden"
                            >
                                <label
                                    for="escolarizada"
                                    class="mr-2 text-sm text-muted-foreground"
                                    >Escolarizada</label
                                >
                                <input
                                    id="escolarizada"
                                    name="escolarizada"
                                    type="checkbox"
                                    disabled
                                    class="h-4 w-4 rounded border-input text-primary focus:ring-primary cursor-not-allowed opacity-80"
                                />
                            </div>
                        </div>
                        <input
                            type="text"
                            id="carrera"
                            name="carrera"
                            autocomplete="off"
                            readonly
                            class="w-full rounded-md border-border bg-muted px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 cursor-not-allowed opacity-80"
                            placeholder="Se autocompletará al buscar..."
                            required
                        />
                        <div
                            id="carrera-suggestions"
                            class="absolute z-10 w-full bg-popover text-popover-foreground border border-[#797979] rounded-md mt-1 hidden max-h-48 overflow-y-auto shadow-md"
                        >
                        </div>
                        <p
                            id="carrera-error"
                            class="text-destructive text-xs mt-1 hidden"
                        >
                        </p>
                    </div>
                    <!-- Bloque sugerido -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label
                                for="bloque-sugerido"
                                class="block text-sm font-medium text-foreground mb-1"
                            >
                                Bloque sugerido
                            </label>
                            <select
                                id="bloque-sugerido"
                                name="bloque-sugerido"
                                class="w-full rounded-md border-border bg-input px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring"
                            >
                                <option value="0">Elige un bloque</option>
                                {
                                    bloqueOptions.map((option) => (
                                        <option
                                            value={option
                                                .toLowerCase()
                                                .replace(/\s+/g, "-")}
                                        >
                                            {option}
                                        </option>
                                    ))
                                }
                            </select>
                        </div>
                    </div>
                    <div class="flex justify-between items-center mb-1 w-full">
                        <h1
                            class="text-sm font-medium text-foreground w-full text-center border-b border-muted-foreground/40"
                        >
                            Información opcional
                        </h1>
                    </div>
                    <!-- Descuentos y comentarios -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Descuento -->
                        <div>
                            <div class="flex items-center mb-2 h-5">
                                <label
                                    class="text-sm font-medium text-foreground"
                                    >¿Tiene descuento?</label
                                >
                            </div>
                            <div
                                class="flex items-center gap-4 p-2 border border-input rounded-md bg-transparent"
                            >
                                <div class="flex items-center">
                                    <input
                                        id="tiene-descuento"
                                        name="tiene-descuento"
                                        type="checkbox"
                                        class="h-4 w-4 rounded border-input text-primary focus:ring-primary"
                                    />
                                    <label
                                        for="tiene-descuento"
                                        class="ml-2 text-sm text-foreground"
                                        >Si</label
                                    >
                                </div>
                                <div
                                    id="descuento-container"
                                    class="items-center hidden ml-auto relative w-full max-w-[200px]"
                                >
                                    <input
                                        type="text"
                                        id="descuento-valor"
                                        name="descuento-valor"
                                        autocomplete="off"
                                        class="w-full rounded-md border-border bg-input px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                        placeholder="Buscar..."
                                    />
                                    <div
                                        id="descuento-suggestions"
                                        class="absolute z-10 w-full bg-popover text-popover-foreground border border-[#797979] rounded-md mt-1 hidden max-h-40 overflow-y-auto shadow-md top-full left-0 origin-top"
                                    >
                                    </div>
                                </div>
                            </div>
                            <p
                                id="descuento-valor-error"
                                class="text-destructive text-xs mt-1 hidden"
                            >
                            </p>
                        </div>
                        <!-- Comentarios -->
                        <div>
                            <div class="flex items-center mb-2 h-5">
                                <label
                                    class="text-sm font-medium text-foreground"
                                    >Comentarios</label
                                >
                            </div>
                            <textarea
                                id="comentarios"
                                name="comentarios"
                                rows="4"
                                class="w-full rounded-md border-border bg-input px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                placeholder="Escribe tus comentarios aquí..."
                            ></textarea>

                            <!-- Recursos de Google Drive (Carpetas y Videos) -->
                            <div id="drive-resources-section" class="hidden mt-3 space-y-3">
                                <div id="drive-folders-list" class="space-y-2"></div>
                                <div id="drive-videos-list" class="space-y-2"></div>
                            </div>
                        </div>
                    </div>

                    <!-- File upload section -->
                    <div class="space-y-4">
                        <div
                            class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full items-stretch"
                        >
                            <div class="space-y-2 h-full">
                                <div
                                    id="drop-zone"
                                    class="border-2 border-dashed border-muted-foreground/25 rounded-lg p-6 flex flex-col items-center justify-center hover:bg-muted/50 transition-colors cursor-pointer relative h-full min-h-[120px]"
                                >
                                    <p
                                        class="text-sm text-muted-foreground text-center"
                                    >
                                        Arrastre sus archivos aquí
                                    </p>
                                    <div
                                        id="attachment-area"
                                        class="text-left w-full mt-auto"
                                    >
                                    </div>
                                </div>
                            </div>

                            <div
                                class="flex flex-col justify-end items-end gap-2 rounded-lg border border-transparent"
                            >
                                <div
                                    id="action-buttons-container"
                                    class="flex flex-wrap justify-end items-center gap-2 w-full"
                                >
                                    <button
                                        type="button"
                                        id="upload-files-button"
                                        class="bg-muted-foreground text-white hover:bg-muted-foreground/80 px-4 py-2 rounded-md text-sm font-semibold shrink-0 h-10"
                                    >
                                        Seleccionar
                                    </button>
                                    <button
                                        type="button"
                                        id="google-drive-button"
                                        class="bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 rounded-md flex items-center justify-center h-10 w-10 shrink-0"
                                        title="Adjuntar desde Google Drive"
                                    >
                                        <img
                                            src="/Google_Drive_icon.svg"
                                            width="24"
                                            height="24"
                                            alt="Google Drive"
                                        />
                                    </button>
                                    <a
                                        href="/"
                                        class="px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors shrink-0 flex items-center justify-center h-10"
                                        >Cancelar</a
                                    >
                                    <button
                                        type="submit"
                                        id="nuevo-traslado-submit"
                                        class="bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-2 rounded-md text-sm font-semibold shrink-0 h-10 disabled:opacity-50 disabled:cursor-not-allowed"
                                        disabled
                                    >
                                        Enviar solicitud
                                    </button>
                                </div>
                                <div class="relative flex items-center justify-end w-full mt-1">
                                    <button
                                        type="button"
                                        id="format-help-btn"
                                        class="text-xs text-primary hover:text-primary/80 font-medium underline underline-offset-2 flex items-center gap-1 cursor-pointer transition-colors"
                                        aria-haspopup="dialog"
                                        aria-expanded="false"
                                    >
                                        <span>Consulta lo que puedes añadir</span>
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 inline-block text-secondary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                        </svg>
                                    </button>

                                    <!-- Popover informativo flotante -->
                                    <div
                                        id="format-help-popover"
                                        class="hidden absolute bottom-full right-0 mb-2 w-80 max-w-[90vw] p-4 bg-popover text-popover-foreground rounded-lg border border-border shadow-xl z-50 text-xs animate-in fade-in zoom-in-95 duration-150"
                                    >
                                        <div class="flex items-center justify-between pb-2 mb-2 border-b border-border font-semibold text-foreground">
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-base">📎</span>
                                                <span>Elementos permitidos</span>
                                            </div>
                                            <button
                                                type="button"
                                                id="format-help-close"
                                                class="text-muted-foreground hover:text-foreground p-0.5 rounded transition-colors cursor-pointer"
                                                title="Cerrar"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </button>
                                        </div>

                                        <ul class="space-y-2.5 text-muted-foreground">
                                            <li class="flex items-start gap-2">
                                                <span class="text-primary font-bold">📄</span>
                                                <div>
                                                    <strong class="text-foreground">Archivos adjuntos:</strong>
                                                    <p class="text-[11px] leading-tight mt-0.5">JPG, PNG, WEBP, PDF, DOCX, XLSX (máximo 5MB por archivo).</p>
                                                </div>
                                            </li>
                                            <li class="flex items-start gap-2">
                                                <span class="text-primary font-bold">📑</span>
                                                <div>
                                                    <strong class="text-foreground">Google Workspace:</strong>
                                                    <p class="text-[11px] leading-tight mt-0.5">Documentos, Hojas de cálculo y Presentaciones de Google Drive.</p>
                                                </div>
                                            </li>
                                            <li class="flex items-start gap-2">
                                                <span class="text-primary font-bold">🎥</span>
                                                <div>
                                                    <strong class="text-foreground">Videos (Google Drive):</strong>
                                                    <p class="text-[11px] leading-tight mt-0.5">.mp4, .avi, .mov, .hevc, .3gp y video/* (compartición hasta 5 videos).</p>
                                                </div>
                                            </li>
                                            <li class="flex items-start gap-2">
                                                <span class="text-primary font-bold">📁</span>
                                                <div>
                                                    <strong class="text-foreground">Carpetas (Google Drive):</strong>
                                                    <p class="text-[11px] leading-tight mt-0.5">Selección y compartición directa de hasta 5 carpetas de Drive.</p>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" id="mail" name="mail" />
                    <input
                        type="hidden"
                        id="mail_escuela"
                        name="mail_escuela"
                    />
                    <input type="hidden" id="telefono" name="telefono" />
                    <input type="hidden" id="tel_movil" name="tel_movil" />
                    <input
                        type="hidden"
                        id="plan_pago_api"
                        name="plan_pago_api"
                    />

                    <input
                        type="file"
                        id="file-input"
                        multiple
                        class="hidden"
                    />
                </form>
            </div>
        </div>
    </div>
</MainLayout>

<script>
    import { toast } from "@/lib/toast";
    import { calcularTamanoPicker } from "@/lib/google-picker-size";

    declare global {
        interface Window {
            gapi: any;
            google: any;
        }
    }

    function initTransferForm() {
        const form = document.getElementById(
            "nuevo-traslado-form",
        ) as HTMLFormElement;
        const submitButton = document.getElementById(
            "nuevo-traslado-submit",
        ) as HTMLButtonElement;

        if (!form) return;

        // Data from attributes
        const campusOptions: string[] = JSON.parse(
            form.dataset.campusOptions || "[]",
        );
        const carreraOptions: string[] = JSON.parse(
            form.dataset.carreraOptions || "[]",
        );
        const descuentoOptions: string[] = JSON.parse(
            form.dataset.descuentoOptions || "[]",
        );
        const bloqueOptionsFull: string[] = JSON.parse(
            form.dataset.bloqueOptions || "[]",
        );

        const GOOGLE_API_KEY = form.dataset.googleApiKey;
        const GOOGLE_CLIENT_ID = form.dataset.googleClientId;
        const GOOGLE_APP_ID = form.dataset.googleAppId;
        const preloadedCampus = form.dataset.preloadedCampus || "";
        const preloadedReadOnly = form.dataset.preloadedReadonly === "true";
        const allowedOriginCampus = form.dataset.allowedOriginCampus || "";

        // --- FIELD REFS ---
        const matriculaInput = document.getElementById(
            "matricula",
        ) as HTMLInputElement;
        const nombreInput = document.getElementById(
            "nombre-completo",
        ) as HTMLInputElement;
        const campusOrigenInput = document.getElementById(
            "campus-origen",
        ) as HTMLInputElement;
        const campusDestinoInput = document.getElementById(
            "campus-destino",
        ) as HTMLInputElement;
        const carreraInput = document.getElementById(
            "carrera",
        ) as HTMLInputElement;
        const tieneDescuentoCheckbox = document.getElementById(
            "tiene-descuento",
        ) as HTMLInputElement;
        const descuentoValorInput = document.getElementById(
            "descuento-valor",
        ) as HTMLInputElement;
        const escolarizadaCheckbox = document.getElementById(
            "escolarizada",
        ) as HTMLInputElement;
        const escolarizadaContainer = document.getElementById(
            "escolarizada-container",
        ) as HTMLElement;
