---
import MainLayout from "@/layouts/MainLayout.astro";
import { prisma } from "@/lib/db";
import { getCategorias, getEmpresas, getEstatus } from "@/lib/reference-data";
import { ticketListSelect } from "@/lib/ticket-select";
import { format, differenceInDays } from "date-fns";
import { es } from "date-fns/locale";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import SkeletonTable from "@/components/ui/SkeletonTable.astro";

// Reutilizar sesión resuelta por middleware.ts (evita N+1 a la BD por navegación)
const session = Astro.locals.session;
const user = session?.user;

if (!user) {
    return Astro.redirect("/login");
}

// Obtener parámetros de filtro de la URL
const url = new URL(Astro.request.url);
const statusFilter = url.searchParams.get("status") || "all";
const categoryFilter = url.searchParams.get("category") || "all";
const subcategoryFilter = url.searchParams.get("subcategory") || "all";
const companyFilter = url.searchParams.get("company") || "all";
const assigneeFilter = url.searchParams.get("assignee") || url.searchParams.get("atiende") || "all";
const dateFromFilter = url.searchParams.get("dateFrom") || "";
const dateToFilter = url.searchParams.get("dateTo") || "";
const page = parseInt(url.searchParams.get("page") || "1");
const pageSize = 10;

// Definir estatus activos para la vista por defecto
const activeStatusNames = ["Sin asignar", "Nuevo", "En progreso", "En espera"];

let statusWhere: any = {};
if (statusFilter !== "all") {
    const statusId = parseInt(statusFilter);
    if (!isNaN(statusId)) {
        statusWhere = { estatusId: statusId };
    }
} else {
    statusWhere = {
        estatus: {
            nombre: {
                in: activeStatusNames,
            },
        },
    };
}

const MARKETING_CATEGORY_ID = 12;

// Construir el filtro principal
const where: any = {
    ...statusWhere,
    NOT: { categoriaId: MARKETING_CATEGORY_ID }, // Soporte no muestra tickets de Marketing
};

if (categoryFilter !== "all") {
    const catId = parseInt(categoryFilter);
    if (!isNaN(catId)) {
        where.categoriaId = catId;
    }
}

if (subcategoryFilter !== "all") {
    const subId = parseInt(subcategoryFilter);
    if (!isNaN(subId)) {
        where.subcategoriaId = subId;
    }
}

if (companyFilter !== "all") {
    const compId = parseInt(companyFilter);
    if (!isNaN(compId)) {
        where.empresaId = compId;
    }
}

if (assigneeFilter !== "all") {
    if (assigneeFilter === "unassigned") {
        where.atiendeId = null;
    } else {
        const assignId = parseInt(assigneeFilter);
        if (!isNaN(assignId)) {
            where.atiendeId = assignId;
        }
    }
}

// Helper para formatear a dd/mm/aaaa en la vista
function formatToDDMMAAAA(str: string): string {
    if (!str) return "";
    if (str.includes("/")) return str;
    if (str.includes("-")) {
        const parts = str.split("-");
        if (parts.length === 3) {
            return `${parts[2].padStart(2, "0")}/${parts[1].padStart(2, "0")}/${parts[0]}`;
        }
    }
    return str;
}

// Helper para parsear fecha (acepta DD/MM/YYYY o YYYY-MM-DD)
function parseDateParam(str: string): { startOfDay: Date; endOfDay: Date } | null {
    if (!str) return null;
    let y = 0, m = 0, d = 0;
    if (str.includes("/")) {
        const parts = str.split("/");
        if (parts.length === 3) {
            d = parseInt(parts[0], 10);
            m = parseInt(parts[1], 10) - 1;
            y = parseInt(parts[2], 10);
        }
    } else if (str.includes("-")) {
        const parts = str.split("-");
        if (parts.length === 3) {
            y = parseInt(parts[0], 10);
            m = parseInt(parts[1], 10) - 1;
            d = parseInt(parts[2], 10);
        }
    }
    if (!y || isNaN(m) || !d || m < 0 || m > 11 || d < 1 || d > 31) return null;
    const startOfDay = new Date(y, m, d, 0, 0, 0, 0);
    const endOfDay = new Date(y, m, d, 23, 59, 59, 999);
    if (isNaN(startOfDay.getTime()) || isNaN(endOfDay.getTime())) return null;
    return { startOfDay, endOfDay };
}

const displayDateFrom = formatToDDMMAAAA(dateFromFilter);
const displayDateTo = formatToDDMMAAAA(dateToFilter);

if (dateFromFilter && dateToFilter) {
    const fromParsed = parseDateParam(dateFromFilter);
    const toParsed = parseDateParam(dateToFilter);
    if (fromParsed && toParsed) {
        where.fechaalta = {
            gte: fromParsed.startOfDay,
            lte: toParsed.endOfDay,
        };
    }
}

// Obtener datos para los selectores (DINÁMICOS basados en Estatus)
const dropdownScope = {
    ...statusWhere,
    NOT: { categoriaId: MARKETING_CATEGORY_ID },
};

// Filtrar estatus permitidos
const allowedStatuses = [
    "Nuevo",
    "En progreso",
    "En espera",
    "Solucionado",
    "Cancelado",
    "Duplicado",
    "Sin asignar",
];

// Los desplegables ya no se resuelven con `tickets: { some: dropdownScope } }`
// —una subconsulta correlacionada sobre `ticket` por cada catálogo—, sino con un
// `groupBy` que devuelve los ids realmente presentes en el scope; los nombres
// salen del caché de catálogos (src/lib/reference-data.ts).
//
// Y todo lo que no depende de un resultado anterior va en un solo `Promise.all`:
// antes eran seis viajes a la BD en serie.
const [
    allStatuses,
    allCategories,
    allCompanies,
    gruposCategoria,
    gruposEmpresa,
    gruposAtiende,
    totalTickets,
    tickets,
] = await Promise.all([
    getEstatus(),
    getCategorias(),
    getEmpresas(),
    prisma.ticket.groupBy({ by: ["categoriaId"], where: dropdownScope }),
    prisma.ticket.groupBy({ by: ["empresaId"], where: dropdownScope }),
    prisma.ticket.groupBy({ by: ["atiendeId"], where: dropdownScope }),
    prisma.ticket.count({ where }),
    prisma.ticket.findMany({
        where,
        select: ticketListSelect,
        orderBy: {
            fechaalta: "desc",
        },
        skip: (page - 1) * pageSize,
        take: pageSize,
    }),
]);

const filteredStatuses = allStatuses.filter((status) =>
    allowedStatuses.includes(status.nombre),
);

// Categorías disponibles (basadas en tickets visibles por estatus)
const categoriaIdsPresentes = new Set(gruposCategoria.map((g) => g.categoriaId));
const categories = allCategories.filter(
    (c) =>
        c.activo &&
        c.id !== MARKETING_CATEGORY_ID &&
        categoriaIdsPresentes.has(c.id),
);

// Empresas que tienen tickets (basadas en estatus)
const empresaIdsPresentes = new Set(gruposEmpresa.map((g) => g.empresaId));
const companies = allCompanies.filter((e) => empresaIdsPresentes.has(e.id));

// Agentes con tickets asignados en este scope. Es la única consulta que depende
// de un resultado anterior, y es un `IN` por clave primaria.
const agentIds = gruposAtiende
    .map((g) => g.atiendeId)
    .filter((id): id is number => id !== null);
const agents =
    agentIds.length > 0
        ? await prisma.usuario.findMany({
              where: { id: { in: agentIds } },
              select: { id: true, nombres: true, apellidos: true },
              orderBy: { nombres: "asc" },
          })
        : [];

const totalPages = Math.ceil(totalTickets / pageSize);

const getTicketDateColor = (date: Date, status: string) => {
    const activeStatuses = ["Sin asignar", "Nuevo", "En progreso", "En espera"];
    if (!activeStatuses.includes(status)) return "text-muted-foreground";

    const days = differenceInDays(new Date(), new Date(date));

    if (days <= 1) return "text-green-600 dark:text-green-500 font-medium";
    if (days >= 3 && days <= 5)
        return "text-yellow-600 dark:text-yellow-500 font-medium";
    if (days >= 7) return "text-red-600 dark:text-red-500 font-bold";

    return "text-muted-foreground";
};
---

<MainLayout title="Soporte Técnico">
    <div class="space-y-6">
        <div class="flex justify-between items-center">
            <h1 class="text-3xl font-bold text-foreground">
                Tickets de Soporte
            </h1>
            <div class="flex items-center gap-4">
                <a
                    href="/tickets/soporte/nuevo-ticket-csh"
                    class="bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 rounded-md font-medium transition-colors"
                >
                    Nuevo Ticket
                </a>
                <button
                    id="reset-filters"
                    class="bg-secondary text-secondary-foreground hover:bg-secondary/80 px-4 py-2 rounded-md font-medium transition-colors text-sm"
                >
                    Limpiar Filtros
                </button>
            </div>
        </div>

        <!-- Filtros -->
        <div class="bg-card p-4 rounded-lg shadow-sm border border-border space-y-3">
            <!-- Fila 1: Selectores -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                    <label
                        for="estatus-select"
                        class="block text-sm font-medium text-muted-foreground mb-1"
                        >Estatus</label
                    >
                    <select
                        id="estatus-select"
                        class="w-full bg-input border-border text-foreground rounded-md p-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent"
                    >
                        <option value="all">Todos</option>
                        {
                            filteredStatuses.map((status) => (
                                <option
                                    value={status.id}
                                    selected={
                                        statusFilter === status.id.toString()
                                    }
                                >
                                    {status.nombre}
                                </option>
                            ))
                        }
                    </select>
                </div>
                <div>
                    <label
                        for="categoria-select"
                        class="block text-sm font-medium text-muted-foreground mb-1"
                        >Categoría</label
                    >
                    <select
                        id="categoria-select"
                        class="w-full bg-input border-border text-foreground rounded-md p-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent"
                    >
                        <option value="all">Todas</option>
                        {
                            categories.map((category) => (
                                <option
                                    value={category.id}
                                    selected={
                                        categoryFilter ===
                                        category.id.toString()
                                    }
                                >
                                    {category.nombre}
                                </option>
                            ))
                        }
                    </select>
                </div>
                <div>
                    <label
                        for="empresa-select"
                        class="block text-sm font-medium text-muted-foreground mb-1"
                        >Empresa</label
                    >
                    <select
                        id="empresa-select"
                        class="w-full bg-input border-border text-foreground rounded-md p-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent"
                    >
                        <option value="all">Todos</option>
                        {
                            companies.map((company) => (
                                <option
                                    value={company.id}
                                    selected={
                                        companyFilter === company.id.toString()
                                    }
                                >
                                    {company.nombre}
                                </option>
                            ))
                        }
                    </select>
                </div>
                <div>
                    <label
                        for="assignee-select"
                        class="block text-sm font-medium text-muted-foreground mb-1"
                        >Asignado a</label
                    >
                    <select
                        id="assignee-select"
                        class="w-full bg-input border-border text-foreground rounded-md p-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent"
                    >
                        <option value="all">Todos</option>
                        <option
                            value="unassigned"
                            selected={assigneeFilter === "unassigned"}
                            >Sin asignar</option
                        >
                        {
                            agents.map((agent) => (
                                <option
                                    value={agent.id}
                                    selected={
                                        assigneeFilter === agent.id.toString()
                                    }
                                >
                                    {agent.nombres} {agent.apellidos}
                                </option>
                            ))
                        }
                    </select>
                </div>
            </div>
            <!-- Fila 2: Fechas -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                    <label
                        for="dateFrom-input"
                        class="block text-sm font-medium text-muted-foreground mb-1"
                        >Desde</label
                    >
                    <div class="relative">
                        <input
                            type="text"
                            id="dateFrom-input"
                            value={displayDateFrom}
                            placeholder="dd/mm/aaaa"
                            maxlength="10"
                            inputmode="numeric"
                            class="w-full bg-input border-border text-foreground rounded-md p-2 pr-9 text-sm focus:ring-2 focus:ring-primary focus:border-transparent font-mono"
                        />
                        <button
                            type="button"
                            id="dateFrom-calendar-btn"
                            tabindex="-1"
                            class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-muted-foreground hover:text-foreground cursor-pointer focus:outline-none"
                            title="Abrir calendario"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </button>
                        <input
                            type="date"
                            id="dateFrom-picker"
                            class="sr-only pointer-events-none"
                            tabindex="-1"
                            aria-hidden="true"
                        />
                    </div>
                </div>
                <div>
                    <label
                        for="dateTo-input"
                        class="block text-sm font-medium text-muted-foreground mb-1"
                        >Hasta</label
                    >
                    <div class="relative">
                        <input
                            type="text"
                            id="dateTo-input"
                            value={displayDateTo}
                            placeholder="dd/mm/aaaa"
                            maxlength="10"
                            inputmode="numeric"
                            class="w-full bg-input border-border text-foreground rounded-md p-2 pr-9 text-sm focus:ring-2 focus:ring-primary focus:border-transparent font-mono"
                        />
                        <button
                            type="button"
                            id="dateTo-calendar-btn"
                            tabindex="-1"
                            class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-muted-foreground hover:text-foreground cursor-pointer focus:outline-none"
                            title="Abrir calendario"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </button>
                        <input
                            type="date"
                            id="dateTo-picker"
                            class="sr-only pointer-events-none"
                            tabindex="-1"
                            aria-hidden="true"
                        />
                    </div>
                </div>
                <div class="flex items-end">
                    <p class="text-xs text-muted-foreground pb-2">Selecciona ambas fechas para filtrar</p>
                </div>
            </div>
        </div>

        <!-- Vista Móvil: Cards -->
        <div class="md:hidden space-y-4">
            {
                tickets.map((ticket) => (
                    <a
                        href={`/tickets/view/${ticket.id}?source=todos`}
                        class="block"
                    >
                        <div class="bg-card border border-border rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
                            <div class="flex justify-between items-start mb-2">
                                <span class="font-bold text-lg text-foreground">
                                    #{ticket.id}
                                </span>
                                <StatusBadge
                                    status={ticket.estatus.nombre}
                                    size="sm"
                                />
                            </div>
                            <h3 class="font-medium text-foreground mb-2 line-clamp-2">
                                {ticket.descripcion}
                            </h3>
                            <div class="text-sm text-muted-foreground space-y-1">
                                <p>
                                    <span class="font-semibold">
                                        Categoría:
                                    </span>{" "}
                                    {ticket.categoria.nombre}
                                </p>
                                <p>
                                    <span class="font-semibold">
                                        Solicitante:
                                    </span>{" "}
                                    {ticket.solicitante.nombres}{" "}
                                    {ticket.solicitante.apellidos}
                                </p>
                                <p>
                                    <span class="font-semibold">Fecha:</span>{" "}
                                    <span
                                        class={getTicketDateColor(
                                            ticket.fechaalta,
                                            ticket.estatus.nombre,
                                        )}
                                    >
                                        {format(
                                            new Date(ticket.fechaalta),
                                            "dd/MM/yyyy",
                                            { locale: es },
                                        )}
                                    </span>
                                </p>
                            </div>
                        </div>
                    </a>
                ))
            }
            {
                tickets.length === 0 && (
                    <div class="text-center py-8 text-muted-foreground bg-card rounded-lg border border-border">
                        No se encontraron tickets con los filtros seleccionados.
                    </div>
                )
            }
        </div>

        <!-- Vista Desktop: Tabla -->
        <div
            class="hidden md:block bg-card rounded-lg shadow-sm border border-border overflow-hidden"
        >
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead
                        class="bg-muted text-muted-foreground uppercase text-xs"
                    >
                        <tr>
                            <th class="p-2 font-medium">ID</th>
                            <th class="p-2 font-medium">Estatus</th>
                            <th class="p-2 font-medium">Solicitante</th>
                            <th class="p-2 font-medium">Categoría</th>
                            <th class="p-2 font-medium">Asignado a</th>
                            <th class="p-2 font-medium">Fecha</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        {
                            tickets.map((ticket) => (
                                <tr
                                    class="hover:bg-[#797979]/40 transition-colors cursor-pointer"
                                    data-href={`/tickets/view/${ticket.id}?source=todos`}
                                >
                                    <td class="p-2 font-medium text-foreground">
                                        #{ticket.id}
                                    </td>
                                    <td class="p-2">
                                        <StatusBadge
                                            status={ticket.estatus.nombre}
                                        />
                                    </td>
                                    <td class="p-2 text-muted-foreground">
                                        {ticket.solicitante.nombres}{" "}
                                        {ticket.solicitante.apellidos}
                                        <span class="text-xs block text-muted-foreground/70">
                                            {ticket.empresa.nombre}
                                        </span>
                                    </td>
                                    <td class="p-2 text-muted-foreground">
                                        {ticket.categoria.nombre}
                                        {ticket.subcategoria && (
                                            <span class="text-xs block text-muted-foreground/70">
                                                {ticket.subcategoria.nombre}
                                            </span>
                                        )}
                                    </td>
                                    <td class="p-2 text-muted-foreground">
                                        {ticket.atiende ? (
                                            <>
                                                {ticket.atiende.nombres}{" "}
                                                {ticket.atiende.apellidos}
                                            </>
                                        ) : (
                                            <span class="text-muted-foreground/50 italic">
                                                Sin asignar
                                            </span>
                                        )}
                                    </td>
                                    <td
                                        class={`p-2 ${getTicketDateColor(ticket.fechaalta, ticket.estatus.nombre)}`}
                                    >
                                        {format(
                                            new Date(ticket.fechaalta),
                                            "dd MMM yyyy",
                                            { locale: es },
                                        )}
                                    </td>
                                </tr>
                            ))
                        }
                        {
                            tickets.length === 0 && (
                                <tr>
                                    <td
                                        colspan="7"
                                        class="p-2 text-center text-muted-foreground"
                                    >
                                        No se encontraron tickets con los
                                        filtros seleccionados.
                                    </td>
                                </tr>
                            )
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginación -->
        {
            totalPages > 1 && (
                <div class="flex justify-center mt-6 gap-2">
                    <button
                        id="prev-page"
                        disabled={page === 1}
                        class="px-4 py-2 text-sm bg-card border-border text-foreground border rounded-md disabled:opacity-50 hover:bg-muted transition-colors"
                    >
                        Anterior
                    </button>
                    <span class="px-4 py-2 text-sm text-muted-foreground">
                        Página {page} de {totalPages}
                    </span>
                    <button
                        id="next-page"
                        disabled={page === totalPages}
                        class="px-4 py-2 text-sm bg-card border-border text-foreground border rounded-md disabled:opacity-50 hover:bg-muted transition-colors"
                    >
                        Siguiente
                    </button>
                </div>
            )
        }
    </div>
</MainLayout>

<script>
    import { navigate } from 'astro:transitions/client';

    function setupTicketListHandlers() {
        // Filas de tabla clickeables → usa navigate() de Astro para disparar el overlay de carga
        document.querySelectorAll('tr[data-href]').forEach((row) => {
            row.addEventListener('click', (e) => {
                // Si el clic fue en un elemento interactivo interno, no navegar
                const target = e.target as HTMLElement;
                if (target.closest('a, button, select, input')) return;
                navigate((row as HTMLElement).dataset.href!);
            });
        });

        // Botón limpiar filtros
        const resetBtn = document.getElementById('reset-filters');
        if (resetBtn) resetBtn.addEventListener('click', () => navigate(window.location.pathname));

        // Manejo de fechas: formato dd/mm/aaaa, máscara y calendario
        const dateFromInput = document.getElementById("dateFrom-input") as HTMLInputElement;
        const dateToInput = document.getElementById("dateTo-input") as HTMLInputElement;
        const dateFromBtn = document.getElementById("dateFrom-calendar-btn") as HTMLButtonElement;
        const dateToBtn = document.getElementById("dateTo-calendar-btn") as HTMLButtonElement;
        const dateFromPicker = document.getElementById("dateFrom-picker") as HTMLInputElement;
        const dateToPicker = document.getElementById("dateTo-picker") as HTMLInputElement;

        const isValidDateDDMMAAAA = (val: string) => {
            if (!val || val.length !== 10) return false;
            const parts = val.split("/");
            if (parts.length !== 3) return false;
            const d = parseInt(parts[0], 10);
            const m = parseInt(parts[1], 10);
            const y = parseInt(parts[2], 10);
            if (isNaN(d) || isNaN(m) || isNaN(y)) return false;
            if (m < 1 || m > 12 || d < 1 || d > 31 || y < 1900 || y > 2100) return false;
            const dt = new Date(y, m - 1, d);
            return dt.getFullYear() === y && dt.getMonth() === m - 1 && dt.getDate() === d;
        };

        function handleDateChange() {
            const url = new URL(window.location.href);
            const from = dateFromInput?.value.trim() || "";
            const to = dateToInput?.value.trim() || "";

            const isFromValid = isValidDateDDMMAAAA(from);
            const isToValid = isValidDateDDMMAAAA(to);

            if (isFromValid && isToValid) {
                // Ambas fechas válidas → buscar
                if (url.searchParams.get("dateFrom") !== from || url.searchParams.get("dateTo") !== to) {
                    url.searchParams.set("dateFrom", from);
                    url.searchParams.set("dateTo", to);
                    url.searchParams.set("page", "1");
                    navigate(url.toString());
                }
            } else if (!from && !to) {
                // Ambas vacías → limpiar filtro de fechas
                if (url.searchParams.has("dateFrom") || url.searchParams.has("dateTo")) {
                    url.searchParams.delete("dateFrom");
                    url.searchParams.delete("dateTo");
                    url.searchParams.set("page", "1");
                    navigate(url.toString());
                }
            }
        }

        const setupDateInput = (
            input: HTMLInputElement | null,
            btn: HTMLButtonElement | null,
            picker: HTMLInputElement | null
        ) => {
            if (!input) return;

            // Formatear automáticamente al escribir (dd/mm/aaaa)
            input.addEventListener("input", (e) => {
                const inputEvent = e as InputEvent;
                if (inputEvent.inputType === "deleteContentBackward" || inputEvent.inputType === "deleteContentForward") {
                    return;
                }
                let val = input.value.replace(/\D/g, "");
                if (val.length > 8) val = val.slice(0, 8);

                let formatted = "";
                if (val.length > 4) {
                    formatted = `${val.slice(0, 2)}/${val.slice(2, 4)}/${val.slice(4)}`;
                } else if (val.length > 2) {
                    formatted = `${val.slice(0, 2)}/${val.slice(2)}`;
                } else {
                    formatted = val;
                }
                input.value = formatted;
            });

            // Manejo de backspace para no trabarse en los slashes
            input.addEventListener("keydown", (e) => {
                if (e.key === "Backspace") {
                    const val = input.value;
                    const pos = input.selectionStart;
                    if (pos && val[pos - 1] === "/") {
                        e.preventDefault();
                        input.value = val.slice(0, pos - 2) + val.slice(pos);
                        input.setSelectionRange(pos - 2, pos - 2);
                    }
                } else if (e.key === "Enter") {
                    handleDateChange();
                }
            });

            // Calendario popup
            if (btn && picker) {
                btn.addEventListener("click", () => {
                    if (isValidDateDDMMAAAA(input.value)) {
                        const [d, m, y] = input.value.split("/");
                        picker.value = `${y}-${m.padStart(2, "0")}-${d.padStart(2, "0")}`;
                    }
                    if (typeof picker.showPicker === "function") {
                        picker.showPicker();
                    } else {
                        picker.focus();
                        picker.click();
                    }
                });

                picker.addEventListener("change", () => {
                    if (picker.value) {
                        const [y, m, d] = picker.value.split("-");
                        input.value = `${d}/${m}/${y}`;
                        handleDateChange();
                    }
                });
            }

            input.addEventListener("change", handleDateChange);
            input.addEventListener("blur", handleDateChange);
        };

        setupDateInput(dateFromInput, dateFromBtn, dateFromPicker);
        setupDateInput(dateToInput, dateToBtn, dateToPicker);

        // Manejo de filtros
        const selects = document.querySelectorAll("#estatus-select, #categoria-select, #empresa-select, #assignee-select");
        selects.forEach((select) => {
            select.addEventListener("change", () => {
                if (!select.id || !select.id.endsWith("-select")) return;
                const url = new URL(window.location.href);
                const paramName = select.id.replace("-select", "");
                const value = (select as HTMLSelectElement).value;

                let queryKey = "";
                if (paramName === "estatus") queryKey = "status";
                else if (paramName === "categoria") queryKey = "category";
                else if (paramName === "empresa") queryKey = "company";
                else if (paramName === "assignee") queryKey = "assignee";

                if (!queryKey) return;

                if (value === "all") {
                    url.searchParams.delete(queryKey);
                } else {
                    url.searchParams.set(queryKey, value);
                }
                // Resetear a página 1 al filtrar
                url.searchParams.set("page", "1");
                navigate(url.toString());
            });
        });

        // Manejo de paginación
        const prevBtn = document.getElementById("prev-page");
        const nextBtn = document.getElementById("next-page");

        if (prevBtn) {
            prevBtn.addEventListener("click", () => {
                const url = new URL(window.location.href);
                const currentPage = parseInt(url.searchParams.get("page") || "1");
                if (currentPage > 1) {
                    url.searchParams.set("page", (currentPage - 1).toString());
                    navigate(url.toString());
                }
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener("click", () => {
                const url = new URL(window.location.href);
                const currentPage = parseInt(url.searchParams.get("page") || "1");
                url.searchParams.set("page", (currentPage + 1).toString());
                navigate(url.toString());
            });
        }
    }

    document.addEventListener('astro:page-load', setupTicketListHandlers);
</script>
