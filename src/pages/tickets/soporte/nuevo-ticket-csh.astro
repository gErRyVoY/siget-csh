---
import MainLayout from "@/layouts/MainLayout.astro";
import { prisma } from "@/lib/db";
import { MARKETING_CATEGORY_ID } from "@/config/ticket-categories";

// Reutilizar sesión resuelta por middleware.ts (evita N+1 a la BD por navegación)
const session = Astro.locals.session;

// Marketing tiene su propia vista de alta (/tickets/marketing/nuevo-ticket-marketing),
// así que se excluye aquí: se filtra en la consulta para que no viaje en el JSON de la página.
const [dbCategories, dbSubcategories, dbSubcatRelations, dbEmpresas] =
    await Promise.all([
        prisma.categoria.findMany({
            where: { activo: true, id: { not: MARKETING_CATEGORY_ID } },
            orderBy: { nombre: "asc" },
        }),
        prisma.subcategoria.findMany({
            where: { activo: true },
            orderBy: { nombre: "asc" },
        }),
        prisma.subcategoriaCategorias.findMany({
            where: { activo: true },
        }),
        prisma.empresa.findMany({
            where: { activa: true },
            orderBy: { nombre: "asc" },
            select: {
                id: true,
                nombre: true,
                slug: true,
                tipo: true,
                tckt_virtual: true,
            },
        }),
    ]);

// Fetch user's company
const userId = session?.user?.id ? parseInt(String(session.user.id), 10) : null;
let userEmpresa: {
    id: number;
    nombre: string;
    slug: string;
    tipo: string;
    tckt_virtual: boolean;
} | null = null;
if (userId) {
    const u = await prisma.usuario.findUnique({
        where: { id: userId },
        select: {
            empresa: {
                select: {
                    id: true,
                    nombre: true,
                    slug: true,
                    tipo: true,
                    tckt_virtual: true,
                },
            },
        },
    });
    userEmpresa = u?.empresa ?? null;
}

// Calculate campus options for current user
const isMagnoEjecutivo = userEmpresa
    ? ["Magno", "Ejecutivo"].includes(userEmpresa.tipo)
    : false;
const allowVirtual = userEmpresa?.tckt_virtual ?? false;

// El nombre es lo que ve el usuario y lo que espera la API de RH; el slug es el
// identificador estable con el que el backend resuelve la empresa del ticket.
type CampusOption = { nombre: string; slug: string };

let availableCampuses: CampusOption[] = [];
let isCampusReadOnly = false;
let defaultCampus = "";
let defaultCampusSlug = "";

if (isMagnoEjecutivo) {
    availableCampuses = [
        { nombre: userEmpresa!.nombre, slug: userEmpresa!.slug },
    ];
    defaultCampus = userEmpresa!.nombre;
    defaultCampusSlug = userEmpresa!.slug;

    if (allowVirtual) {
        // Puede elegir entre su campus y Campus Virtual
        if (userEmpresa!.nombre.toLowerCase() !== "virtual") {
            const virtual = dbEmpresas.find(
                (e) => e.nombre.toLowerCase() === "virtual",
            );
            if (virtual) {
                availableCampuses.push({
                    nombre: virtual.nombre,
                    slug: virtual.slug,
                });
            }
        }
        isCampusReadOnly = false;
    } else {
        // Solo su campus bloqueado
        isCampusReadOnly = true;
    }
} else {
    // Para Oficina / Social (Corporativo, CSH, etc.) puede buscar entre todas las empresas activas
    availableCampuses = dbEmpresas.map((e) => ({
        nombre: e.nombre,
        slug: e.slug,
    }));
    isCampusReadOnly = false;
    defaultCampus = "";
    defaultCampusSlug = "";
}

// Build subcategory tree nodes recursively (only active ones)
function buildSubcategoryTree(
    parentSubId: number | null,
    catId: number,
    allSubs: typeof dbSubcategories,
    relations: typeof dbSubcatRelations,
): any[] {
    const levelSubs = allSubs.filter((sub) => {
        if (parentSubId === null) {
            const isLinked = relations.some(
                (r) => r.categoriaId === catId && r.subcategoriaId === sub.id,
            );
            return isLinked && sub.parent_subcategoriaId === null;
        } else {
            return sub.parent_subcategoriaId === parentSubId;
        }
    });

    return levelSubs
        .map((sub) => {
            const children = buildSubcategoryTree(
                sub.id,
                catId,
                allSubs,
                relations,
            );
            return {
                id: sub.id,
                nombre: sub.nombre,
                parent_subcategoriaId: sub.parent_subcategoriaId,
                nivel_soporte_requerido: sub.nivel_soporte_requerido,
                activo: sub.activo,
                children: children.sort((a, b) =>
                    a.nombre.localeCompare(b.nombre),
                ),
            };
        })
        .sort((a, b) => a.nombre.localeCompare(b.nombre));
}

const activeCategoriesTree = dbCategories
    .map((cat) => {
        const subTree = buildSubcategoryTree(
            null,
            cat.id,
            dbSubcategories,
            dbSubcatRelations,
        );
        return {
            id: cat.id,
            nombre: cat.nombre,
            nivel_soporte_requerido: cat.nivel_soporte_requerido,
            activo: cat.activo,
            subcategorias: subTree,
        };
    })
    .sort((a, b) => a.nombre.localeCompare(b.nombre));

const GOOGLE_API_KEY = process.env.GOOGLE_API_KEY || "";
const GOOGLE_CLIENT_ID = process.env.GOOGLE_CLIENT_ID || "";
const GOOGLE_APP_ID = process.env.GOOGLE_APP_ID || "";

// Emails de agentes que atienden tickets CSH (para permisos de carpeta Drive)
const agentsCsh = await prisma.usuario.findMany({
    where: { activo: true, atiende_csh: true, mail: { not: '' } },
    select: { mail: true },
});
const agentCshEmails = agentsCsh
    .map((u) => u.mail)
    .filter(Boolean) as string[];

// A dónde se va el usuario después de crear el ticket. La vista "Todos"
// (/tickets/soporte) pertenece a la sección soporte_todos, no a soporte_dashboard, que es
// la del enlace al Dashboard ("/"). Con la sección equivocada, quien tuviera
// soporte_dashboard sin soporte_todos acababa rebotado a "/" por el middleware justo
// después de crear su ticket. El rol `user` no tiene soporte_todos, así que siempre cae en
// "Mis tickets", que es lo esperado.
const redirectUrlTrasCrear = session?.user?.secciones?.includes("soporte_todos")
    ? "/tickets/soporte"
    : "/tickets/soporte/usuario";
---

<MainLayout title="Nuevo ticket para CSH">
    <div class="w-full mx-auto">
        <!-- Buscador de categoría/subcategoría -->
        <div id="category-search-container" class="mb-4"></div>

        <div id="wizard" class="flex flex-row gap-4 overflow-x-auto pb-4">
            <!-- Columna 1: Categorías (se llenará dinámicamente en el cliente) -->
            <div id="col-1" class="p-4 bg-card border rounded-lg hidden">
                <h3 class="font-semibold mb-2 text-card-foreground">
                    1. Selecciona una Categoría
                </h3>
                <ul id="col-1-list" class="space-y-2">
                    <!-- El contenido se renderizará aquí por el script -->
                </ul>
            </div>
        </div>

        <!-- Área de Descripción y Envío (controlada por el cliente) -->
        <div
            id="descripcion-area"
            class="max-w-4xl mt-4 p-4 bg-card border rounded-lg hidden"
        >
            <div class="w-full flex justify-end mb-2">
                <button
                    type="button"
                    id="close-descripcion-btn"
                    class="p-1 rounded-md hover:bg-accent text-muted-foreground transition-colors"
                    title="Cerrar y mostrar opciones"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-x"
                        ><path d="M18 6 6 18"></path><path d="m6 6 12 12"
                        ></path></svg
                    >
                </button>
            </div>
            <form
                id="ticket-form"
                data-google-api-key={GOOGLE_API_KEY}
                data-google-client-id={GOOGLE_CLIENT_ID}
                data-google-app-id={GOOGLE_APP_ID}
                data-access-token={session?.accessToken || ""}
                data-agent-emails={agentCshEmails.join(',')}
                data-redirect-url={redirectUrlTrasCrear}
            >
                <!-- Campos dinámicos para datos del afectado -->
                <div
                    id="afectado-fields"
                    class="hidden grid-cols-1 md:grid-cols-3 gap-4 mb-4"
                >
                    <!-- Campo Campus -->
                    <div id="container-afectado-campus">
                        <label
                            for="afectado_campus"
                            class="block text-sm font-medium text-foreground mb-1"
                        >
                            Campus <span class="text-destructive">*</span>
                        </label>
                        {
                            isCampusReadOnly ? (
                                <div>
                                    <input
                                        type="text"
                                        id="afectado_campus_display"
                                        value={defaultCampus}
                                        disabled
                                        class="w-full rounded-md border border-border bg-muted p-2 text-sm text-foreground cursor-not-allowed opacity-90"
                                    />
                                    <input
                                        type="hidden"
                                        id="afectado_campus"
                                        name="afectado_campus"
                                        value={defaultCampus}
                                    />
                                    <input
                                        type="hidden"
                                        id="afectado_campus_slug"
                                        name="afectado_campus_slug"
                                        value={defaultCampusSlug}
                                    />
                                </div>
                            ) : (
                                <select
                                    id="afectado_campus"
                                    name="afectado_campus"
                                    class="w-full rounded-md border border-border bg-input p-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-secondary focus:border-secondary"
                                >
                                    <option
                                        value=""
                                        disabled
                                        selected={!defaultCampus}
                                    >
                                        Selecciona un campus
                                    </option>
                                    {availableCampuses.map((c) => (
                                        <option
                                            value={c.nombre}
                                            data-slug={c.slug}
                                            selected={c.nombre === defaultCampus}
                                        >
                                            {c.nombre}
                                        </option>
                                    ))}
                                </select>
                            )
                        }
                    </div>

                    <!-- Campo Identificador: Clave / Matrícula / Folio -->
                    <div id="container-afectado-clave">
                        <label
                            id="lbl-clave"
                            for="afectado_clave"
                            class="block text-sm font-medium text-foreground mb-1"
                        >
                            Matrícula <span class="text-destructive">*</span>
                        </label>
                        <div class="relative">
                            <input
                                type="text"
                                id="afectado_clave"
                                name="afectado_clave"
                                class="w-full rounded-md border border-border bg-input p-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-secondary focus:border-secondary pr-8"
                                placeholder="Ingresa matrícula..."
                            />
                            <div
                                id="clave-search-spinner"
                                class="hidden absolute right-2.5 top-1/2 -translate-y-1/2"
                            >
                                <svg
                                    class="animate-spin h-4 w-4 text-primary"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                >
                                    <circle
                                        class="opacity-25"
                                        cx="12"
                                        cy="12"
                                        r="10"
                                        stroke="currentColor"
                                        stroke-width="4"></circle>
                                    <path
                                        class="opacity-75"
                                        fill="currentColor"
                                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                                    ></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Campo Email (Solo Colaborador) -->
                    <div id="container-afectado-email" class="hidden">
                        <label
                            for="afectado_email_user"
                            class="block text-sm font-medium text-foreground mb-1"
                        >
                            Email <span class="text-destructive">*</span>
                        </label>
                        <div
                            class="relative flex rounded-md border border-border bg-input overflow-hidden focus-within:ring-1 focus-within:ring-secondary focus-within:border-secondary"
                        >
                            <input
                                type="text"
                                id="afectado_email_user"
                                name="afectado_email_user"
                                class="flex-1 min-w-0 bg-transparent p-2 text-sm text-foreground focus:outline-none border-none pr-8"
                                placeholder="nombre.apellido"
                            />
                            <div
                                id="email-search-spinner"
                                class="hidden absolute right-36 top-1/2 -translate-y-1/2"
                            >
                                <svg
                                    class="animate-spin h-4 w-4 text-primary"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                >
                                    <circle
                                        class="opacity-25"
                                        cx="12"
                                        cy="12"
                                        r="10"
                                        stroke="currentColor"
                                        stroke-width="4"></circle>
                                    <path
                                        class="opacity-75"
                                        fill="currentColor"
                                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                                    ></path>
                                </svg>
                            </div>
                            <span
                                class="inline-flex items-center px-3 bg-muted text-muted-foreground text-xs font-semibold select-none border-l border-border"
                            >
                                @humanitas.edu.mx
                            </span>
                        </div>
                    </div>

                    <!-- Campo Nombre Completo -->
                    <div id="container-afectado-nombre">
                        <label
                            for="afectado_nombre"
                            class="block text-sm font-medium text-foreground mb-1"
                        >
                            Nombre Completo <span class="text-destructive"
                                >*</span
                            >
                        </label>
                        <input
                            type="text"
                            id="afectado_nombre"
                            name="afectado_nombre"
                            class="w-full rounded-md border border-border bg-input p-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-secondary focus:border-secondary"
                            placeholder="Nombre del afectado..."
                        />
                    </div>
                </div>

                <!-- Múltiple identificador: el ticket cubre a varios afectados -->
                <div id="multiple-clave-container" class="hidden mb-4">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                        <label
                            for="multiple_clave"
                            class="flex items-center gap-2 cursor-pointer select-none shrink-0"
                        >
                            <input
                                type="checkbox"
                                id="multiple_clave"
                                name="multiple_clave"
                                class="h-4 w-4 rounded border-input text-primary focus:ring-primary"
                            />
                            <span
                                id="lbl-multiple-clave"
                                class="text-sm font-medium text-foreground"
                            >
                                Múltiple matrícula
                            </span>
                        </label>
                        <p
                            id="multiple-clave-hint"
                            class="hidden text-xs text-secondary"
                        >
                            No olvides adjuntar un archivo con todas las
                            matrículas y los datos necesarios, o bien copiar y
                            pegar en el campo de abajo.
                        </p>
                    </div>
                </div>

                <textarea
                    id="descripcion"
                    name="descripcion"
                    rows="4"
                    class="mt-1 block w-full rounded-md border-border bg-input p-2 accent-secondary focus:outline-none focus:ring-1 focus:ring-secondary focus:border-secondary"
                    placeholder="Proporciona todos los detalles posibles para continuar..."
                ></textarea>

                <!-- Recursos de Google Drive (Carpetas y Videos) -->
                <div id="drive-resources-section" class="hidden mt-3 space-y-3">
                    <div id="drive-folders-list" class="space-y-2"></div>
                    <div id="drive-videos-list" class="space-y-2"></div>
                </div>

                <!-- File upload section -->
                <div class="space-y-4 pt-4">
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full items-stretch"
                    >
                        <div class="space-y-2 h-full">
                            <div
                                id="drop-zone"
                                class="border-2 border-dashed border-muted-foreground/25 rounded-lg p-6 flex flex-col items-center justify-center hover:bg-muted/50 transition-colors cursor-pointer relative h-full min-h-[120px]"
                            >
                                <p
                                    class="text-sm text-muted-foreground text-center"
                                >
                                    Arrastre sus archivos aquí
                                </p>
                                <div
                                    id="attachment-area"
                                    class="text-left w-full mt-auto"
                                >
                                </div>
                            </div>
                        </div>

                        <div
                            class="flex flex-col justify-end items-end gap-2 rounded-lg border border-transparent"
                        >
                            <div
                                id="action-buttons-container"
                                class="flex flex-wrap justify-end items-center gap-2 w-full"
                            >
                                <button
                                    type="button"
                                    id="upload-files-button"
                                    class="bg-muted-foreground text-white hover:bg-muted-foreground/80 px-4 py-2 rounded-md text-sm font-semibold shrink-0 h-10"
                                >
                                    Seleccionar
                                </button>
                                <button
                                    type="button"
                                    id="google-drive-button"
                                    class="bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 rounded-md flex items-center justify-center h-10 w-10 shrink-0"
                                    title="Adjuntar desde Google Drive"
                                >
                                    <img
                                        src="/Google_Drive_icon.svg"
                                        width="24"
                                        height="24"
                                        alt="Google Drive"
                                    />
                                </button>
                                <button
                                    type="submit"
                                    id="submit-ticket"
                                    class="bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-2 rounded-md text-sm font-semibold shrink-0 h-10 disabled:opacity-50 disabled:cursor-not-allowed"
                                    disabled
                                >
                                    Crear Ticket
                                </button>
                            </div>
                            <div class="relative flex items-center justify-end w-full mt-1">
                                <button
                                    type="button"
                                    id="format-help-btn"
                                    class="text-xs text-primary hover:text-primary/80 font-medium underline underline-offset-2 flex items-center gap-1 cursor-pointer transition-colors"
                                    aria-haspopup="dialog"
                                    aria-expanded="false"
                                >
                                    <span>Consulta lo que puedes añadir</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 inline-block text-secondary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                </button>

                                <!-- Popover informativo flotante -->
                                <div
                                    id="format-help-popover"
                                    class="hidden absolute bottom-full right-0 mb-2 w-80 max-w-[90vw] p-4 bg-popover text-popover-foreground rounded-lg border border-border shadow-xl z-50 text-xs animate-in fade-in zoom-in-95 duration-150"
                                >
                                    <div class="flex items-center justify-between pb-2 mb-2 border-b border-border font-semibold text-foreground">
                                        <div class="flex items-center gap-1.5">
                                            <span class="text-base">📎</span>
                                            <span>Elementos permitidos</span>
                                        </div>
                                        <button
                                            type="button"
                                            id="format-help-close"
                                            class="text-muted-foreground hover:text-foreground p-0.5 rounded transition-colors cursor-pointer"
                                            title="Cerrar"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    </div>

                                    <ul class="space-y-2.5 text-muted-foreground">
                                        <li class="flex items-start gap-2">
                                            <span class="text-primary font-bold">📄</span>
                                            <div>
                                                <strong class="text-foreground">Archivos adjuntos:</strong>
                                                <p class="text-[11px] leading-tight mt-0.5">JPG, PNG, WEBP, PDF, DOCX, XLSX (máximo 5MB por archivo).</p>
                                            </div>
                                        </li>
                                        <li class="flex items-start gap-2">
                                            <span class="text-primary font-bold">📑</span>
                                            <div>
                                                <strong class="text-foreground">Google Workspace:</strong>
                                                <p class="text-[11px] leading-tight mt-0.5">Documentos, Hojas de cálculo y Presentaciones de Google Drive.</p>
                                            </div>
                                        </li>
                                        <li class="flex items-start gap-2">
                                            <span class="text-primary font-bold">🎥</span>
                                            <div>
                                                <strong class="text-foreground">Videos (Google Drive):</strong>
                                                <p class="text-[11px] leading-tight mt-0.5">.mp4, .avi, .mov, .hevc, .3gp y video/* (compartición hasta 5 videos).</p>
                                            </div>
                                        </li>
                                        <li class="flex items-start gap-2">
                                            <span class="text-primary font-bold">📁</span>
                                            <div>
                                                <strong class="text-foreground">Carpetas (Google Drive):</strong>
                                                <p class="text-[11px] leading-tight mt-0.5">Selección y compartición directa de hasta 5 carpetas de Drive.</p>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="file" id="file-input" multiple class="hidden" />
            </form>
        </div>
    </div>

    <script
        id="categories-data"
        type="application/json"
        is:inline
        set:html={JSON.stringify(activeCategoriesTree)}
    />

    <!-- Unsaved Ticket Data Confirmation Modal -->
    <div
        id="unsaved-ticket-modal"
        class="fixed inset-0 z-50 items-center justify-center hidden"
        role="dialog"
        aria-modal="true"
    >
        <div
            class="absolute inset-0 bg-black/60 backdrop-blur-sm"
            id="unsaved-ticket-overlay"
        >
        </div>
        <div
            class="relative bg-card border border-border rounded-lg shadow-xl p-6 w-full max-w-md mx-4 transition-all"
        >
            <div class="flex items-center gap-3 mb-3">
                <div
                    class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center flex-shrink-0"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-foreground">
                        Información sin enviar
                    </h3>
                    <p class="text-xs text-muted-foreground">
                        Hay datos o archivos en tu solicitud
                    </p>
                </div>
            </div>

            <p class="text-sm text-foreground/80 mb-6">
                Has ingresado información para este ticket. Si sales ahora, los
                datos y archivos adjuntos se perderán. ¿Deseas descartar los
                cambios y salir?
            </p>

            <div class="flex flex-col sm:flex-row justify-end gap-2">
                <button
                    type="button"
                    id="cancel-ticket-leave"
                    class="bg-muted text-muted-foreground hover:bg-muted/80 px-4 py-2 rounded-md text-sm font-semibold transition-colors cursor-pointer"
                >
                    Permanecer aquí
                </button>
                <button
                    type="button"
                    id="confirm-discard-ticket"
                    class="bg-destructive text-destructive-foreground hover:bg-destructive/90 px-4 py-2 rounded-md text-sm font-semibold transition-colors cursor-pointer"
                >
                    Descartar y salir
                </button>
            </div>
        </div>
    </div>
</MainLayout>

<script src="../../../scripts/init-nuevo-ticket-wizard.ts"></script>

<script is:inline>
  // Popover "Consulta lo que puedes añadir"
  document.addEventListener('astro:page-load', () => {
    const formatHelpBtn = document.getElementById('format-help-btn');
    const formatHelpPopover = document.getElementById('format-help-popover');
    const formatHelpClose = document.getElementById('format-help-close');
    if (formatHelpBtn && formatHelpPopover) {
      formatHelpBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = formatHelpPopover.classList.contains('hidden');
        formatHelpPopover.classList.toggle('hidden', !isHidden);
        formatHelpBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      });
      if (formatHelpClose) {
        formatHelpClose.addEventListener('click', (e) => {
          e.stopPropagation();
          formatHelpPopover.classList.add('hidden');
          formatHelpBtn.setAttribute('aria-expanded', 'false');
        });
      }
      document.addEventListener('click', (e) => {
        if (!formatHelpPopover.contains(e.target) && e.target !== formatHelpBtn) {
          formatHelpPopover.classList.add('hidden');
          formatHelpBtn.setAttribute('aria-expanded', 'false');
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !formatHelpPopover.classList.contains('hidden')) {
          formatHelpPopover.classList.add('hidden');
          formatHelpBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  });
</script>
