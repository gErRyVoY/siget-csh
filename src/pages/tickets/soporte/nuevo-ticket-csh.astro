---
import MainLayout from "@/layouts/MainLayout.astro";
import { prisma } from "@/lib/db";

// Reutilizar sesión resuelta por middleware.ts (evita N+1 a la BD por navegación)
const session = Astro.locals.session;

const [dbCategories, dbSubcategories, dbSubcatRelations, dbEmpresas] =
    await Promise.all([
        prisma.categoria.findMany({
            where: { activo: true },
            orderBy: { nombre: "asc" },
        }),
        prisma.subcategoria.findMany({
            where: { activo: true },
            orderBy: { nombre: "asc" },
        }),
        prisma.subcategoriaCategorias.findMany({
            where: { activo: true },
        }),
        prisma.empresa.findMany({
            where: { activa: true },
            orderBy: { nombre: "asc" },
            select: { id: true, nombre: true, tipo: true, tckt_virtual: true },
        }),
    ]);

// Fetch user's company
const userId = session?.user?.id ? parseInt(String(session.user.id), 10) : null;
let userEmpresa: {
    id: number;
    nombre: string;
    tipo: string;
    tckt_virtual: boolean;
} | null = null;
if (userId) {
    const u = await prisma.usuario.findUnique({
        where: { id: userId },
        select: {
            empresa: {
                select: {
                    id: true,
                    nombre: true,
                    tipo: true,
                    tckt_virtual: true,
                },
            },
        },
    });
    userEmpresa = u?.empresa ?? null;
}

// Calculate campus options for current user
const isMagnoEjecutivo = userEmpresa
    ? ["Magno", "Ejecutivo"].includes(userEmpresa.tipo)
    : false;
const allowVirtual = userEmpresa?.tckt_virtual ?? false;

let availableCampuses: string[] = [];
let isCampusReadOnly = false;
let defaultCampus = "";

if (isMagnoEjecutivo) {
    if (allowVirtual) {
        // Puede elegir entre su campus y Campus Virtual
        availableCampuses = [userEmpresa!.nombre];
        if (userEmpresa!.nombre.toLowerCase() !== "virtual") {
            availableCampuses.push("Virtual");
        }
        isCampusReadOnly = false;
        defaultCampus = userEmpresa!.nombre;
    } else {
        // Solo su campus bloqueado
        availableCampuses = [userEmpresa!.nombre];
        isCampusReadOnly = true;
        defaultCampus = userEmpresa!.nombre;
    }
} else {
    // Para Oficina / Social (Corporativo, CSH, etc.) puede buscar entre todas las empresas activas
    availableCampuses = dbEmpresas.map((e) => e.nombre);
    isCampusReadOnly = false;
    defaultCampus = "";
}

// Build subcategory tree nodes recursively (only active ones)
function buildSubcategoryTree(
    parentSubId: number | null,
    catId: number,
    allSubs: typeof dbSubcategories,
    relations: typeof dbSubcatRelations,
): any[] {
    const levelSubs = allSubs.filter((sub) => {
        if (parentSubId === null) {
            const isLinked = relations.some(
                (r) => r.categoriaId === catId && r.subcategoriaId === sub.id,
            );
            return isLinked && sub.parent_subcategoriaId === null;
        } else {
            return sub.parent_subcategoriaId === parentSubId;
        }
    });

    return levelSubs
        .map((sub) => {
            const children = buildSubcategoryTree(
                sub.id,
                catId,
                allSubs,
                relations,
            );
            return {
                id: sub.id,
                nombre: sub.nombre,
                parent_subcategoriaId: sub.parent_subcategoriaId,
                nivel_soporte_requerido: sub.nivel_soporte_requerido,
                activo: sub.activo,
                children: children.sort((a, b) =>
                    a.nombre.localeCompare(b.nombre),
                ),
            };
        })
        .sort((a, b) => a.nombre.localeCompare(b.nombre));
}

const activeCategoriesTree = dbCategories
    .map((cat) => {
        const subTree = buildSubcategoryTree(
            null,
            cat.id,
            dbSubcategories,
            dbSubcatRelations,
        );
        return {
            id: cat.id,
            nombre: cat.nombre,
            nivel_soporte_requerido: cat.nivel_soporte_requerido,
            activo: cat.activo,
            subcategorias: subTree,
        };
    })
    .sort((a, b) => a.nombre.localeCompare(b.nombre));

const GOOGLE_API_KEY = process.env.GOOGLE_API_KEY || "";
const GOOGLE_CLIENT_ID = process.env.GOOGLE_CLIENT_ID || "";
const GOOGLE_APP_ID = process.env.GOOGLE_APP_ID || "";

// Emails de agentes que atienden tickets CSH (para permisos de carpeta Drive)
const agentsCsh = await prisma.usuario.findMany({
    where: { activo: true, atiende_csh: true, mail: { not: '' } },
    select: { mail: true },
});
const agentCshEmails = agentsCsh
    .map((u) => u.mail)
    .filter(Boolean) as string[];
---

<MainLayout title="Nuevo ticket para CSH">
    <div class="w-full mx-auto">
        <!-- Buscador de categoría/subcategoría -->
        <div id="category-search-container" class="mb-4"></div>

        <div id="wizard" class="flex flex-row gap-4 overflow-x-auto pb-4">
            <!-- Columna 1: Categorías (se llenará dinámicamente en el cliente) -->
            <div id="col-1" class="p-4 bg-card border rounded-lg hidden">
                <h3 class="font-semibold mb-2 text-card-foreground">
                    1. Selecciona una Categoría
                </h3>
                <ul id="col-1-list" class="space-y-2">
                    <!-- El contenido se renderizará aquí por el script -->
                </ul>
            </div>
        </div>

        <!-- Área de Descripción y Envío (controlada por el cliente) -->
        <div
            id="descripcion-area"
            class="max-w-4xl mt-4 p-4 bg-card border rounded-lg hidden"
        >
            <div class="w-full flex justify-end mb-2">
                <button
                    type="button"
                    id="close-descripcion-btn"
                    class="p-1 rounded-md hover:bg-accent text-muted-foreground transition-colors"
                    title="Cerrar y mostrar opciones"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-x"
                        ><path d="M18 6 6 18"></path><path d="m6 6 12 12"
                        ></path></svg
                    >
                </button>
            </div>
            <form
                id="ticket-form"
                data-google-api-key={GOOGLE_API_KEY}
                data-google-client-id={GOOGLE_CLIENT_ID}
                data-google-app-id={GOOGLE_APP_ID}
                data-access-token={session?.accessToken || ""}
                data-agent-emails={agentCshEmails.join(',')}
                data-redirect-url={session?.user?.secciones?.includes(
                    "soporte_dashboard",
                )
                    ? "/tickets/soporte"
                    : "/tickets/soporte/usuario"}
            >
                <!-- Campos dinámicos para datos del afectado -->
                <div
                    id="afectado-fields"
                    class="hidden grid-cols-1 md:grid-cols-3 gap-4 mb-4"
                >
                    <!-- Campo Campus -->
                    <div id="container-afectado-campus">
                        <label
                            for="afectado_campus"
                            class="block text-sm font-medium text-foreground mb-1"
                        >
                            Campus <span class="text-destructive">*</span>
                        </label>
                        {
                            isCampusReadOnly ? (
                                <div>
                                    <input
                                        type="text"
                                        id="afectado_campus_display"
                                        value={defaultCampus}
                                        disabled
                                        class="w-full rounded-md border border-border bg-muted p-2 text-sm text-foreground cursor-not-allowed opacity-90"
                                    />
                                    <input
                                        type="hidden"
                                        id="afectado_campus"
                                        name="afectado_campus"
                                        value={defaultCampus}
                                    />
                                </div>
                            ) : (
                                <select
                                    id="afectado_campus"
                                    name="afectado_campus"
                                    class="w-full rounded-md border border-border bg-input p-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-secondary focus:border-secondary"
                                >
                                    <option
                                        value=""
                                        disabled
                                        selected={!defaultCampus}
                                    >
                                        Selecciona un campus
                                    </option>
                                    {availableCampuses.map((c) => (
                                        <option
                                            value={c}
                                            selected={c === defaultCampus}
                                        >
                                            {c}
                                        </option>
                                    ))}
                                </select>
                            )
                        }
                    </div>

                    <!-- Campo Identificador: Clave / Matrícula / Folio -->
                    <div id="container-afectado-clave">
                        <label
                            id="lbl-clave"
                            for="afectado_clave"
                            class="block text-sm font-medium text-foreground mb-1"
                        >
                            Matrícula <span class="text-destructive">*</span>
                        </label>
                        <div class="relative">
                            <input
                                type="text"
                                id="afectado_clave"
                                name="afectado_clave"
                                class="w-full rounded-md border border-border bg-input p-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-secondary focus:border-secondary pr-8"
                                placeholder="Ingresa matrícula..."
                            />
                            <div
                                id="clave-search-spinner"
                                class="hidden absolute right-2.5 top-1/2 -translate-y-1/2"
                            >
                                <svg
                                    class="animate-spin h-4 w-4 text-primary"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                >
                                    <circle
                                        class="opacity-25"
                                        cx="12"
                                        cy="12"
                                        r="10"
                                        stroke="currentColor"
                                        stroke-width="4"></circle>
                                    <path
                                        class="opacity-75"
                                        fill="currentColor"
                                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                                    ></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Campo Email (Solo Colaborador) -->
                    <div id="container-afectado-email" class="hidden">
                        <label
                            for="afectado_email_user"
                            class="block text-sm font-medium text-foreground mb-1"
                        >
                            Email <span class="text-destructive">*</span>
                        </label>
                        <div
                            class="relative flex rounded-md border border-border bg-input overflow-hidden focus-within:ring-1 focus-within:ring-secondary focus-within:border-secondary"
                        >
                            <input
                                type="text"
                                id="afectado_email_user"
                                name="afectado_email_user"
                                class="flex-1 min-w-0 bg-transparent p-2 text-sm text-foreground focus:outline-none border-none pr-8"
                                placeholder="nombre.apellido"
                            />
                            <div
                                id="email-search-spinner"
                                class="hidden absolute right-36 top-1/2 -translate-y-1/2"
                            >
                                <svg
                                    class="animate-spin h-4 w-4 text-primary"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                >
                                    <circle
                                        class="opacity-25"
                                        cx="12"
                                        cy="12"
                                        r="10"
                                        stroke="currentColor"
                                        stroke-width="4"></circle>
                                    <path
                                        class="opacity-75"
                                        fill="currentColor"
                                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                                    ></path>
                                </svg>
                            </div>
                            <span
                                class="inline-flex items-center px-3 bg-muted text-muted-foreground text-xs font-semibold select-none border-l border-border"
                            >
                                @humanitas.edu.mx
                            </span>
                        </div>
                    </div>

                    <!-- Campo Nombre Completo -->
                    <div id="container-afectado-nombre">
                        <label
                            for="afectado_nombre"
                            class="block text-sm font-medium text-foreground mb-1"
                        >
                            Nombre Completo <span class="text-destructive"
                                >*</span
                            >
                        </label>
                        <input
                            type="text"
                            id="afectado_nombre"
                            name="afectado_nombre"
                            class="w-full rounded-md border border-border bg-input p-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-secondary focus:border-secondary"
                            placeholder="Nombre del afectado..."
                        />
                    </div>
                </div>

                <textarea
                    id="descripcion"
                    name="descripcion"
                    rows="4"
                    class="mt-1 block w-full rounded-md border-border bg-input p-2 accent-secondary focus:outline-none focus:ring-1 focus:ring-secondary focus:border-secondary"
                    placeholder="Proporciona todos los detalles posibles para continuar..."
                ></textarea>

                <!-- Recursos de Google Drive (Carpetas y Videos) -->
                <div id="drive-resources-section" class="hidden mt-3 space-y-3">
                    <div id="drive-folders-list" class="space-y-2"></div>
                    <div id="drive-videos-list" class="space-y-2"></div>
                </div>

                <!-- File upload section -->
                <div class="space-y-4 pt-4">
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full items-stretch"
                    >
                        <div class="space-y-2 h-full">
                            <div
                                id="drop-zone"
                                class="border-2 border-dashed border-muted-foreground/25 rounded-lg p-6 flex flex-col items-center justify-center hover:bg-muted/50 transition-colors cursor-pointer relative h-full min-h-[120px]"
                            >
                                <p
                                    class="text-sm text-muted-foreground text-center"
                                >
                                    Arrastre sus archivos aquí
                                </p>
                                <div
                                    id="attachment-area"
                                    class="text-left w-full mt-auto"
                                >
                                </div>
                            </div>
                        </div>

                        <div
                            class="flex flex-col justify-end items-end gap-2 rounded-lg border border-transparent"
                        >
                            <div
                                id="action-buttons-container"
                                class="flex flex-wrap justify-end items-center gap-2 w-full"
                            >
                                <button
                                    type="button"
                                    id="upload-files-button"
                                    class="bg-muted-foreground text-white hover:bg-muted-foreground/80 px-4 py-2 rounded-md text-sm font-semibold shrink-0 h-10"
                                >
                                    Seleccionar
                                </button>
                                <button
                                    type="button"
                                    id="google-drive-button"
                                    class="bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 rounded-md flex items-center justify-center h-10 w-10 shrink-0"
                                    title="Adjuntar desde Google Drive"
                                >
                                    <img
                                        src="/Google_Drive_icon.svg"
                                        width="24"
                                        height="24"
                                        alt="Google Drive"
                                    />
                                </button>
                                <button
                                    type="submit"
                                    id="submit-ticket"
                                    class="bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-2 rounded-md text-sm font-semibold shrink-0 h-10 disabled:opacity-50 disabled:cursor-not-allowed"
                                    disabled
                                >
                                    Crear Ticket
                                </button>
                            </div>
                            <p
                                id="help-text"
                                class="text-xs text-secondary text-right w-full mt-1"
                            >
                                * Máximo 5MB cada uno. Formatos permitidos: jpg,
                                png, pdf, docx, xlsx
                            </p>
                        </div>
                    </div>
                </div>
                <input type="file" id="file-input" multiple class="hidden" />
            </form>
        </div>
    </div>

    <script
        id="categories-data"
        type="application/json"
        is:inline
        set:html={JSON.stringify(activeCategoriesTree)}
    />

    <!-- Unsaved Ticket Data Confirmation Modal -->
    <div
        id="unsaved-ticket-modal"
        class="fixed inset-0 z-50 items-center justify-center hidden"
        role="dialog"
        aria-modal="true"
    >
        <div
            class="absolute inset-0 bg-black/60 backdrop-blur-sm"
            id="unsaved-ticket-overlay"
        >
        </div>
        <div
            class="relative bg-card border border-border rounded-lg shadow-xl p-6 w-full max-w-md mx-4 transition-all"
        >
            <div class="flex items-center gap-3 mb-3">
                <div
                    class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center flex-shrink-0"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-foreground">
                        Información sin enviar
                    </h3>
                    <p class="text-xs text-muted-foreground">
                        Hay datos o archivos en tu solicitud
                    </p>
                </div>
            </div>

            <p class="text-sm text-foreground/80 mb-6">
                Has ingresado información para este ticket. Si sales ahora, los
                datos y archivos adjuntos se perderán. ¿Deseas descartar los
                cambios y salir?
            </p>

            <div class="flex flex-col sm:flex-row justify-end gap-2">
                <button
                    type="button"
                    id="cancel-ticket-leave"
                    class="bg-muted text-muted-foreground hover:bg-muted/80 px-4 py-2 rounded-md text-sm font-semibold transition-colors cursor-pointer"
                >
                    Permanecer aquí
                </button>
                <button
                    type="button"
                    id="confirm-discard-ticket"
                    class="bg-destructive text-destructive-foreground hover:bg-destructive/90 px-4 py-2 rounded-md text-sm font-semibold transition-colors cursor-pointer"
                >
                    Descartar y salir
                </button>
            </div>
        </div>
    </div>
</MainLayout>

<script src="../../../scripts/init-nuevo-ticket-wizard.ts"></script>
